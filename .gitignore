# Dependencies
node_modules/
.pnpm-store/

# Build output and caches (Astro, TypeScript, ESLint)
dist/
.astro/
*.tsbuildinfo
.eslintcache

# Test output
coverage/
playwright-report/
test-results/
blob-report/
# Playwright MCP snapshots and console logs (screenshots for reports are copied elsewhere)
.playwright-mcp/

# Environment files: never commit secrets; .env.example documents the variables
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code: personal settings stay local; the project settings are tracked
.claude/settings.local.json

# Raw media (e.g. original team photos); only optimised copies are committed
Assets/**/originals/

# Clash Display (ITF Free Font License): self-hosting on our site is allowed,
# sharing it through a public repository is not, so the files stay out of git.
Assets/codraft-fonts/
public/fonts/ClashDisplay-Variable.woff2
