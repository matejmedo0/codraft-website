---
/**
 * Zone C: the free audit and its three steps (ADR 0007: form → time slot →
 * confirmation), on paper (ADR 0015). It holds the page's one "Rezervirajte
 * besplatnu analizu" (ADR 0017): the button sits where the audit is
 * explained. The lead says what the audit checks and what you get (G4,
 * G19; the client confirms the facts before launch).
 */
import Button from "../../components/ui/Button.astro";
import Steps from "../../components/ui/Steps.astro";
import Zone from "../../components/ui/Zone.astro";
import type { Locale } from "../../config/site.ts";
import { t } from "../../features/i18n/ui.ts";
import { pathFor } from "../../features/i18n/urls.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const steps = (["form", "slot", "confirmation"] as const).map((step) => ({
  title: t(locale, `audit.step.${step}.title`),
  body: t(locale, `audit.step.${step}.body`),
}));
---

<Zone labelledby="analiza" class="home-audit">
  <div class="home-audit__intro">
    <h2 id="analiza">{t(locale, "home.audit.title")}</h2>
    <p class="home-audit__lead">{t(locale, "home.audit.lead")}</p>
  </div>
  <div class="home-audit__steps">
    <Steps steps={steps} />
  </div>
  <div class="home-audit__actions">
    <Button href={pathFor("audit", locale)}>{t(locale, "audit.cta")}</Button>
  </div>
</Zone>

<style>
  .home-audit {
    display: grid;
    gap: var(--space-7);
  }

  .home-audit__lead {
    max-width: var(--measure-lead);
    margin-top: var(--space-4);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  .home-audit__actions {
    display: grid;
    justify-items: start;
  }

  @media (min-width: 64rem) {
    .home-audit {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      row-gap: var(--space-7);
    }

    .home-audit__intro,
    .home-audit__actions {
      grid-column: 1 / span 5;
    }

    .home-audit__steps {
      grid-row: 1 / span 2;
      grid-column: 7 / -1;
      align-self: center;
    }
  }
</style>
