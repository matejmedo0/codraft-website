---
/**
 * Zone E, "Kako radimo": the client's three commitments, in the client's
 * order (review batch 10); the third answers who owns the work (ADR 0021).
 * "Razgovarate s onima koji rade" gets its proof from the team strip right
 * below (the page's argument).
 */
import Zone from "../../../../components/ui/Zone.astro";
import type { Locale } from "../../../../config/site.ts";
import { t } from "../../../../features/i18n/ui.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items = (["direct", "honest", "yours"] as const).map((item) => ({
  title: t(locale, `principles.${item}.title`),
  body: t(locale, `principles.${item}.body`),
}));
---

<Zone labelledby="kako-radimo" class="home-principles">
  <h2 id="kako-radimo">{t(locale, "home.principles.title")}</h2>
  <ul class="home-principles__list">
    {items.map((item) => (
      <li class="principle">
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </li>
    ))}
  </ul>
</Zone>

<style>
  .home-principles__list {
    display: grid;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .principle {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    border-top: var(--rule) solid var(--line);
  }

  .principle p {
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  @media (min-width: 64rem) {
    .home-principles {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--gap);
      align-items: start;
    }

    .home-principles > h2 {
      grid-column: 1 / span 4;
    }

    .home-principles__list {
      grid-column: 5 / -1;
      margin: 0;
    }

    .principle {
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr);
      gap: var(--gap);
      padding-block: var(--space-5);
    }

    .principle:first-child {
      padding-top: var(--space-2);
      border-top: 0;
    }
  }
</style>
