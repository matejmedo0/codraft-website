---
/**
 * The hero, as Butter's: one large, light headline in the middle of the
 * first screen, the lead under it and one button. Butter's 3D keychain
 * becomes Codraft's own object: a drafting line selected in CAD, drawn from
 * the left, its three hollow grips snapping in after it (the wordmark's
 * accent, docs/brand.md). Without motion the line is complete.
 */
import Button from "../../components/ui/Button.astro";
import type { Locale } from "../../config/site.ts";
import { t } from "../../features/i18n/ui.ts";
import { pathFor } from "../../features/i18n/urls.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const GRIPS = [0, 300, 600];
---

<section class="hero b-wrap" aria-labelledby="hero-title">
  <svg
    class="hero__line"
    viewBox="-12 -12 624 24"
    aria-hidden="true"
    focusable="false"
  >
    <path class="hero__stroke" d="M0 0H600" pathLength="1" />
    {GRIPS.map((x) => (
      <rect class="hero__grip" x={x - 7} y="-7" width="14" height="14" />
    ))}
  </svg>
  <h1 id="hero-title" class="hero__title">
    <span>{t(locale, "home.hero.titleLine1")}</span>{" "}
    <span>{t(locale, "home.hero.titleLine2")}</span>
  </h1>
  <p class="hero__lead">{t(locale, "home.hero.lead")}</p>
  <div class="hero__actions">
    <Button href={pathFor("services", locale)}>
      {t(locale, "home.hero.cta")}
    </Button>
    <a class="hero__drafting" href={pathFor("drafting", locale)}>
      {t(locale, "home.hero.drafting")}
    </a>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding-block: var(--b-header-space) var(--space-9);
    text-align: center;
    background: linear-gradient(var(--surface-sunk), var(--surface) 70%);
  }

  .hero__line {
    width: min(36rem, 80%);
    height: auto;
    margin-bottom: var(--space-8);
    overflow: visible;
  }

  .hero__stroke {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3px;
  }

  .hero__grip {
    fill: var(--surface-sunk);
    stroke: var(--accent);
    stroke-width: 2px;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hero__title {
    max-width: 22ch;
    font-size: clamp(2.5rem, 1.1rem + 5.2vw, 6rem);
    font-weight: var(--weight-text);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  /* From 64rem the two lines are the locale's two lines. */
  @media (min-width: 64rem) {
    .hero__title {
      max-width: none;
    }

    .hero__title span {
      display: block;
    }
  }

  .hero__lead {
    max-width: 44ch;
    margin-top: var(--space-6);
    color: var(--ink-muted);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-7);
  }

  .hero__drafting {
    color: var(--ink);
    font-size: var(--step-small);
    font-weight: var(--weight-medium);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__stroke {
      stroke-dasharray: 1;
      animation: hero-draw var(--motion-draw) var(--ease-pen)
        var(--motion-entrance-delay) both;
    }

    .hero__grip {
      animation: hero-grip var(--motion-snap) var(--ease-snap) both;
    }

    /* Each grip snaps in as the line reaches it. */
    .hero__grip:nth-of-type(1) {
      animation-delay: var(--motion-entrance-delay);
    }

    .hero__grip:nth-of-type(2) {
      animation-delay: calc(
        var(--motion-entrance-delay) + var(--motion-draw) / 2
      );
    }

    .hero__grip:nth-of-type(3) {
      animation-delay: calc(var(--motion-entrance-delay) + var(--motion-draw));
    }
  }

  @keyframes hero-draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hero-grip {
    from {
      scale: 0;
    }
  }
</style>
