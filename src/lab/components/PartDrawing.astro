---
/**
 * A decorative drafting motif for the CAD sections: a plate with four holes
 * and a slot, with section A–A, centre lines and dimensions (units in mm).
 * It is an illustration, not client work or a sample sheet (ADR 0004).
 *
 * Colours come from the direction: --pd-ink (outlines), --pd-muted (centre
 * lines, hatching), --pd-dim (dimension lines), --pd-dim-text and --pd-fill.
 * Strokes don't scale, so line weights stay the same at every size.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const holes = [
  [15, 15],
  [145, 15],
  [15, 85],
  [145, 85],
] as const;

/** Dimension lines with an arrowhead at each end. */
const dimensions = [
  { d: "M0 118H160", text: "160", x: 80, y: 115.5 },
  { d: "M15 -14H145", text: "130", x: 60, y: -16.5 },
  {
    d: "M-16 0V100",
    text: "100",
    transform: "translate(-18.5 50) rotate(-90)",
  },
  { d: "M178 15V85", text: "70", transform: "translate(175.5 50) rotate(-90)" },
] as const;

/** Single-ended arrows: the section marks and the small "8" dimension. */
const arrows = ["M80 -7H88", "M80 107H88", "M190 -10H200", "M218 -10H208"];
---

<svg
  class:list={["part-drawing", className]}
  viewBox="-28 -26 250 154"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <marker
      id="pd-arrow"
      viewBox="0 0 6 4"
      refX="6"
      refY="2"
      markerWidth="6"
      markerHeight="4"
      markerUnits="userSpaceOnUse"
      orient="auto-start-reverse"
    >
      <path class="pd-arrowhead" d="M0 0L6 2L0 4Z"></path>
    </marker>
    <pattern
      id="pd-hatch"
      width="3"
      height="3"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(45)"
    >
      <line class="pd-hatch-line" x1="0" y1="0" x2="0" y2="3"></line>
    </pattern>
  </defs>

  <!-- Front view -->
  <rect class="pd-body" x="0" y="0" width="160" height="100" rx="6"></rect>
  {holes.map(([cx, cy]) => (
    <circle class="pd-outline" cx={cx} cy={cy} r="5" />
  ))}
  <path
    class="pd-outline"
    d="M57 43H103A7 7 0 0 1 103 57H57A7 7 0 0 1 57 43Z"
  ></path>

  <!-- Centre lines -->
  <path class="pd-center" d="M-6 50H164"></path>
  {holes.map(([cx, cy]) => (
    <path
      class="pd-center"
      d={`M${cx - 8} ${cy}H${cx + 8}M${cx} ${cy - 8}V${cy + 8}`}
    />
  ))}

  <!-- Cutting plane A–A through the slot -->
  <path class="pd-center" d="M80 -4V104"></path>
  <path class="pd-cut" d="M80 -7V-1M80 101V107"></path>
  <text class="pd-text" x="91" y="-4.5">
    A
  </text>
  <text class="pd-text" x="91" y="109.5">
    A
  </text>

  <!-- Section A–A -->
  <rect class="pd-section" x="200" y="0" width="8" height="43"></rect>
  <rect class="pd-section" x="200" y="57" width="8" height="43"></rect>
  <text class="pd-text pd-text--title" x="204" y="116" text-anchor="middle">
    A–A
  </text>

  <!-- Dimensions -->
  <path
    class="pd-ext"
    d="M0 103V121M160 103V121M-3 0H-19M-3 100H-19M15 7V-17M145 7V-17M153 15H181M153 85H181M200 -2V-13M208 -2V-13"
  ></path>
  {dimensions.map(({ d }) => (
    <path
      class="pd-dim"
      d={d}
      marker-start="url(#pd-arrow)"
      marker-end="url(#pd-arrow)"
    />
  ))}
  {arrows.map((d) => (
    <path class="pd-dim" d={d} marker-end="url(#pd-arrow)" />
  ))}
  {dimensions.map((dimension) =>
    "transform" in dimension ? (
      <text
        class="pd-text"
        transform={dimension.transform}
        text-anchor="middle"
      >
        {dimension.text}
      </text>
    ) : (
      <text
        class="pd-text"
        x={dimension.x}
        y={dimension.y}
        text-anchor="middle"
      >
        {dimension.text}
      </text>
    ),
  )}
  <text class="pd-text" x="204" y="-12.5" text-anchor="middle">
    8
  </text>
  <path class="pd-dim" d="M148.5 11.5L156 4H180"></path>
  <text class="pd-text" x="157" y="1.5">
    4× Ø10
  </text>
</svg>

<style>
  .part-drawing {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .part-drawing :is(path, rect, circle) {
    vector-effect: non-scaling-stroke;
    fill: none;
  }

  .pd-body,
  .pd-outline {
    stroke: var(--pd-ink);
    stroke-width: 1.75px;
  }

  .part-drawing .pd-body {
    fill: var(--pd-fill, none);
  }

  .part-drawing .pd-section {
    fill: url(#pd-hatch);
    stroke: var(--pd-ink);
    stroke-width: 1.75px;
  }

  .pd-hatch-line {
    stroke: var(--pd-muted);
    stroke-width: 0.35;
  }

  .pd-center {
    stroke: var(--pd-muted);
    stroke-width: 1px;
    stroke-dasharray: 12 3 2 3;
  }

  .pd-cut {
    stroke: var(--pd-ink);
    stroke-width: 2.5px;
  }

  .pd-ext,
  .pd-dim {
    stroke: var(--pd-dim);
    stroke-width: 1px;
  }

  .part-drawing .pd-arrowhead {
    fill: var(--pd-dim);
  }

  .pd-text {
    fill: var(--pd-dim-text);
    font-family: var(--font-label);
    font-size: 6.5px;
    font-stretch: var(--label-stretch, 100%);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .pd-text--title {
    fill: var(--pd-ink);
    font-size: 7px;
    font-weight: 600;
  }
</style>
