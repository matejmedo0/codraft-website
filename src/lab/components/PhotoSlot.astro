---
/**
 * Where a photograph will go (direction C). Drawn as a drafting placeholder,
 * a frame with its diagonals, and captioned with the shot it waits for. The
 * client's photos arrive in phase 3 (docs/brand.md, "Imagery"); no stock or
 * generated people stand in for them.
 */
interface Props {
  /** The planned shot, e.g. "Tim na poslu". */
  shot: string;
  /** When it arrives. */
  note: string;
  ratio: "portrait" | "landscape";
  class?: string;
}

const { shot, note, ratio, class: className } = Astro.props;
---

<figure class:list={["photo-slot", `photo-slot--${ratio}`, className]}>
  <svg
    class="photo-slot__cross"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M0 0L100 100M100 0L0 100"></path>
  </svg>
  <figcaption class="photo-slot__caption">
    <span class="photo-slot__shot">{shot}</span>
    <span class="photo-slot__note">{note}</span>
  </figcaption>
</figure>

<style>
  .photo-slot {
    position: relative;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--photo-bg);
  }

  .photo-slot--portrait {
    aspect-ratio: 4 / 5;
  }

  .photo-slot--landscape {
    aspect-ratio: 3 / 2;
  }

  .photo-slot__cross {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .photo-slot__cross path {
    fill: none;
    stroke: var(--line);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .photo-slot__caption {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: grid;
    gap: 0.125rem;
    padding: 0.75rem 0.875rem;
    border-radius: var(--radius);
    background: var(--paper);
  }

  .photo-slot__shot {
    font-weight: 600;
  }

  .photo-slot__note {
    color: var(--ink-muted);
    font-size: 0.875rem;
  }
</style>
