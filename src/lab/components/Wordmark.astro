---
/**
 * The Codraft wordmark, inlined (lab copy; the production component arrives
 * after the client picks a direction). Geometry from
 * Assets/codraft-brand/wordmark/codraft-wordmark-primary.svg; the C2PA block
 * is left out (ADR 0014).
 *
 * The lettering takes `currentColor`. The blue accent is split into three
 * paths, as docs/brand.md describes: the arc on the "c", the drafting line
 * that forms the "f" and "t" crossbars, and the hollow grip. The line runs
 * under the grip's left side, so the parts meet without a seam and the union
 * is the master's accent exactly.
 *
 * `draw` plays the entrance once per page load: the line draws from the left,
 * then the grip snaps in (ADR 0014, docs/motion.md). Reduced motion shows the
 * complete mark at once.
 */
interface Props {
  /** Accessible name. Without one, the mark is decorative and hidden. */
  label?: string;
  draw?: boolean;
  class?: string;
}

const { label, draw = false, class: className } = Astro.props;
---

