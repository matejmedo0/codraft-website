<style>
  /* Size it with --wordmark-width on the element or a parent; a plain width
     rule would lose to this scoped selector. */
  .wordmark {
    display: block;
    width: var(--wordmark-width, 100%);
    height: auto;
    overflow: visible;
  }

  .wordmark__ink {
    fill: currentColor;
  }

  .wordmark__accent {
    fill: var(--wordmark-accent, var(--accent));
  }

  /* The entrance: the line grows from its left end (a solid rectangle, so
     scaleX is the same as a reveal), then the grip snaps in. Both stay hidden
     during the delay (fill mode "both"). */
  .wordmark--draw .wordmark__line {
    transform-box: fill-box;
    transform-origin: 0 50%;
    animation: wordmark-draw var(--motion-draw) var(--ease-pen)
      var(--wordmark-delay) both;
  }

  .wordmark--draw .wordmark__grip {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: wordmark-snap var(--motion-snap) var(--ease-snap)
      calc(var(--wordmark-delay) + var(--motion-draw)) both;
  }

  @keyframes wordmark-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes wordmark-snap {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark--draw .wordmark__line,
    .wordmark--draw .wordmark__grip {
      animation: none;
    }
  }
</style>
