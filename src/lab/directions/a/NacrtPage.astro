---
/**
 * Direction A "Nacrt" (docs/phases/2-design.md, step 1): the home page as a
 * drawing sheet. Zones A–D label the sections like a sheet's grid
 * references, and the footer is the title block.
 */
import "./nacrt.css";

import { pathFor } from "../../../features/i18n/urls.ts";
import Grips from "../../components/Grips.astro";
import PartDrawing from "../../components/PartDrawing.astro";
import Wordmark from "../../components/Wordmark.astro";
import { DRAFTING, FOOTER, HEADER, HERO, NAV, SERVICES } from "../../copy.ts";

const locale = "hr";
const services = pathFor("services", locale);

/** Home is sheet 1 of the six main pages (docs/information-architecture.md). */
const SHEET = { number: 1, of: 6 };
const ZONES = [1, 2, 3, 4, 5, 6];

const built = new Date();
const builtLabel = new Intl.DateTimeFormat("hr-HR", {
  day: "numeric",
  month: "numeric",
  year: "numeric",
}).format(built);
const builtIso = built.toISOString().slice(0, 10);
---

<div class="sheet">
  <ol class="sheet__zones" aria-hidden="true">
    {ZONES.map((zone) => (
      <li>{zone}</li>
    ))}
  </ol>

  <header class="masthead">
    <a class="masthead__home" href={pathFor("home", locale)}>
      <span class="visually-hidden">{HEADER.home}</span>
      <Wordmark />
    </a>
    <button
      class="masthead__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="izbornik-a"
      data-menu-toggle
    >
      {HEADER.menu}
      <span class="masthead__toggle-icon" aria-hidden="true"></span>
    </button>
    <nav class="masthead__nav" id="izbornik-a" aria-label="Glavna navigacija">
      <ul class="masthead__links">
        {NAV.map(({ page, label }) => (
          <li>
            <a href={pathFor(page, locale)}>{label}</a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary has-grips" href={pathFor("audit", locale)}>
        {HEADER.cta}
        <Grips />
      </a>
      <a
        class="masthead__lang"
        href={pathFor("home", "en")}
        hreflang="en"
        lang="en"
      >
        {HEADER.otherLanguage}
        <span class="visually-hidden">({HEADER.otherLanguageName})</span>
      </a>
    </nav>
  </header>

  <main id="sadrzaj">
    <section class="zone hero" aria-labelledby="naslov">
      <span class="zone__letter" aria-hidden="true">
        A
      </span>
      <div class="hero__text">
        <h1 id="naslov">{HERO.title}</h1>
        <p class="hero__lead">{HERO.lead}</p>
        <div class="hero__actions">
          <a class="btn btn--primary has-grips" href={pathFor("audit", locale)}>
            {HERO.primary}
            <Grips />
          </a>
          <a class="btn btn--secondary has-grips" href={services}>
            {HERO.secondary}
            <Grips />
          </a>
        </div>
        <p class="hero__drafting">
          <a href={pathFor("drafting", locale)}>{HERO.draftingLink}</a>
        </p>
      </div>
      <div class="hero__drawing drafting-grid">
        <Wordmark class="hero__mark" draw />
      </div>
    </section>

    <section class="zone services" aria-labelledby="usluge">
      <span class="zone__letter" aria-hidden="true">
        B
      </span>
      <span class="zone__rule rule-draw" aria-hidden="true"></span>
      <h2 id="usluge">{SERVICES.title}</h2>

      <div class="stage">
        <div class="stage__head">
          <h3>
            <span class="bubble">{SERVICES.plan.number}</span>
            {SERVICES.plan.title}
          </h3>
          <p class="stage__tagline">{SERVICES.plan.tagline}</p>
        </div>
        <div class="stage__body">
          <p>{SERVICES.plan.body}</p>
          <p>
            <a class="stage__cta" href={pathFor("audit", locale)}>
              {SERVICES.plan.cta}
            </a>
          </p>
        </div>
      </div>

      {SERVICES.stages.map((stage) => (
        <div class="stage">
          <div class="stage__head">
            <h3>
              <span class="bubble">{stage.number}</span>
              {stage.title}
            </h3>
            <p class="stage__tagline">{stage.tagline}</p>
          </div>
          <ul class="cards">
            {stage.items.map((item) => (
              <li class="card has-grips">
                <h4>
                  <a class="stretched-link" href={`${services}#${item.anchor}`}>
                    {item.title}
                  </a>
                </h4>
                <p>{item.body}</p>
                <Grips />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="zone drafting" aria-labelledby="cad">
      <span class="zone__letter" aria-hidden="true">
        C
      </span>
      <span class="zone__rule rule-draw" aria-hidden="true"></span>
      <div class="drafting__text">
        <h2 id="cad">{DRAFTING.title}</h2>
        <p class="drafting__tagline">{DRAFTING.tagline}</p>
        <p class="drafting__audience">{DRAFTING.audience}</p>
        <div class="drafting__items">
          {DRAFTING.items.map((item) => (
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))}
        </div>
        <a
          class="btn btn--primary has-grips"
          href={pathFor("drafting", locale)}
        >
          {DRAFTING.cta}
          <Grips />
        </a>
      </div>
      <figure class="drafting__drawing drafting-grid">
        <PartDrawing />
      </figure>
    </section>
  </main>

  <footer class="title-block">
    <span class="zone__letter" aria-hidden="true">
      D
    </span>
    <dl class="title-block__grid">
      <div class="title-block__mark">
        <dt class="visually-hidden">Znak</dt>
        <dd>
          <Wordmark label="Codraft" />
        </dd>
      </div>
      {FOOTER.company.map(({ label, value }) => (
        <div>
          <dt class="t-label">{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
      <div>
        <dt class="t-label">Kontakt</dt>
        <dd>—</dd>
      </div>
      <div class="title-block__legal">
        <dt class="t-label">Pravne informacije</dt>
        <dd>
          <ul>
            {FOOTER.legal.map(({ page, label }) => (
              <li>
                <a href={pathFor(page, locale)}>{label}</a>
              </li>
            ))}
          </ul>
        </dd>
      </div>
      <div class="title-block__lang">
        <dt class="t-label">Jezik</dt>
        <dd>
          <a href={pathFor("home", "en")} hreflang="en" lang="en">
            English
          </a>
        </dd>
      </div>
      <div>
        <dt class="t-label">List</dt>
        <dd>
          {SHEET.number} od {SHEET.of}
        </dd>
      </div>
      <div>
        <dt class="t-label">Zadnja izmjena</dt>
        <dd>
          <time datetime={builtIso}>{builtLabel}</time>
        </dd>
      </div>
      <div class="title-block__note">
        <dt class="visually-hidden">Napomena</dt>
        <dd class="t-label">{FOOTER.placeholderNote}</dd>
      </div>
    </dl>
  </footer>
</div>
