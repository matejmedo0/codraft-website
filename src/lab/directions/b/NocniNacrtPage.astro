---
/**
 * Direction B "Noćni nacrt" (docs/phases/2-design.md, step 1): navy model
 * space with the mark at full width, services on a paper sheet laid on the
 * navy desk, and a blueprint drawing for the CAD offer.
 */
import "./nocni-nacrt.css";

import { pathFor } from "../../../features/i18n/urls.ts";
import Grips from "../../components/Grips.astro";
import PartDrawing from "../../components/PartDrawing.astro";
import Wordmark from "../../components/Wordmark.astro";
import { DRAFTING, FOOTER, HEADER, HERO, NAV, SERVICES } from "../../copy.ts";

const locale = "hr";
const services = pathFor("services", locale);
---

<div class="on-navy">
  <header class="wrap topbar">
    <a class="topbar__home" href={pathFor("home", locale)}>
      <span class="visually-hidden">{HEADER.home}</span>
      <Wordmark />
    </a>
    <button
      class="topbar__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="izbornik-b"
      data-menu-toggle
    >
      {HEADER.menu}
      <span class="topbar__toggle-icon" aria-hidden="true"></span>
    </button>
    <nav class="topbar__nav" id="izbornik-b" aria-label="Glavna navigacija">
      <ul class="topbar__links">
        {NAV.map(({ page, label }) => (
          <li>
            <a href={pathFor(page, locale)}>{label}</a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary has-grips" href={pathFor("audit", locale)}>
        {HEADER.cta}
        <Grips />
      </a>
      <a
        class="topbar__lang"
        href={pathFor("home", "en")}
        hreflang="en"
        lang="en"
      >
        {HEADER.otherLanguage}
        <span class="visually-hidden">({HEADER.otherLanguageName})</span>
      </a>
    </nav>
  </header>

  <main id="sadrzaj">
    <section class="hero" aria-labelledby="naslov">
      <div class="wrap">
        <div class="hero__text">
          <h1 id="naslov">{HERO.title}</h1>
          <p class="hero__lead">{HERO.lead}</p>
          <div class="hero__actions">
            <a
              class="btn btn--primary has-grips"
              href={pathFor("audit", locale)}
            >
              {HERO.primary}
              <Grips />
            </a>
            <a class="btn btn--secondary has-grips" href={services}>
              {HERO.secondary}
              <Grips />
            </a>
          </div>
          <p class="hero__drafting">
            <a href={pathFor("drafting", locale)}>{HERO.draftingLink}</a>
          </p>
        </div>
        <Wordmark class="hero__mark" draw />
      </div>
    </section>

    <div class="wrap">
      <section class="sheet on-paper" aria-labelledby="usluge">
        <div class="sheet__head">
          <h2 id="usluge">{SERVICES.title}</h2>
          <p class="sheet__intro">{SERVICES.intro}</p>
        </div>
        <div class="stages">
          <div class="stage">
            <span class="stage__rule rule-draw" aria-hidden="true"></span>
            <h3>
              <span class="stage__number">{SERVICES.plan.number}</span>
              {SERVICES.plan.title}
            </h3>
            <p class="stage__tagline">{SERVICES.plan.tagline}</p>
            <p class="stage__body">{SERVICES.plan.body}</p>
            <a class="stage__cta" href={pathFor("audit", locale)}>
              {SERVICES.plan.cta}
            </a>
          </div>
          {SERVICES.stages.map((stage) => (
            <div class="stage">
              <span class="stage__rule rule-draw" aria-hidden="true" />
              <h3>
                <span class="stage__number">{stage.number}</span>
                {stage.title}
              </h3>
              <p class="stage__tagline">{stage.tagline}</p>
              <ul class="items">
                {stage.items.map((item) => (
                  <li class="item has-grips">
                    <h4>
                      <a
                        class="stretched-link"
                        href={`${services}#${item.anchor}`}
                      >
                        {item.title}
                      </a>
                    </h4>
                    <p>{item.body}</p>
                    <Grips />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    </div>

    <section class="wrap drafting" aria-labelledby="cad">
      <div class="drafting__text">
        <h2 id="cad">{DRAFTING.title}</h2>
        <p class="drafting__tagline">{DRAFTING.tagline}</p>
        <p class="drafting__audience">{DRAFTING.audience}</p>
        <div class="drafting__items">
          {DRAFTING.items.map((item) => (
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))}
        </div>
        <a
          class="btn btn--primary has-grips"
          href={pathFor("drafting", locale)}
        >
          {DRAFTING.cta}
          <Grips />
        </a>
      </div>
      <figure class="drafting__drawing">
        <PartDrawing />
      </figure>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__grid">
      <div>
        <Wordmark class="footer__mark" label="Codraft" />
        <p class="footer__note t-label">{FOOTER.placeholderNote}</p>
      </div>
      <dl class="footer__company">
        {FOOTER.company.map(({ label, value }) => (
          <div>
            <dt class="t-label">{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <nav aria-label="Pravne informacije">
        <ul class="footer__links">
          {FOOTER.legal.map(({ page, label }) => (
            <li>
              <a href={pathFor(page, locale)}>{label}</a>
            </li>
          ))}
          <li>
            <a href={pathFor("home", "en")} hreflang="en" lang="en">
              English
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </footer>
</div>
