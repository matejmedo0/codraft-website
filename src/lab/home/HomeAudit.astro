---
/**
 * Zone C: the free audit and its three steps (ADR 0007: form → time slot →
 * confirmation), on paper (ADR 0015). It holds the page's one "Rezervirajte
 * besplatnu analizu" (ADR 0017): the button sits where the audit is
 * explained. What the audit checks (G4) waits for the client, so a
 * placeholder says so.
 */
import Button from "../../components/ui/Button.astro";
import Steps from "../../components/ui/Steps.astro";
import Zone from "../../components/ui/Zone.astro";
import { pathFor } from "../../features/i18n/urls.ts";
import { AUDIT } from "../copy.ts";
---

<Zone labelledby="analiza" class="home-audit">
  <div class="home-audit__intro">
    <h2 id="analiza">{AUDIT.title}</h2>
    <p class="home-audit__lead">{AUDIT.lead}</p>
  </div>
  <div class="home-audit__steps">
    <Steps steps={AUDIT.steps} />
  </div>
  <div class="home-audit__actions">
    <Button href={pathFor("audit", "hr")}>{AUDIT.cta}</Button>
    <p class="home-audit__note t-label">{AUDIT.placeholderNote}</p>
  </div>
</Zone>

<style>
  .home-audit {
    display: grid;
    gap: var(--space-7);
  }

  .home-audit__lead {
    max-width: var(--measure-lead);
    margin-top: var(--space-4);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  .home-audit__actions {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .home-audit__note {
    color: var(--ink-muted);
  }

  @media (min-width: 64rem) {
    .home-audit {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      row-gap: var(--space-7);
    }

    .home-audit__intro,
    .home-audit__actions {
      grid-column: 1 / span 5;
    }

    .home-audit__steps {
      grid-row: 1 / span 2;
      grid-column: 7 / -1;
      align-self: center;
    }
  }
</style>
