---
/**
 * Zone G: the closing call to action, the page's one navy surface
 * (ADR 0015). It invites a conversation and doesn't repeat the audit, which
 * its own zone asks for once (ADR 0017): the client's question and lead
 * (review batch 11), then one button to Kontakt.
 *
 * The heading is a zone h2, smaller than the hero's; the heading and lead
 * are one block on the left, the button on the right, centred on it. Below
 * 900 px (the client's breakpoint) they stack, aligned left.
 */
import Button from "../../components/ui/Button.astro";
import Zone from "../../components/ui/Zone.astro";
import { pathFor } from "../../features/i18n/urls.ts";
import { CLOSING } from "../copy.ts";
---

<Zone labelledby="zavrsni-poziv" surface="navy" class="home-closing">
  <div class="home-closing__text">
    <h2 id="zavrsni-poziv">{CLOSING.title}</h2>
    <p class="home-closing__lead">{CLOSING.lead}</p>
  </div>
  <Button href={pathFor("contact", "hr")} class="home-closing__cta">
    {CLOSING.secondary}
  </Button>
</Zone>

<style>
  /* Two thirds of a zone's padding, as the heading is two thirds of its
     old size (48 of 72 px). */
  .home-closing {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
    padding-block: calc(var(--zone-pad) * 2 / 3);
  }

  /* Narrow enough that the heading takes two lines at most. */
  .home-closing__text {
    max-width: 40rem;
  }

  /* As the other zones' leads, in the navy surface's ink. */
  .home-closing__lead {
    max-width: var(--measure-lead);
    margin-top: var(--space-4);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  @media (min-width: 56.25rem) {
    .home-closing {
      flex-direction: row;
      gap: var(--gap);
      align-items: center;
      justify-content: space-between;
    }

    .home-closing__cta {
      flex: none;
    }
  }
</style>
