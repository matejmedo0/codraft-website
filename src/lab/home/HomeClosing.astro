---
/**
 * Zone G: the closing call to action, the page's one navy surface
 * (ADR 0015). It invites a conversation and doesn't repeat the audit, which
 * its own zone asks for once (ADR 0017): the stage 01 tagline, then one
 * button to Kontakt.
 */
import Button from "../../components/ui/Button.astro";
import Zone from "../../components/ui/Zone.astro";
import { pathFor } from "../../features/i18n/urls.ts";
import { CLOSING } from "../copy.ts";
---

<Zone labelledby="zavrsni-poziv" surface="navy" class="home-closing">
  <h2 class="home-closing__title" id="zavrsni-poziv">
    {CLOSING.title}
  </h2>
  <div class="home-closing__actions">
    <Button href={pathFor("contact", "hr")}>{CLOSING.secondary}</Button>
  </div>
</Zone>

<style>
  .home-closing {
    display: grid;
    gap: var(--space-6);
  }

  .home-closing__title {
    font-size: var(--step-display);
    font-weight: var(--weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .home-closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .home-closing {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--gap);
      align-items: end;
    }

    .home-closing__title {
      grid-column: 1 / span 6;
    }

    .home-closing__actions {
      grid-column: 7 / -1;
      justify-content: flex-end;
    }
  }
</style>
