---
/**
 * Zone D: the drafting offer, the second audience's own path (ADR 0018),
 * with a floor plan on graph paper beside it, drawn like a timelapse of
 * drafting when half of it is in view (PlanDrawing.astro, review batch 5).
 */
import Button from "../../components/ui/Button.astro";
import Zone from "../../components/ui/Zone.astro";
import { pathFor } from "../../features/i18n/urls.ts";
import { DRAFTING } from "../copy.ts";
import PlanDrawing from "./PlanDrawing.astro";
---

<Zone labelledby="cad" class="home-drafting">
  <div class="home-drafting__text">
    <h2 id="cad">{DRAFTING.title}</h2>
    <p class="home-drafting__tagline">{DRAFTING.tagline}</p>
    <p class="home-drafting__audience">{DRAFTING.audience}</p>
    <div class="home-drafting__items">
      {DRAFTING.items.map((item) => (
        <div>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
    <Button href={pathFor("drafting", "hr")}>{DRAFTING.cta}</Button>
  </div>
  <div class="home-drafting__figure">
    <PlanDrawing />
  </div>
</Zone>

<style>
  .home-drafting {
    display: grid;
    gap: var(--space-7);
  }

  .home-drafting__tagline {
    margin-top: var(--space-4);
    font-size: var(--step-title);
    font-stretch: var(--width-heading);
    font-weight: var(--weight-medium);
    line-height: 1.25;
  }

  .home-drafting__audience {
    max-width: var(--measure-lead);
    margin-top: var(--space-4);
    color: var(--ink-muted);
  }

  .home-drafting__items {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-6) 0;
  }

  .home-drafting__items h3 {
    margin-bottom: 0.375rem;
    font-size: 1.125rem;
    font-stretch: var(--width-text);
  }

  @media (min-width: 64rem) {
    .home-drafting {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--gap);
      align-items: center;
    }

    .home-drafting__text {
      grid-column: 1 / span 5;
    }

    .home-drafting__figure {
      grid-column: 6 / -1;
    }
  }
</style>
