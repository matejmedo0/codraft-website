---
/**
 * Zone A of Home in the chosen direction (ADR 0015): the headline, then the
 * lead beside a drawing on graph paper that holds the mark, which plays its
 * entrance once per load (ADR 0014). On paper, like the header above it.
 *
 * The H1 reads in two lines, as the client asked (review batches 2 and 5):
 * "Planiramo, izrađujemo i održavamo" / "web stranice, softver i AI alate."
 * From 64rem it spans the whole sheet, so both lines keep their full size
 * on laptops too; narrower screens wrap it as one sentence.
 *
 * The hero orients and doesn't sell (ADR 0017): its one button leads to the
 * services, and the drafting clients get their own path below it
 * (ADR 0018). The free audit is asked for once, in its own zone.
 */
import Button from "../../components/ui/Button.astro";
import Wordmark from "../../components/ui/Wordmark.astro";
import Zone from "../../components/ui/Zone.astro";
import { pathFor } from "../../features/i18n/urls.ts";
import { HERO } from "../copy.ts";

const locale = "hr";
---

<Zone labelledby="naslov" select={false} class="home-hero">
  <h1 class="home-hero__title" id="naslov">
    <span class="home-hero__line">{HERO.titleLines[0]}</span>{" "}
    <span class="home-hero__line">{HERO.titleLines[1]}</span>
  </h1>
  <div class="home-hero__text">
    <p class="home-hero__lead">{HERO.lead}</p>
    <div class="home-hero__actions">
      <Button href={pathFor("services", locale)}>{HERO.secondary}</Button>
    </div>
    <p class="home-hero__drafting">
      <a href={pathFor("drafting", locale)}>{HERO.draftingLink}</a>
    </p>
  </div>
  <div class="home-hero__drawing graph-paper">
    <Wordmark entrance />
  </div>
</Zone>

<style>
  .home-hero {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7) var(--space-8);
  }

  .home-hero__lead {
    max-width: var(--measure-lead);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .home-hero__drafting {
    margin-top: var(--space-5);
  }

  .home-hero__drafting a {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }

  /* On narrow screens the drawing is a low strip and the mark stays mid
     size (the client didn't want a large mark in front). */
  .home-hero__drawing {
    display: grid;
    place-items: center;
    aspect-ratio: 21 / 9;
    margin-top: var(--space-3);
    padding: 6% 25%;
    color: var(--ink);
  }

  @media (min-width: 64rem) {
    .home-hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-7) var(--gap);
      align-items: start;
      padding-block: 4.5rem var(--space-10);
    }

    /* The first line is about 14 em long and fits the sheet from 64rem at
       the full display size. */
    .home-hero__title {
      grid-column: 1 / -1;
    }

    .home-hero__line {
      display: block;
    }

    .home-hero__text {
      grid-column: 1 / span 6;
    }

    .home-hero__drawing {
      grid-column: 8 / -1;
      aspect-ratio: 16 / 10;
      margin-top: 0;
      padding: 10% 16%;
    }
  }
</style>
