---
/**
 * Zone E, "Kako radimo": three commitments taken from the existing copy
 * (docs/information-architecture.md, Home §6). Who owns the domain and the
 * code (G2) joins once the client decides.
 */
import Zone from "../../components/ui/Zone.astro";
import { PRINCIPLES } from "../copy.ts";
---

<Zone labelledby="kako-radimo" class="home-principles">
  <h2 id="kako-radimo">{PRINCIPLES.title}</h2>
  <ul class="home-principles__list">
    {PRINCIPLES.items.map((item) => (
      <li class="principle">
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </li>
    ))}
  </ul>
</Zone>

<style>
  .home-principles__list {
    display: grid;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .principle {
    display: grid;
    gap: var(--space-2);
    padding: 1.25rem 0 var(--space-5);
    border-top: var(--rule) solid var(--line);
  }

  .principle p {
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  @media (min-width: 64rem) {
    .home-principles {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--gap);
      align-items: start;
    }

    .home-principles > h2 {
      grid-column: 1 / span 4;
    }

    .home-principles__list {
      grid-column: 5 / -1;
      margin: 0;
    }

    .principle {
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr);
      gap: var(--gap);
      padding-block: var(--space-5) 1.75rem;
    }

    .principle:first-child {
      padding-top: var(--space-2);
      border-top: 0;
    }
  }
</style>
