---
/**
 * Zone B, "Što radimo", as D's chapters (ADR 0015): each stage is a row, its
 * number in a grid bubble, with a large title beside its services. A process
 * line joins the bubbles 01 → 02 → 03; each chapter draws its stretch once,
 * as it scrolls into view (draw.ts). Stage 01 lists its two items from its
 * own text, without a link to the audit: the audit zone follows and asks
 * once (ADR 0017). The services of stages 02 and 03 link to /usluge.
 */
import Item from "../../components/ui/Item.astro";
import Zone from "../../components/ui/Zone.astro";
import { pathFor } from "../../features/i18n/urls.ts";
import { PLAN_ITEMS, SERVICES } from "../copy.ts";

interface ChapterItem {
  title: string;
  body: string;
  href?: string;
}

interface Chapter {
  number: string;
  title: string;
  tagline: string;
  items: ChapterItem[];
}

const services = pathFor("services", "hr");
const { plan, stages } = SERVICES;

const chapters: Chapter[] = [
  { ...plan, items: PLAN_ITEMS },
  ...stages.map((stage) => ({
    ...stage,
    items: stage.items.map(({ title, body, anchor }) => ({
      title,
      body,
      href: `${services}#${anchor}`,
    })),
  })),
];
---

<Zone labelledby="usluge" class="home-services">
  <h2 id="usluge">{SERVICES.title}</h2>
  <div class="chapters">
    {chapters.map((chapter) => (
      <div class="chapter" data-draw="late">
        <span class="chapter__rail" aria-hidden="true" />
        <div class="chapter__head">
          <h3 class="chapter__title">
            <span class="chapter__bubble">{chapter.number}</span>
            {chapter.title}
          </h3>
          <p class="chapter__tagline">{chapter.tagline}</p>
        </div>
        <ul class="chapter__items">
          {chapter.items.map(({ body, ...item }) => (
            <Item as="li" level={4} {...item}>
              {body}
            </Item>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Zone>

<style>
  .home-services > h2 {
    margin-bottom: var(--space-6);
  }

  .chapters {
    --bubble: 2.75rem;
  }

  .chapter {
    --chapter-top: var(--space-6);

    position: relative;
    display: grid;
    gap: var(--space-5);
    padding: var(--chapter-top) 0 var(--space-7)
      calc(var(--bubble) + var(--space-4));
  }

  .chapter + .chapter {
    border-top: var(--rule) solid var(--line);
  }

  .chapter__title {
    padding-top: max(0px, (var(--bubble) - 1lh) / 2);
    font-size: var(--step-chapter);
    font-weight: var(--weight-chapter);
    line-height: 1.1;
    letter-spacing: -0.018em;
  }

  /* A grid bubble, as at the end of a drawing's grid line. */
  .chapter__bubble {
    position: absolute;
    z-index: 1;
    top: var(--chapter-top);
    left: 0;
    display: grid;
    place-items: center;
    width: var(--bubble);
    height: var(--bubble);
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: var(--surface);
    font-size: 0.875rem;
    font-stretch: var(--width-label);
    font-weight: var(--weight-strong);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    line-height: 1;
  }

  .chapter__tagline {
    max-width: 26ch;
    margin-top: var(--space-3);
    color: var(--ink-muted);
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  /* The process line through the bubbles. */
  .chapter__rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc((var(--bubble) - var(--rail)) / 2);
    width: var(--rail);
    background: var(--accent);
    transform-origin: 50% 0;
  }

  .chapter:first-child .chapter__rail {
    top: calc(var(--chapter-top) + var(--bubble) / 2);
  }

  .chapter:last-child .chapter__rail {
    bottom: auto;
    height: calc(var(--chapter-top) + var(--bubble) / 2);
  }

  .chapter.is-pending .chapter__rail {
    transform: scaleY(0);
  }

  .chapter.is-drawing .chapter__rail {
    animation: motion-draw-y var(--motion-draw) var(--ease-pen) both;
  }

  .chapter__items {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .chapter__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--gap);
    }
  }

  @media (min-width: 64rem) {
    .chapter {
      --chapter-top: 2.75rem;

      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--gap);
      padding: var(--chapter-top) 0 var(--space-8)
        calc(var(--bubble) + var(--gap));
    }
  }
</style>
