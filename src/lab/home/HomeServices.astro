---
/**
 * Zone B, "Što radimo", option 1 "Poglavlja" (the client's review,
 * batch 3): D's chapters, tightened. Each stage is a row with its number in
 * a grid bubble and its title on the left, and its services on the right in
 * two columns; an odd last service takes the whole row, so no cell stays
 * empty. The services' sentences are larger and in full ink.
 *
 * The process line joins the bubbles 01 → 02 → 03 and draws as one stroke
 * when the section reaches its trigger (process-line.ts).
 */
import "./services.css";

import Zone from "../../components/ui/Zone.astro";
import { SERVICES } from "../copy.ts";
import { CHAPTERS } from "./chapters.ts";
import ServiceItem from "./ServiceItem.astro";

interface Props {
  /** The heading's id; the comparison page shows several options. */
  headingId?: string;
  /** The option's name, on the comparison page. */
  label?: string;
}

const { headingId = "usluge", label } = Astro.props;
const labelId = `${headingId}-opcija`;
---

<Zone
  labelledby={label === undefined ? headingId : `${labelId} ${headingId}`}
  class="svc"
>
  {label !== undefined && (
    <p class="svc-label t-label" id={labelId}>
      {label}
    </p>
  )}
  <h2 id={headingId}>{SERVICES.title}</h2>
  <div
    class="svc-line chapters"
    data-draw="late"
    data-draw-wait
    data-process-line
  >
    {CHAPTERS.map((chapter) => (
      <div class="chapter">
        <span class="svc-rail chapter__rail" data-rail aria-hidden="true" />
        <div class="chapter__head">
          <h3 class="svc-title chapter__title">
            <span class="svc-bubble chapter__bubble">{chapter.number}</span>
            {chapter.title}
          </h3>
          <p class="svc-tagline chapter__tagline">{chapter.tagline}</p>
        </div>
        <ul class="svc-items chapter__items">
          {chapter.items.map((item) => (
            <ServiceItem
              title={item.title}
              body={item.body}
              href={item.href}
              class="chapter__item"
            />
          ))}
        </ul>
      </div>
    ))}
  </div>
  <script>
    import "../../components/ui/draw.ts";
    import "./process-line.ts";
  </script>
</Zone>

<style>
  .chapter {
    --chapter-top: var(--space-5);

    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--chapter-top) 0 var(--space-6)
      calc(var(--bubble) + var(--space-4));
  }

  .chapter + .chapter {
    border-top: var(--rule) solid var(--line);
  }

  .chapter__title {
    padding-top: max(0px, (var(--bubble) - 1lh) / 2);
  }

  .chapter__bubble {
    position: absolute;
    z-index: 1;
    top: var(--chapter-top);
    left: 0;
  }

  .chapter__tagline {
    max-width: 26ch;
    margin-top: var(--space-2);
  }

  .chapter__rail {
    top: 0;
    bottom: 0;
    left: calc((var(--bubble) - var(--rail)) / 2);
  }

  .chapter:first-child .chapter__rail {
    top: calc(var(--chapter-top) + var(--bubble) / 2);
  }

  .chapter:last-child .chapter__rail {
    bottom: auto;
    height: calc(var(--chapter-top) + var(--bubble) / 2);
  }

  .chapter__item {
    padding: var(--space-4) 0 var(--space-5);
    border-top: var(--rule) solid var(--line);
  }

  @media (min-width: 40rem) {
    .chapter__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--gap);
    }

    .chapter__item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .chapter {
      --chapter-top: var(--space-6);

      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--gap);
      padding: var(--chapter-top) 0 var(--space-7)
        calc(var(--bubble) + var(--gap));
    }
  }
</style>
