    }
  }

  @keyframes plan-lower-top {
    from {
      translate: 0 0;
    }

    to {
      translate: 0 var(--rise, 0);
    }
  }

  /* A side rises from the floor: its frame's origin (plan-model.ts). */
  @keyframes plan-rise-side {
    from {
      scale: 1 0;
    }

    to {
      scale: 1;
    }
  }

  @keyframes plan-rise-top {
