---
/**
 * One service in "Što radimo" (the client's review, batch 3): its title and
 * its sentence. The sentence is larger than body text and in full ink, so
 * it reads as clearly as the title. With `href` the whole item links to its
 * anchor on /usluge and shows the grips on hover and keyboard focus; the
 * outline goes around the item. Each option of the section places the
 * items its own way.
 *
 * With `icon` the item starts with its service icon (review batch 13); the
 * section places it.
 */
import type { HTMLAttributes } from "astro/types";

import Grips from "../../components/ui/Grips.astro";
import ServiceIcon from "./icons/ServiceIcon.astro";
import type { ServiceIconId } from "./icons/service-icons.ts";

interface Props extends HTMLAttributes<"li"> {
  title: string;
  body: string;
  href?: string | undefined;
  icon?: ServiceIconId | undefined;
  /** The title's level under the zone's headings. */
  level?: "h3" | "h4";
}

const {
  title,
  body,
  href,
  icon,
  level = "h4",
  class: className,
  ...attributes
} = Astro.props;
const Heading = level;
---

<li
  class:list={["service", { "has-grips": href !== undefined }, className]}
  {...attributes}
>
  {icon !== undefined && <ServiceIcon icon={icon} class="service__icon" />}
  <Heading class="service__title">
    {href === undefined ? (
      title
    ) : (
      <a class="service__link stretched-link" href={href}>
        {title}
      </a>
    )}
  </Heading>
  <p class="service__body">{body}</p>
  {href !== undefined && <Grips />}
</li>

<style>
  .service {
    position: relative;
  }

  .service__title {
    font-size: var(--step-title);
    font-stretch: var(--width-text);
    font-weight: var(--weight-strong);
    line-height: var(--leading-title);
    letter-spacing: -0.005em;
  }

  .service__link {
    color: var(--ink);
    text-decoration: none;
  }

  .service__link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .service__body {
    max-width: var(--measure);
    margin-top: var(--space-2);
    font-size: var(--step-service);
    line-height: 1.5;
  }

  /* The outline goes around the whole item, not just the title. */
  .service:has(.service__link:focus-visible) {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }

  .service__link:focus-visible {
    outline: none;
  }
</style>
