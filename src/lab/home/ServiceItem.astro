---
/**
 * One service in "Što radimo" (the client's review, batch 3): its title and
 * its sentence. The sentence is larger than body text and in full ink, so
 * it reads as clearly as the title. With `href` the whole item links to its
 * anchor on /usluge and shows the grips on hover and keyboard focus; the
 * outline goes around the item. Each option of the section places the
 * items its own way.
 *
 * With `number` the item is numbered in a circle drawn like the floor
 * plan's grid bubbles ("Tehničko crtanje", review batch 8); the number
 * stays readable to assistive technology.
 */
import type { HTMLAttributes } from "astro/types";

import Grips from "../../components/ui/Grips.astro";

interface Props extends HTMLAttributes<"li"> {
  title: string;
  body: string;
  href?: string | undefined;
  number?: string | undefined;
  /** The title's level under the zone's headings. */
  level?: "h3" | "h4";
}

const {
  title,
  body,
  href,
  number,
  level = "h4",
  class: className,
  ...attributes
} = Astro.props;
const Heading = level;
---

<li
  class:list={[
    "service",
    {
      "has-grips": href !== undefined,
      "service--numbered": number !== undefined,
    },
    className,
  ]}
  {...attributes}
>
  {number !== undefined && <span class="service__number">{number}</span>}
  <Heading class="service__title">
    {href === undefined ? (
      title
    ) : (
      <a class="service__link stretched-link" href={href}>
        {title}
      </a>
    )}
  </Heading>
  <p class="service__body">{body}</p>
  {href !== undefined && <Grips />}
</li>

<style>
  .service {
    position: relative;
  }

  .service__title {
    font-size: var(--step-title);
    font-stretch: var(--width-text);
    font-weight: var(--weight-strong);
    line-height: var(--leading-title);
    letter-spacing: -0.005em;
  }

  .service__link {
    color: var(--ink);
    text-decoration: none;
  }

  .service__link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .service__body {
    max-width: var(--measure);
    margin-top: var(--space-2);
    font-size: var(--step-service);
    line-height: 1.5;
  }

  /* Numbered: the circle beside the title and its line. */
  .service--numbered {
    --number-size: 2rem;

    display: grid;
    grid-template-columns: var(--number-size) minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: start;
  }

  .service--numbered :is(.service__title, .service__body) {
    grid-column: 2;
  }

  /* Like the plan's grid bubbles: a thin ink circle on paper, the number
     in the condensed width, centred on the title's first line. */
  .service__number {
    display: grid;
    grid-row: 1 / span 2;
    place-items: center;
    width: var(--number-size);
    height: var(--number-size);
    margin-top: calc(
      (var(--step-title) * var(--leading-title) - var(--number-size)) / 2
    );
    border: var(--rule) solid var(--drawing-ink);
    border-radius: 50%;
    background: var(--drawing-fill);
    color: var(--drawing-ink);
    font-size: 0.875rem;
    font-stretch: var(--width-label);
    font-weight: var(--weight-strong);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  /* The outline goes around the whole item, not just the title. */
  .service:has(.service__link:focus-visible) {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }

  .service__link:focus-visible {
    outline: none;
  }
</style>
