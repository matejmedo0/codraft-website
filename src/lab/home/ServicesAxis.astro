---
/**
 * Zone B, "Što radimo", option 3 "Središnja os" (the client's review,
 * batch 3), the client's choice in batch 4, with one short line per service
 * (chapters.ts). On wide screens the process line runs down the middle of the
 * sheet: each stage's bubble sits on it with the title and tagline centred
 * below, and its services stand left and right of the line, the left ones
 * aligned to it. The stage head covers the line where it passes behind the
 * title. An odd last service is centred under its stage. On narrow screens
 * the line runs down the left, as in option 1.
 *
 * The process line joins the bubbles 01 → 02 → 03. It follows the scroll
 * row by row, and each service's icon draws as the line reaches it, once
 * and only forwards (review batch 14; axis-line.ts). Without JavaScript or
 * with reduced motion the stages' rails draw it complete.
 *
 * With `icons` each service shows its icon on the side facing the line
 * (review batch 13, /lab/ikone): "above" the title, or "beside" the title
 * and its line, mirrored in the left column (the client's choice, batch 14,
 * ADR 0022). The centred last service has its icon centred above it.
 */
import "./services.css";

import Zone from "../../components/ui/Zone.astro";
import { SERVICES } from "../copy.ts";
import { CHAPTERS } from "./chapters.ts";
import ServiceItem from "./ServiceItem.astro";

interface Props {
  /** The heading's id; the comparison page shows several options. */
  headingId?: string;
  /** The option's name, on the comparison page. */
  label?: string;
  /** Where the service icons go; without it there are none. */
  icons?: "above" | "beside";
}

const { headingId = "usluge", label, icons } = Astro.props;
const labelId = `${headingId}-opcija`;
---

<Zone
  labelledby={label === undefined ? headingId : `${labelId} ${headingId}`}
  class="svc"
>
  {label !== undefined && (
    <p class="svc-label t-label" id={labelId}>
      {label}
    </p>
  )}
  <h2 id={headingId}>{SERVICES.title}</h2>
  <div
    class:list={["axis", icons !== undefined && `axis--icons-${icons}`]}
    data-axis
  >
    <span class="axis__line" data-axis-line aria-hidden="true"></span>
    {CHAPTERS.map((chapter) => (
      <div class="axis-stage">
        <span class="svc-rail axis-stage__rail" aria-hidden="true" />
        <div class="axis-stage__head">
          <h3 class="svc-title axis-stage__title">
            <span class="svc-bubble axis-stage__bubble" data-axis-mark>
              {chapter.number}
            </span>
            {chapter.title}
          </h3>
          <p class="svc-tagline axis-stage__tagline">{chapter.tagline}</p>
        </div>
        <ul class="svc-items axis-stage__items">
          {chapter.items.map((item) => (
            <ServiceItem
              title={item.title}
              body={item.body}
              href={item.href}
              icon={icons === undefined ? undefined : item.icon}
              class="axis-stage__item"
              data-axis-item
            />
          ))}
        </ul>
      </div>
    ))}
  </div>
  <script>
    import "./axis-line.ts";
  </script>
</Zone>

<style>
  .axis {
    position: relative;
  }

  /* Narrow screens: the line down the left, as in option 1. */
  .axis__line {
    left: calc((var(--bubble) - var(--rail)) / 2);
  }

  .axis-stage {
    --stage-top: var(--space-5);

    position: relative;
    padding: var(--stage-top) 0 var(--space-6)
      calc(var(--bubble) + var(--space-4));
  }

  .axis-stage__title {
    padding-top: max(0px, (var(--bubble) - 1lh) / 2);
  }

  .axis-stage__bubble {
    position: absolute;
    z-index: 1;
    top: var(--stage-top);
    left: 0;
  }

  .axis-stage__tagline {
    max-width: 30ch;
    margin-top: var(--space-2);
  }

  .axis-stage__rail {
    top: 0;
    bottom: 0;
    left: calc((var(--bubble) - var(--rail)) / 2);
  }

  .axis-stage:first-of-type .axis-stage__rail {
    top: calc(var(--stage-top) + var(--bubble) / 2);
  }

  .axis-stage:last-child .axis-stage__rail {
    bottom: auto;
    height: calc(var(--stage-top) + var(--bubble) / 2);
  }

  .axis-stage__items {
    margin-top: var(--space-4);
  }

  .axis-stage__item {
    padding: var(--space-4) 0 var(--space-5);
    border-top: var(--rule) solid var(--line);
  }

  /* The icons (review batch 13). A: above the title. */
  .axis--icons-above .axis-stage__item :global(.service__icon) {
    margin-bottom: var(--space-3);
  }

  /* B: beside the title and its line, in a column of its own. */
  .axis--icons-beside .axis-stage__item {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: var(--space-4);
    align-content: start;
    align-items: start;
  }

  .axis--icons-beside .axis-stage__item :global(.service__icon) {
    grid-row: 1 / span 2;
  }

  .axis--icons-beside
    .axis-stage__item
    :global(:is(.service__title, .service__body)) {
    grid-column: 2;
  }

  /* Wide screens: the line down the middle. */
  @media (min-width: 64rem) {
    .axis-stage {
      --stage-top: var(--space-5);

      padding: var(--stage-top) 0 var(--space-5);
    }

    .axis-stage:last-child {
      padding-bottom: 0;
    }

    /* The head covers the line where it passes behind the title. */
    .axis-stage__head {
      position: relative;
      z-index: 1;
      display: grid;
      justify-items: center;
      width: fit-content;
      max-width: 36rem;
      margin-inline: auto;
      padding-bottom: var(--space-3);
      background: var(--surface);
      text-align: center;
    }

    .axis-stage__title {
      display: grid;
      gap: var(--space-3);
      justify-items: center;
      padding-top: 0;
    }

    .axis-stage__bubble {
      position: static;
    }

    .axis-stage__tagline {
      margin-top: var(--space-3);
    }

    :is(.axis__line, .axis-stage__rail) {
      left: calc(50% - var(--rail) / 2);
    }

    .axis-stage__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-10);
      margin-top: var(--space-6);
    }

    /* The left column leans on the line. */
    .axis-stage__item:nth-child(odd) {
      text-align: right;
    }

    .axis-stage__item:nth-child(odd) :global(.service__body) {
      margin-left: auto;
    }

    .axis-stage__item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      justify-self: center;
      width: min(100%, 36rem);
      text-align: center;
    }

    .axis-stage__item:last-child:nth-child(odd) :global(.service__body) {
      margin-inline: auto;
    }

    /* The icons face the line: the left column's lean on it too, and the
       centred last service has its icon centred above it. */
    .axis--icons-above
      .axis-stage__item:nth-child(odd)
      :global(.service__icon) {
      margin-left: auto;
    }

    .axis--icons-beside .axis-stage__item:nth-child(odd) {
      grid-template-columns: minmax(0, 1fr) 2.5rem;
    }

    .axis--icons-beside
      .axis-stage__item:nth-child(odd)
      :global(.service__icon) {
      grid-column: 2;
    }

    .axis--icons-beside
      .axis-stage__item:nth-child(odd)
      :global(:is(.service__title, .service__body)) {
      grid-column: 1;
    }

    .axis--icons-beside .axis-stage__item:last-child:nth-child(odd) {
      display: block;
    }

    .axis:is(.axis--icons-above, .axis--icons-beside)
      .axis-stage__item:last-child:nth-child(odd)
      :global(.service__icon) {
      margin: 0 auto var(--space-3);
    }
  }
</style>
