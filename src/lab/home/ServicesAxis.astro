---
/**
 * Zone B, "Što radimo", option 3 "Središnja os" (the client's review,
 * batch 3), the client's choice in batch 4, with one short line per service
 * (chapters.ts). On wide screens the process line runs down the middle of the
 * sheet: each stage's bubble sits on it with the title and tagline centred
 * below, and its services stand left and right of the line, the left ones
 * aligned to it. The stage head covers the line where it passes behind the
 * title. An odd last service is centred under its stage. On narrow screens
 * the line runs down the left, as in option 1.
 *
 * The process line joins the bubbles 01 → 02 → 03. It follows the scroll
 * row by row, and each service's icon draws as the line reaches it, once
 * and only forwards (review batch 14; axis-line.ts). Without JavaScript or
 * with reduced motion the stages' rails draw it complete.
 *
 * With `icons` each service shows its icon on the side facing the line
 * (review batch 13, /lab/ikone): "above" the title, or "beside" the title
 * and its line, mirrored in the left column (the client's choice, batch 14,
 * ADR 0022). The centred last service has its icon centred above it.
 *
 * `layout` places the stages on wide screens; the options of review #79
 * (/lab/sto-radimo-2), each with 48 px icons, the native size of their grid:
 * - "centre": the central axis above (Home's).
 * - "left": the line down the left, as on phones; the services in two
 *   columns, and from 80rem each stage's head beside its services.
 * - "alternate": the line down the middle; from 64rem each stage's head
 *   beside its bubble and its services on the other side, the sides
 *   alternating stage by stage.
 * - "columns": from 80rem the three stages side by side, the line across
 *   through their bubbles (axis-row.ts); narrower, as "left".
 * And three more with the central axis (review #90), with larger type:
 * - "frames": each service in a thin frame, like a cell of a drawing.
 * - "branches": the services set apart from the line, and a branch of the
 *   line grows out to each one as the line reaches it, ending in a grip; the
 *   line runs on through the last stage's services.
 * - "framed": the frames and the branches together.
 * Phones show the line down the left in every layout.
 */
import "./services.css";

import Zone from "../../components/ui/Zone.astro";
import { SERVICES } from "../copy.ts";
import { CHAPTERS } from "./chapters.ts";
import ServiceItem from "./ServiceItem.astro";

interface Props {
  /** The heading's id; the comparison page shows several options. */
  headingId?: string;
  /** The option's name, on the comparison page. */
  label?: string;
  /** Where the service icons go; without it there are none. */
  icons?: "above" | "beside";
  /** How the stages are placed on wide screens. */
  layout?:
    | "centre"
    | "left"
    | "alternate"
    | "columns"
    | "frames"
    | "branches"
    | "framed";
}

const { headingId = "usluge", label, icons, layout = "centre" } = Astro.props;
const labelId = `${headingId}-opcija`;
/** The layouts with the line down the middle. */
const central = ["centre", "frames", "branches", "framed"].includes(layout);
/** The layouts whose services hang on branches of the line. */
const branches = layout === "branches" || layout === "framed";
---

<Zone
  labelledby={label === undefined ? headingId : `${labelId} ${headingId}`}
  class="svc"
>
  {label !== undefined && (
    <p class="svc-label t-label" id={labelId}>
      {label}
    </p>
  )}
  <h2 id={headingId}>{SERVICES.title}</h2>
  <div
    class:list={[
      "axis",
      `axis--${layout}`,
      central && "axis--central",
      icons !== undefined && `axis--icons-${icons}`,
    ]}
    data-axis
    data-axis-row={layout === "columns" ? "" : undefined}
    data-axis-branches={branches ? "" : undefined}
  >
    <span class="axis__line" data-axis-line aria-hidden="true"></span>
    {layout === "columns" && (
      <span class="axis__row" data-axis-row-line aria-hidden="true" />
    )}
    {CHAPTERS.map((chapter) => (
      <div class="axis-stage" data-axis-stage>
        <span class="svc-rail axis-stage__rail" aria-hidden="true" />
        <div class="axis-stage__head">
          <h3 class="svc-title axis-stage__title">
            <span class="svc-bubble axis-stage__bubble" data-axis-mark>
              {chapter.number}
            </span>
            {chapter.title}
          </h3>
          <p class="svc-tagline axis-stage__tagline">{chapter.tagline}</p>
        </div>
        <ul class="svc-items axis-stage__items">
          {chapter.items.map((item) => (
            <ServiceItem
              title={item.title}
              body={item.body}
              href={item.href}
              icon={icons === undefined ? undefined : item.icon}
              class="axis-stage__item"
              branch={branches}
              data-axis-item
            />
          ))}
        </ul>
      </div>
    ))}
  </div>
  <script>
    import "./axis-line.ts";
  </script>
</Zone>

<style>
  .axis {
    --icon: 2.5rem;
    --axis-gap: var(--space-7);
    --item-pad: var(--space-4);

    position: relative;
  }

  /* The options of review #79, on wide screens: the icons at their grid's
     own size, with the line at 1.5 px. Phones keep 40 px, so the text keeps
     its width there. */
  @media (min-width: 64rem) {
    .axis:not(.axis--centre) {
      --icon: 3rem;
    }

    .axis:not(.axis--centre) .axis-stage__item :global(.service-icon) {
      width: var(--icon);
      height: var(--icon);
      stroke-width: 1.5;
    }
  }

  /* Narrow screens: the line down the left, as in option 1. */
  .axis__line {
    left: calc((var(--bubble) - var(--rail)) / 2);
  }

  .axis__row {
    display: none;
  }

  .axis-stage {
    --stage-top: var(--space-5);

    position: relative;
    padding: var(--stage-top) 0 var(--space-6)
      calc(var(--bubble) + var(--space-4));
  }

  .axis-stage__title {
    padding-top: max(0px, (var(--bubble) - 1lh) / 2);
  }

  .axis-stage__bubble {
    position: absolute;
    z-index: 1;
    top: var(--stage-top);
    left: 0;
  }

  .axis-stage__tagline {
    max-width: 30ch;
    margin-top: var(--space-2);
  }

  .axis-stage__rail {
    top: 0;
    bottom: 0;
    left: calc((var(--bubble) - var(--rail)) / 2);
  }

  .axis-stage:first-of-type .axis-stage__rail {
    top: calc(var(--stage-top) + var(--bubble) / 2);
  }

  .axis-stage:last-child .axis-stage__rail {
    bottom: auto;
    height: calc(var(--stage-top) + var(--bubble) / 2);
  }

  .axis-stage__items {
    margin-top: var(--space-4);
  }

  .axis-stage__item {
    padding: var(--item-pad) 0 var(--space-5);
    border-top: var(--rule) solid var(--line);
  }

  /* A branch shows only where the line runs down the middle. */
  .axis-stage__item :global(.service__branch) {
    display: none;
  }

  /* The icons (review batch 13). A: above the title. */
  .axis--icons-above .axis-stage__item :global(.service__icon) {
    margin-bottom: var(--space-3);
  }

  /* B: beside the title and its line, in a column of its own. */
  .axis--icons-beside .axis-stage__item {
    display: grid;
    grid-template-columns: var(--icon) minmax(0, 1fr);
    column-gap: var(--space-4);
    align-content: start;
    align-items: start;
  }

  .axis--icons-beside .axis-stage__item :global(.service__icon) {
    grid-row: 1 / span 2;
  }

  .axis--icons-beside
    .axis-stage__item
    :global(:is(.service__title, .service__body)) {
    grid-column: 2;
  }

  @media (min-width: 64rem) {
    /* "centre" and the other central layouts: the line down the middle. */
    .axis--central .axis-stage {
      --stage-top: var(--space-5);

      padding: var(--stage-top) 0 var(--space-5);
    }

    .axis--central .axis-stage:last-child {
      padding-bottom: 0;
    }

    /* The head covers the line where it passes behind the title. */
    .axis--central .axis-stage__head {
      position: relative;
      z-index: 1;
      display: grid;
      justify-items: center;
      width: fit-content;
      max-width: 36rem;
      margin-inline: auto;
      padding-bottom: var(--space-3);
      background: var(--surface);
      text-align: center;
    }

    .axis--central .axis-stage__title {
      display: grid;
      gap: var(--space-3);
      justify-items: center;
      padding-top: 0;
    }

    .axis--central .axis-stage__bubble {
      position: static;
    }

    .axis--central .axis-stage__tagline {
      margin-top: var(--space-3);
    }

    .axis--central :is(.axis__line, .axis-stage__rail) {
      left: calc(50% - var(--rail) / 2);
    }

    .axis--central .axis-stage__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-10);
      margin-top: var(--space-6);
    }

    /* The left column leans on the line. */
    .axis--central .axis-stage__item:nth-child(odd) {
      text-align: right;
    }

    .axis--central .axis-stage__item:nth-child(odd) :global(.service__body) {
      margin-left: auto;
    }

    .axis--central .axis-stage__item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      justify-self: center;
      width: min(100%, 36rem);
      text-align: center;
    }

    .axis--central
      .axis-stage__item:last-child:nth-child(odd)
      :global(.service__body) {
      margin-inline: auto;
    }

    /* The icons face the line: the left column's lean on it too, and the
       centred last service has its icon centred above it. */
    .axis--central.axis--icons-above
      .axis-stage__item:nth-child(odd)
      :global(.service__icon) {
      margin-left: auto;
    }

    .axis--central.axis--icons-beside .axis-stage__item:nth-child(odd) {
      grid-template-columns: minmax(0, 1fr) var(--icon);
    }

    .axis--central.axis--icons-beside
      .axis-stage__item:nth-child(odd)
      :global(.service__icon) {
      grid-column: 2;
    }

    .axis--central.axis--icons-beside
      .axis-stage__item:nth-child(odd)
      :global(:is(.service__title, .service__body)) {
      grid-column: 1;
    }

    .axis--central.axis--icons-beside
      .axis-stage__item:last-child:nth-child(odd) {
      display: block;
    }

    .axis--central:is(.axis--icons-above, .axis--icons-beside)
      .axis-stage__item:last-child:nth-child(odd)
      :global(.service__icon) {
      margin: 0 auto var(--space-3);
    }

    /* "frames", "branches" and "framed" (review #90): larger type. */
    .axis:is(.axis--frames, .axis--branches, .axis--framed) {
      --step-title: clamp(1.25rem, 1.1rem + 0.45vw, 1.625rem);
      --step-service: var(--step-lead);
    }

    /* "frames" and "framed": each service in a thin frame, like a cell of
       a drawing; the cells of a row share their height. */
    .axis:is(.axis--frames, .axis--framed) .axis-stage__items {
      row-gap: var(--space-5);
    }

    .axis:is(.axis--frames, .axis--framed) .axis-stage__item {
      --item-pad: var(--space-5);

      padding: var(--item-pad) var(--space-6) var(--space-6);
      border: var(--rule) solid var(--line);
    }

    /* The centred last cell is as wide as the others. */
    .axis--frames .axis-stage__item:last-child:nth-child(odd) {
      width: calc((100% - var(--space-10)) / 2);
    }

    /* "branches" and "framed": the services stand a branch's length from
       the line, and the line runs on through the last stage's services. */
    .axis:is(.axis--branches, .axis--framed) {
      --branch: clamp(4rem, 9vw, 11rem);
    }

    .axis:is(.axis--branches, .axis--framed) .axis-stage__items {
      column-gap: calc(var(--branch) * 2);
    }

    .axis:is(.axis--branches, .axis--framed)
      .axis-stage:last-child
      .axis-stage__rail {
      bottom: 0;
      height: auto;
    }

    /* Every service hangs on a branch, the last one of a stage too. */
    .axis:is(.axis--branches, .axis--framed)
      .axis-stage__item:last-child:nth-child(odd) {
      grid-column: auto;
      justify-self: stretch;
      width: auto;
      text-align: right;
    }

    .axis:is(.axis--branches, .axis--framed)
      .axis-stage__item:last-child:nth-child(odd)
      :global(.service__body) {
      margin-right: 0;
      margin-left: auto;
    }

    .axis:is(.axis--branches, .axis--framed).axis--icons-beside
      .axis-stage__item:last-child:nth-child(odd) {
      display: grid;
    }

    .axis:is(.axis--branches, .axis--framed).axis--icons-beside
      .axis-stage__item:last-child:nth-child(odd)
      :global(.service__icon) {
      margin: 0;
    }

    /* Room between an unframed service and its branch's grip. */
    .axis--branches .axis-stage__item:nth-child(odd) {
      padding-right: var(--space-4);
    }

    .axis--branches .axis-stage__item:nth-child(even) {
      padding-left: var(--space-4);
    }

    /* The branch: from the line to the service, at its icon's middle. */
    .axis:is(.axis--branches, .axis--framed)
      .axis-stage__item
      :global(.service__branch) {
      position: absolute;
      top: calc(var(--item-pad) + var(--icon) / 2 - var(--rail) / 2);
      display: block;
      width: var(--branch);
      height: var(--rail);
      background: var(--accent);
    }

    .axis:is(.axis--branches, .axis--framed)
      .axis-stage__item:nth-child(odd)
      :global(.service__branch) {
      left: calc(100% + var(--rule));
      transform-origin: 100% 50%;
    }

    .axis:is(.axis--branches, .axis--framed)
      .axis-stage__item:nth-child(even)
      :global(.service__branch) {
      right: calc(100% + var(--rule));
      transform-origin: 0 50%;
    }

    /* The grip, where the branch meets the service. */
    .axis:is(.axis--branches, .axis--framed)
      .axis-stage__item
      :global(.service__branch)::after {
      position: absolute;
      top: 50%;
      width: var(--grip-size);
      height: var(--grip-size);
      border: var(--grip-stroke) solid var(--accent);
      background: var(--grip-fill);
      content: "";
    }

    .axis:is(.axis--branches, .axis--framed)
      .axis-stage__item:nth-child(odd)
      :global(.service__branch)::after {
      left: 0;
      translate: -50% -50%;
    }

    .axis:is(.axis--branches, .axis--framed)
      .axis-stage__item:nth-child(even)
      :global(.service__branch)::after {
      right: 0;
      translate: 50% -50%;
    }

    /* "left" (and "columns" below 80rem): the line stays on the left, the
       services take two columns. */
    .axis:is(.axis--left, .axis--columns) .axis-stage__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--axis-gap);
    }

    /* "alternate": the line down the middle, each head beside its bubble,
       the services on the other side. */
    .axis--alternate :is(.axis__line, .axis-stage__rail) {
      left: calc(50% - var(--rail) / 2);
    }

    .axis--alternate .axis-stage {
      --stage-top: var(--space-6);

      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: calc(var(--bubble) + var(--space-5) * 2);
      align-items: start;
      padding: var(--stage-top) 0 var(--space-6);
    }

    .axis--alternate .axis-stage:last-child {
      padding-bottom: 0;
    }

    .axis--alternate .axis-stage__bubble {
      left: calc(50% - var(--bubble) / 2);
    }

    .axis--alternate .axis-stage__items {
      margin-top: 0;
    }

    .axis--alternate .axis-stage:nth-of-type(odd) .axis-stage__head {
      grid-column: 1;
      text-align: right;
    }

    .axis--alternate .axis-stage:nth-of-type(odd) .axis-stage__tagline {
      margin-left: auto;
    }

    .axis--alternate .axis-stage:nth-of-type(odd) .axis-stage__items {
      grid-column: 2;
    }

    .axis--alternate .axis-stage:nth-of-type(even) .axis-stage__head {
      grid-column: 2;
    }

    .axis--alternate .axis-stage:nth-of-type(even) .axis-stage__items {
      grid-row: 1;
      grid-column: 1;
    }
  }

  @media (min-width: 80rem) {
    /* "left": each stage's head beside its services. */
    .axis--left .axis-stage {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: var(--axis-gap);
      align-items: start;
    }

    .axis--left .axis-stage__items {
      margin-top: 0;
    }

    /* "alternate": two services a row on each side, the icon above. */
    .axis--alternate .axis-stage__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--axis-gap);
    }

    .axis--alternate.axis--icons-beside .axis-stage__item {
      display: block;
    }

    .axis--alternate.axis--icons-beside
      .axis-stage__item
      :global(.service__icon) {
      margin-bottom: var(--space-3);
    }

    /* "columns": the stages side by side, the line across their bubbles. */
    .axis--columns {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--axis-gap);
      align-items: start;
    }

    .axis.axis--columns :is(.axis__line, .axis-stage__rail) {
      display: none;
    }

    .axis--columns .axis__row {
      position: absolute;
      top: calc((var(--bubble) - var(--rail)) / 2);
      right: calc((100% - var(--axis-gap) * 2) / 3 - var(--bubble) / 2);
      left: calc(var(--bubble) / 2);
      display: block;
      height: var(--rail);
      background: var(--accent);
      transform-origin: 0 50%;
      pointer-events: none;
    }

    .axis--columns .axis-stage {
      padding: 0;
    }

    .axis--columns .axis-stage__title {
      display: grid;
      gap: var(--space-4);
      justify-items: start;
      padding-top: 0;
    }

    .axis--columns .axis-stage__bubble {
      position: relative;
      top: auto;
    }

    .axis.axis--columns .axis-stage__items {
      grid-template-columns: minmax(0, 1fr);
      margin-top: var(--space-5);
    }
  }
</style>
