---
/**
 * "Što radimo", option 13 "Krug" (review #101): the three stages as a
 * cycle. The work doesn't end at the launch ("Ne nestajemo nakon objave"),
 * so on wide screens the stages stand on a circle, drawn as on a drawing
 * with its centre lines: the wordmark's arc, closed. The bubbles and a grip
 * for each service are spaced evenly round it, like the holes of a bolt
 * circle, so each stage's arc is as long as it has services; each stage's
 * name is written beside its bubble, inside the circle.
 *
 * The circle stays beside the text while you read (sticky; the page
 * scrolls as always) and its arc follows the reading: it runs clockwise
 * from 01 as the text passes the circle's centre, each service's grip
 * snapping in as the arc reaches it, and after the last service it closes
 * on 01 with an arrow (cycle.ts). The services' icons draw on their own,
 * when they reach 85 % of the screen's height, as in the other options.
 *
 * On narrow screens there is no circle: the stages one after another, each
 * with its bubble, as in the other options. Without JavaScript or with
 * reduced motion the circle and the icons are complete.
 */
import "./services.css";

import Zone from "../../components/ui/Zone.astro";
import { SERVICES } from "../copy.ts";
import { CHAPTERS } from "./chapters.ts";
import ServiceItem from "./ServiceItem.astro";

interface Props {
  /** The heading's id; the comparison page shows several options. */
  headingId?: string;
  /** The option's name, on the comparison page. */
  label?: string;
}

const { headingId = "usluge", label } = Astro.props;
const labelId = `${headingId}-opcija`;

/** The drawing, at 1:1 on wide screens: a 440 px square, the circle in it. */
const SIZE = 440;
const CENTRE = SIZE / 2;
const RADIUS = 170;
const BUBBLE = 22;
/** The centre lines run this far past the circle. */
const OVERRUN = 16;
/** A stage's name stands this far inside the circle from its bubble. */
const NAME_INSET = 50;

/** A point `radius` from the centre, `turn` of the way round from the top. */
function at(turn: number, radius = RADIUS): { x: number; y: number } {
  const angle = (turn * 360 - 90) * (Math.PI / 180);
  return {
    x: Math.round((CENTRE + radius * Math.cos(angle)) * 100) / 100,
    y: Math.round((CENTRE + radius * Math.sin(angle)) * 100) / 100,
  };
}

/** Every bubble and service gets one of the evenly spaced places. */
const PLACES = CHAPTERS.reduce(
  (sum, chapter) => sum + 1 + chapter.items.length,
  0,
);
const stages = CHAPTERS.map((chapter, stage) => {
  const first = CHAPTERS.slice(0, stage).reduce(
    (sum, before) => sum + 1 + before.items.length,
    0,
  );
  return {
    chapter,
    turn: first / PLACES,
    ticks: chapter.items.map((_, index) => (first + 1 + index) / PLACES),
  };
});

/** How each name sits by its bubble: centred under 01, before 02, after 03. */
function anchorOf(turn: number): "start" | "middle" | "end" {
  if (turn === 0) return "middle";
  return turn < 0.5 ? "end" : "start";
}

/** The arrow closes the circle at bubble 01's edge. */
const ARROW_TURN = 1 - (BUBBLE + 2) / (2 * Math.PI * RADIUS);
const arrow = at(ARROW_TURN);
const top = at(0);
const bottom = at(0.5);
const arc = [
  `M ${String(top.x)} ${String(top.y)}`,
  `A ${String(RADIUS)} ${String(RADIUS)} 0 1 1 ${String(bottom.x)} ${String(bottom.y)}`,
  `A ${String(RADIUS)} ${String(RADIUS)} 0 1 1 ${String(top.x)} ${String(top.y)}`,
].join(" ");
---

<Zone
  labelledby={label === undefined ? headingId : `${labelId} ${headingId}`}
  class="svc"
>
  {label !== undefined && (
    <p class="svc-label t-label" id={labelId}>
      {label}
    </p>
  )}
  <h2 id={headingId}>{SERVICES.title}</h2>
  <div class="cycle" data-cycle>
    <div class="cycle__figure">
      <svg
        class="cycle__drawing"
        viewBox={`0 0 ${String(SIZE)} ${String(SIZE)}`}
        aria-hidden="true"
        focusable="false"
      >
        <g class="cycle__centre-lines">
          <line
            x1={CENTRE - RADIUS - OVERRUN}
            y1={CENTRE}
            x2={CENTRE + RADIUS + OVERRUN}
            y2={CENTRE}
          />
          <line
            x1={CENTRE}
            y1={CENTRE - RADIUS - OVERRUN}
            x2={CENTRE}
            y2={CENTRE + RADIUS + OVERRUN}
          />
        </g>
        <circle class="cycle__circle" cx={CENTRE} cy={CENTRE} r={RADIUS} />
        <path class="cycle__arc" d={arc} pathLength="1" data-cycle-arc />
        <g
          class="cycle__arrow"
          transform={`translate(${String(arrow.x)} ${String(arrow.y)}) rotate(${String(ARROW_TURN * 360)})`}
          data-cycle-arrow
        >
          <polygon points="0,0 -12,-5 -12,5" />
        </g>
        {stages.map(({ ticks }) =>
          ticks.map((turn) => {
            const { x, y } = at(turn);
            return (
              <rect
                class="cycle__tick"
                x={x - 4.5}
                y={y - 4.5}
                width="9"
                height="9"
                data-cycle-tick={turn}
              />
            );
          }),
        )}
        {stages.map(({ chapter, turn }) => {
          const { x, y } = at(turn);
          const name = at(turn, RADIUS - NAME_INSET);
          return (
            <g class="cycle__stage">
              <circle class="cycle__bubble" cx={x} cy={y} r={BUBBLE} />
              <text class="cycle__number" x={x} y={y}>
                {chapter.number}
              </text>
              <text
                class="cycle__name"
                x={name.x}
                y={name.y}
                text-anchor={anchorOf(turn)}
              >
                {chapter.title}
              </text>
            </g>
          );
        })}
      </svg>
    </div>
    <div class="cycle__stages">
      {stages.map(({ chapter, ticks }) => (
        <div class="cycle-stage">
          <h3 class="svc-title cycle-stage__title" data-cycle-head>
            <span class="svc-bubble cycle-stage__bubble">{chapter.number}</span>
            {chapter.title}
          </h3>
          <p class="svc-tagline cycle-stage__tagline">{chapter.tagline}</p>
          <ul class="svc-items cycle-stage__items">
            {chapter.items.map((item, index) => (
              <ServiceItem
                title={item.title}
                body={item.body}
                href={item.href}
                icon={item.icon}
                class="cycle-item"
                data-axis-item
                data-cycle-item={ticks[index]}
              />
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <script>
    import "./cycle.ts";
  </script>
</Zone>

<style>
  .cycle {
    --icon: 2.5rem;
  }

  /* Narrow screens: no circle; the stages one after another. */
  .cycle__figure {
    display: none;
  }

  .cycle-stage + .cycle-stage {
    margin-top: var(--space-7);
  }

  .cycle-stage__title {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .cycle-stage__tagline {
    max-width: 34ch;
    margin-top: var(--space-2);
    padding-left: calc(var(--bubble) + var(--space-4));
    text-wrap: balance;
  }

  .cycle-stage__items {
    margin-top: var(--space-4);
  }

  /* The service's title lines up with its stage's title. */
  .cycle-item {
    display: grid;
    grid-template-columns: var(--icon) minmax(0, 1fr);
    column-gap: calc(var(--bubble) + var(--space-4) - var(--icon));
    align-items: start;
    padding: var(--space-4) 0 var(--space-5);
    border-top: var(--rule) solid var(--line);
  }

  .cycle-item :global(.service__icon) {
    grid-row: 1 / span 2;
  }

  .cycle-item :global(:is(.service__title, .service__body)) {
    grid-column: 2;
  }

  /* Wide screens: the circle stays beside the text while you read, drawn
     at 1:1, so its bubbles, grips and lines are the system's own. */
  @media (min-width: 64rem) {
    .cycle {
      --icon: 3rem;
      --figure: 27.5rem;
      --step-title: clamp(1.25rem, 1.1rem + 0.45vw, 1.625rem);
      --step-service: var(--step-lead);

      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--space-9);
      align-items: start;
    }

    .cycle__figure {
      position: sticky;
      top: max(var(--space-6), (100vh - var(--figure)) / 2);
      display: block;
      width: min(100%, var(--figure));
      justify-self: center;
    }

    .cycle__drawing {
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
    }

    .cycle__centre-lines {
      stroke: var(--line-strong);
      stroke-dasharray: 14 4 2 4;
      stroke-width: var(--rule);
      opacity: 0.35;
    }

    .cycle__circle {
      fill: none;
      stroke: var(--line);
      stroke-width: var(--rail);
    }

    .cycle__arc {
      fill: none;
      stroke: var(--accent);
      stroke-dasharray: 1 1;
      stroke-dashoffset: 0;
      stroke-width: var(--rail);
    }

    .cycle__arrow {
      fill: var(--accent);
    }

    .cycle__tick {
      fill: var(--grip-fill);
      stroke: var(--accent);
      stroke-width: var(--grip-stroke);
      transform-box: fill-box;
      transform-origin: center;
    }

    .cycle__bubble {
      fill: var(--surface);
      stroke: var(--ink);
      stroke-width: 1.5;
    }

    .cycle__number {
      fill: var(--ink);
      font-size: 0.875rem;
      font-stretch: var(--width-label);
      font-weight: var(--weight-strong);
      font-variant-numeric: tabular-nums;
      dominant-baseline: central;
      text-anchor: middle;
    }

    /* A name stands clear of the centre lines it crosses. */
    .cycle__name {
      fill: var(--ink);
      font-size: var(--step-small);
      font-stretch: var(--width-heading);
      font-weight: var(--weight-strong);
      dominant-baseline: central;
      paint-order: stroke;
      stroke: var(--surface);
      stroke-width: 8px;
      stroke-linejoin: round;
    }

    /* The circle numbers the stages, and the list names them. */
    .cycle-stage__bubble {
      display: none;
    }

    .cycle-stage__tagline {
      padding-left: 0;
    }

    .cycle-item {
      column-gap: var(--space-4);
    }

    .cycle-item :global(.service-icon) {
      width: var(--icon);
      height: var(--icon);
      stroke-width: 1.5;
    }

    .cycle-item :global(.service__body) {
      max-width: none;
    }
  }
</style>
