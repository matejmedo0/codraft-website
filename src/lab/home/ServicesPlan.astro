---
/**
 * "Što radimo", option 12 "Terminski plan" (review #101): the three stages
 * as a schedule, the way a building's works are planned. The text stays in
 * one column on the left: each stage's title and tagline, then its
 * services. On wide screens the schedule runs beside them:
 * - each stage starts at a grid line, with its bubble at the line's top end,
 *   as on a drawing; the lines step down and to the right, stage by stage;
 * - each service has a bar in its stage's column, a drafting line ending in
 *   a grip, as in the wordmark;
 * - "Fiksni opseg, rok i cijena" is not a bar but a milestone, a grip
 *   turned on its corner, where stage 02 starts: they are known before the
 *   work does;
 * - stage 03's bars run on to the edge and end in an arrow, since the care
 *   doesn't end.
 * Planning is the narrowest column and building the widest, without dates:
 * the schedule shows the order, not a promise of weeks.
 *
 * On narrow screens each service has a small schedule under its line: the
 * three stages on one rule, its own bar in place.
 *
 * Motion (plan-schedule.ts): a service starts when it reaches 85 % of the
 * screen's height; its bar draws from its grid line, the grip or arrow
 * snaps in, then the icon draws. Without JavaScript or with reduced motion
 * everything is complete.
 */
import "./services.css";

import Zone from "../../components/ui/Zone.astro";
import { SERVICES } from "../copy.ts";
import { CHAPTERS } from "./chapters.ts";
import ServiceItem from "./ServiceItem.astro";

interface Props {
  /** The heading's id; the comparison page shows several options. */
  headingId?: string;
  /** The option's name, on the comparison page. */
  label?: string;
}

const { headingId = "usluge", label } = Astro.props;
const labelId = `${headingId}-opcija`;

/** What a service shows in the schedule: a bar, a milestone, or a bar that runs on. */
type Mark = "bar" | "milestone" | "ongoing";

function markOf(stage: number, index: number): Mark {
  if (stage === 0 && index === 1) return "milestone";
  return stage === CHAPTERS.length - 1 ? "ongoing" : "bar";
}
---

<Zone
  labelledby={label === undefined ? headingId : `${labelId} ${headingId}`}
  class="svc"
>
  {label !== undefined && (
    <p class="svc-label t-label" id={labelId}>
      {label}
    </p>
  )}
  <h2 id={headingId}>{SERVICES.title}</h2>
  <div class="plan" data-plan>
    {CHAPTERS.map((chapter, stage) => (
      <div class:list={["plan-stage", `plan-stage--${String(stage + 1)}`]}>
        <div class="plan-stage__head">
          <h3 class="svc-title plan-stage__title">
            <span class="svc-bubble plan-stage__bubble">{chapter.number}</span>
            {chapter.title}
          </h3>
          <p class="svc-tagline plan-stage__tagline">{chapter.tagline}</p>
          <span class="plan-track plan-track--head" aria-hidden="true">
            <span />
            <span />
            <span />
          </span>
        </div>
        <ul class="svc-items plan-stage__items">
          {chapter.items.map((item, index) => (
            <ServiceItem
              title={item.title}
              body={item.body}
              href={item.href}
              icon={item.icon}
              class="plan-item"
              data-axis-item
              data-plan-row
            >
              <span class="plan-track" aria-hidden="true">
                <span />
                <span />
                <span />
                <span class={`plan-mark plan-mark--${markOf(stage, index)}`} />
              </span>
            </ServiceItem>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <script>
    import "./plan-schedule.ts";
  </script>
</Zone>

<style>
  .plan {
    --icon: 2.5rem;
    /* Where each stage starts along the schedule, and how long it is. */
    --cols: 24fr 38fr 38fr;
    --track-h: 0.5625rem;
    --row-pad: var(--space-4);
  }

  /* Narrow screens: the stages one after another, as in the other options;
     each service's small schedule under its line. */
  .plan-stage {
    padding-top: var(--space-7);
  }

  .plan-stage:first-child {
    padding-top: 0;
  }

  .plan-stage__title {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .plan-stage__tagline {
    max-width: 34ch;
    margin-top: var(--space-2);
    padding-left: calc(var(--bubble) + var(--space-4));
  }

  .plan-stage__items {
    margin-top: var(--space-4);
  }

  .plan-item {
    display: grid;
    grid-template-columns: var(--icon) minmax(0, 1fr);
    grid-template-areas:
      "icon title"
      "icon body"
      ". track";
    column-gap: var(--space-4);
    align-items: start;
    padding: var(--row-pad) 0 var(--space-5);
    border-top: var(--rule) solid var(--line);
  }

  .plan-item :global(.service__icon) {
    grid-area: icon;
  }

  .plan-item :global(.service__title) {
    grid-area: title;
  }

  .plan-item :global(.service__body) {
    grid-area: body;
  }

  /* The schedule: three columns, a stage each; a stage's grid line is the
     left edge of its column. */
  .plan-track {
    position: relative;
    display: grid;
    grid-area: track;
    grid-template-columns: var(--cols);
    height: var(--track-h);
    margin-top: var(--space-3);
    background: linear-gradient(var(--line), var(--line)) 0 50% / 100%
      var(--rule) no-repeat;
  }

  .plan-track > span:not(.plan-mark) {
    border-left: var(--rule) solid var(--line-strong);
  }

  .plan-track--head {
    display: none;
  }

  /* The mark: a bar from the stage's grid line to a grip before the next,
     like the drafting line in the wordmark; stage 03's runs on to the edge
     and ends in an arrow. On wide screens the bar is as heavy as the
     wordmark's line. */
  .plan {
    --bar: var(--rail);
    --grip: 0.5625rem;
    --milestone: 0.75rem;
    --arrow-length: 0.5rem;
    --arrow-width: 0.5rem;
  }

  .plan-mark {
    position: absolute;
    top: calc(50% - var(--bar) / 2);
    height: var(--bar);
    background: var(--accent);
    transform-origin: 0 50%;
  }

  .plan-stage--1 .plan-mark {
    left: 0;
    width: calc(24% - var(--grip) - var(--space-2));
  }

  .plan-stage--2 .plan-mark {
    left: 24%;
    width: calc(38% - var(--grip) - var(--space-2));
  }

  .plan-stage--3 .plan-mark {
    left: 62%;
    right: var(--arrow-length);
  }

  .plan-mark--bar::after,
  .plan-mark--milestone::after {
    position: absolute;
    top: calc(50% - var(--grip) / 2);
    left: 100%;
    width: var(--grip);
    height: var(--grip);
    border: var(--grip-stroke) solid var(--accent);
    background: var(--grip-fill);
    content: "";
  }

  /* The milestone: no bar, a grip on its corner where stage 02 starts. */
  .plan-stage--1 .plan-mark--milestone {
    left: 24%;
    width: 0;
  }

  .plan-mark--milestone::after {
    top: calc(50% - var(--milestone) / 2);
    left: calc(var(--milestone) / -2);
    width: var(--milestone);
    height: var(--milestone);
    rotate: 45deg;
  }

  /* A drawing's filled arrow; the bar ends under its base. */
  .plan-mark--ongoing::after {
    position: absolute;
    top: calc(50% - var(--arrow-width) / 2);
    left: calc(100% - 1px);
    width: var(--arrow-length);
    height: var(--arrow-width);
    background: var(--accent);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    content: "";
  }

  @media (min-width: 64rem) {
    .plan {
      --icon: 3rem;
      --label: 50%;
      --head-top: var(--space-7);
      --chart-gap: var(--space-8);
      --step-title: clamp(1.25rem, 1.1rem + 0.45vw, 1.625rem);
      --step-service: var(--step-lead);
      --row-pad: var(--space-4);
      --bar: 0.375rem;
      --grip: 0.8125rem;
      --milestone: 1rem;
      --arrow-length: 1.125rem;
      --arrow-width: 1rem;
    }

    .plan-item :global(.service-icon) {
      width: var(--icon);
      height: var(--icon);
      stroke-width: 1.5;
    }

    .plan-item :global(.service__body) {
      max-width: none;
    }

    /* Each row: its text in the left column, its schedule beside it. The
       schedule fills the row's height, so its grid lines run on unbroken
       from row to row. */
    .plan-stage__head,
    .plan-item {
      position: relative;
      column-gap: var(--space-4);
    }

    .plan-stage__head {
      display: grid;
      grid-template-columns:
        minmax(0, var(--label))
        minmax(0, 1fr);
      grid-template-areas:
        "title track"
        "tagline track";
      padding: var(--head-top) 0 var(--space-5);
    }

    .plan-stage:first-child .plan-stage__head {
      padding-top: 0;
    }

    .plan-stage {
      padding-top: 0;
    }

    .plan-stage__title {
      grid-area: title;
    }

    .plan-stage__tagline {
      grid-area: tagline;
      padding-left: 0;
    }

    .plan-item {
      grid-template-columns:
        var(--icon) minmax(0, calc(var(--label) - var(--icon) - var(--space-4)))
        minmax(0, 1fr);
      grid-template-areas:
        "icon title track"
        "icon body track";
      padding-bottom: var(--row-pad);
      border-top: 0;
      background: linear-gradient(var(--line), var(--line)) 0 0 / 100%
        var(--rule) no-repeat;
    }

    .plan-stage__items {
      margin-top: 0;
    }

    /* The schedule beside the text, as tall as its row. */
    .plan-track {
      align-self: stretch;
      height: auto;
      margin: calc(var(--row-pad) * -1) 0 calc(var(--row-pad) * -1)
        calc(var(--chart-gap) - var(--space-4));
      background: none;
    }

    .plan-track--head {
      display: grid;
      margin-top: calc(var(--head-top) * -1);
      margin-bottom: calc(var(--space-5) * -1);
    }

    .plan-stage:first-child .plan-track--head {
      margin-top: 0;
    }

    .plan-track > span:not(.plan-mark) {
      border-left-color: var(--line);
    }

    /* A stage's grid line starts at its bubble: above it, the later
       columns are open. */
    .plan-stage--1 .plan-track > span:nth-child(n + 2):not(.plan-mark),
    .plan-stage--2 .plan-track > span:nth-child(n + 3):not(.plan-mark) {
      border-left-color: transparent;
    }

    .plan-track--head > span:nth-child(1),
    .plan-stage--2 .plan-track--head > span:nth-child(2),
    .plan-stage--3 .plan-track--head > span:nth-child(3) {
      border-left-color: transparent;
    }

    .plan-stage--1 .plan-track--head > span:nth-child(1),
    .plan-stage--2 .plan-track--head > span:nth-child(2),
    .plan-stage--3 .plan-track--head > span:nth-child(3) {
      background: linear-gradient(var(--line), var(--line)) 0 var(--bubble-y) /
        var(--rule) 100% no-repeat;
    }

    .plan-stage--2 .plan-track--head > span:nth-child(1),
    .plan-stage--3 .plan-track--head > span:nth-child(-n + 2) {
      border-left-color: var(--line);
    }

    /* The bubble sits on its stage's grid line, level with the title. */
    .plan-stage__head {
      --bubble-y: calc(var(--head-top) + var(--step-chapter) * 0.55);
    }

    .plan-stage:first-child .plan-stage__head {
      --bubble-y: calc(var(--step-chapter) * 0.55);
    }

    .plan-stage__bubble {
      position: absolute;
      z-index: 1;
      top: calc(var(--bubble-y) - var(--bubble) / 2);
      left: calc(
        var(--label) + var(--chart-gap) - var(--bubble) / 2 +
          (100% - var(--label) - var(--chart-gap)) * var(--at)
      );
      font-size: 0.875rem;
    }

    .plan-stage--1 {
      --at: 0;
    }

    .plan-stage--2 {
      --at: 0.24;
    }

    .plan-stage--3 {
      --at: 0.62;
    }

    /* The bar level with the service's title. */
    .plan-mark {
      top: calc(
        var(--row-pad) + var(--step-title) * var(--leading-title) / 2 -
          var(--bar) / 2
      );
    }
  }
</style>
