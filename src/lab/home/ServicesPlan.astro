---
/**
 * "Što radimo", option 12 "Terminski plan" (review #101): the three stages
 * as a schedule, the way a building's works are planned. The text stays in
 * one column on the left: each stage's title and tagline, then its
 * services. On wide screens the schedule runs beside them, from the middle
 * of the sheet:
 * - each stage starts at a grid line, with its bubble at the line's top end,
 *   as on a drawing; the lines step down and to the right, stage by stage;
 * - each stage's span is one bar from its bubble, the process line and grip
 *   of the system (`--rail`, `--grip-size`); stage 03's runs on to the edge
 *   and ends in an arrow, since the care doesn't end;
 * - each service has a grip on its stage's grid line: it belongs to that
 *   stage, without a claim of when or how long (the services are offers to
 *   choose from, not tasks that all run);
 * - "Fiksni opseg, rok i cijena" is a milestone, a grip turned on its
 *   corner, where stage 02 starts: they are known before the work does.
 * Planning is the narrowest column, without dates: the schedule shows the
 * order, not a promise of weeks.
 *
 * On narrow screens each stage has a small schedule under its tagline: the
 * three stages on one rule, its own span in place.
 *
 * Motion (plan-schedule.ts): a stage's bar draws from its bubble when its
 * head reaches 85 % of the screen's height, then its grip or arrow snaps in;
 * a service's grip snaps in when the service gets there, then its icon
 * draws. Without JavaScript or with reduced motion everything is complete.
 */
import "./services.css";

import Zone from "../../components/ui/Zone.astro";
import { SERVICES } from "../copy.ts";
import { CHAPTERS } from "./chapters.ts";
import ServiceItem from "./ServiceItem.astro";

interface Props {
  /** The heading's id; the comparison page shows several options. */
  headingId?: string;
  /** The option's name, on the comparison page. */
  label?: string;
}

const { headingId = "usluge", label } = Astro.props;
const labelId = `${headingId}-opcija`;

/** Stage 01's second item, the fixed scope, deadline and price. */
function isMilestone(stage: number, index: number): boolean {
  return stage === 0 && index === 1;
}
---

<Zone
  labelledby={label === undefined ? headingId : `${labelId} ${headingId}`}
  class="svc"
>
  {label !== undefined && (
    <p class="svc-label t-label" id={labelId}>
      {label}
    </p>
  )}
  <h2 id={headingId}>{SERVICES.title}</h2>
  <div class="plan" data-plan>
    {CHAPTERS.map((chapter, stage) => (
      <div class:list={["plan-stage", `plan-stage--${String(stage + 1)}`]}>
        <div class="plan-stage__head" data-plan-row="head">
          <h3 class="svc-title plan-stage__title">
            <span class="svc-bubble plan-stage__bubble">{chapter.number}</span>
            {chapter.title}
          </h3>
          <p class="svc-tagline plan-stage__tagline">{chapter.tagline}</p>
          <span class="plan-track plan-track--head" aria-hidden="true">
            <span />
            <span />
            <span />
            <span class="plan-mark plan-mark--stage" />
            {stage === 0 && (
              <span class="plan-mark plan-mark--milestone plan-mark--narrow" />
            )}
          </span>
        </div>
        <ul class="svc-items plan-stage__items">
          {chapter.items.map((item, index) => (
            <ServiceItem
              title={item.title}
              body={item.body}
              href={item.href}
              icon={item.icon}
              class="plan-item"
              data-axis-item
              data-plan-row="item"
            >
              <span class="plan-track plan-track--item" aria-hidden="true">
                <span />
                <span />
                <span />
                <span
                  class:list={[
                    "plan-mark",
                    isMilestone(stage, index)
                      ? "plan-mark--milestone"
                      : "plan-mark--item",
                  ]}
                />
              </span>
            </ServiceItem>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <script>
    import "./plan-schedule.ts";
  </script>
</Zone>

<style>
  .plan {
    --icon: 2.5rem;
    /* Each stage's column: where it starts along the schedule, and its share. */
    --cols: 24fr 38fr 38fr;
    --track-h: 0.5625rem;
    --arrow-length: 0.75rem;
    --arrow-width: 0.625rem;
    /* Where a stage's bar starts from its grid line. */
    --bar-from: 0px;
  }

  .plan-stage--1 {
    --at: 0;
    --span: 0.24;
  }

  .plan-stage--2 {
    --at: 0.24;
    --span: 0.38;
  }

  .plan-stage--3 {
    --at: 0.62;
    --span: 0.38;
  }

  /* Narrow screens: the stages one after another, as in the other options;
     each stage's small schedule under its tagline. */
  .plan-stage + .plan-stage {
    padding-top: var(--space-7);
  }

  .plan-stage__title {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .plan-stage__tagline {
    max-width: 34ch;
    margin-top: var(--space-2);
    text-wrap: balance;
  }

  .plan-stage__tagline,
  .plan-track--head {
    margin-left: calc(var(--bubble) + var(--space-4));
  }

  .plan-stage__items {
    margin-top: var(--space-4);
  }

  /* The service's title lines up with its stage's title. */
  .plan-item {
    display: grid;
    grid-template-columns: var(--icon) minmax(0, 1fr);
    column-gap: calc(var(--bubble) + var(--space-4) - var(--icon));
    align-content: start;
    align-items: start;
    padding: var(--space-4) 0 var(--space-5);
    border-top: var(--rule) solid var(--line);
  }

  .plan-item :global(.service__icon) {
    grid-row: 1 / span 2;
  }

  .plan-item :global(:is(.service__title, .service__body)) {
    grid-column: 2;
  }

  /* The schedule: three columns, a stage each; a stage's grid line is the
     left edge of its column. */
  .plan-track {
    position: relative;
    display: grid;
    grid-template-columns: var(--cols);
    height: var(--track-h);
    margin-top: var(--space-4);
    background: linear-gradient(var(--line), var(--line)) 0 50% / 100%
      var(--rule) no-repeat;
  }

  .plan-track > span:not(.plan-mark) {
    border-left: var(--rule) solid var(--line-strong);
  }

  .plan-track--item {
    display: none;
  }

  /* The marks: the process line and grips of the system. */
  .plan-mark {
    position: absolute;
    top: calc(50% - var(--rail) / 2);
    height: var(--rail);
  }

  .plan-mark--stage {
    left: calc(var(--at) * 100% + var(--bar-from));
    width: calc(
      var(--span) * 100% - var(--bar-from) - var(--grip-size) - var(--space-2)
    );
    background: var(--accent);
    transform-origin: 0 50%;
  }

  .plan-stage--3 .plan-mark--stage {
    right: var(--arrow-length);
    width: auto;
  }

  .plan-mark--stage::after,
  .plan-mark--item::after,
  .plan-mark--milestone::after {
    position: absolute;
    top: calc(50% - var(--grip-size) / 2);
    left: 100%;
    width: var(--grip-size);
    height: var(--grip-size);
    border: var(--grip-stroke) solid var(--accent);
    background: var(--grip-fill);
    content: "";
  }

  /* A drawing's filled arrow; the bar ends under its base. */
  .plan-stage--3 .plan-mark--stage::after {
    top: calc(50% - var(--arrow-width) / 2);
    left: calc(100% - 1px);
    width: var(--arrow-length);
    height: var(--arrow-width);
    border: 0;
    background: var(--accent);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  /* On narrow screens stage 01's bar ends in the milestone, not a grip. */
  .plan-stage--1 .plan-track--head .plan-mark--stage {
    width: calc(var(--span) * 100% - var(--grip-size) * 0.7071);
  }

  .plan-stage--1 .plan-track--head .plan-mark--stage::after {
    display: none;
  }

  /* A service's grip, on its stage's grid line. */
  .plan-mark--item {
    left: calc(var(--at) * 100%);
    width: 0;
  }

  .plan-mark--item::after {
    left: calc(var(--grip-size) / -2);
  }

  /* The milestone: a grip on its corner where stage 02 starts. */
  .plan-mark--milestone {
    left: 24%;
    width: 0;
  }

  .plan-mark--milestone::after {
    left: calc(var(--grip-size) / -2);
    rotate: 45deg;
  }

  @media (min-width: 64rem) {
    .plan {
      --icon: 3rem;
      /* The schedule starts in the middle of the sheet, on its grid. */
      --chart-x: 50%;
      --text-end: calc(100% - var(--chart-x) + var(--space-6));
      --head-top: var(--space-7);
      --row-pad: var(--space-4);
      --bar-from: calc(var(--bubble) / 2 + var(--space-2));
      --step-title: clamp(1.25rem, 1.1rem + 0.45vw, 1.625rem);
      --step-service: var(--step-lead);
    }

    .plan-item :global(.service-icon) {
      width: var(--icon);
      height: var(--icon);
      stroke-width: 1.5;
    }

    .plan-item :global(.service__body) {
      max-width: none;
    }

    /* Each row: its text left of the middle, its schedule beside it, as
       tall as the row, so the grid lines run on unbroken. */
    .plan-stage + .plan-stage {
      padding-top: 0;
    }

    .plan-stage__head {
      position: relative;
      padding: var(--head-top) var(--text-end) var(--space-5) 0;
    }

    .plan-stage:first-child .plan-stage__head {
      padding-top: 0;
    }

    .plan-stage__tagline {
      margin-left: 0;
    }

    /* The stage's period: its column across its services, hatched like a
       section at low strength, as the ground the client liked (#98); the
       last runs out at the edge. The services happen within it. */
    .plan-stage__items {
      position: relative;
      z-index: 0;
      margin-top: 0;
    }

    .plan-stage__items::before {
      position: absolute;
      z-index: -1;
      top: 0;
      bottom: 0;
      left: calc(var(--chart-x) + (100% - var(--chart-x)) * var(--at));
      width: calc((100% - var(--chart-x)) * var(--span));
      background:
        repeating-linear-gradient(
          -45deg,
          color-mix(in srgb, var(--accent) 16%, transparent) 0 1px,
          transparent 1px 9px
        ),
        color-mix(in srgb, var(--accent) 3%, transparent);
      content: "";
    }

    .plan-stage--3 .plan-stage__items::before {
      mask-image: linear-gradient(to right, #000 55%, transparent);
    }

    .plan-item {
      position: relative;
      column-gap: var(--space-4);
      padding: var(--row-pad) var(--text-end) var(--row-pad) 0;
      border-top: 0;
      background: linear-gradient(var(--line), var(--line)) 0 0 / 100%
        var(--rule) no-repeat;
    }

    .plan-track,
    .plan-track--item {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: var(--chart-x);
      display: grid;
      height: auto;
      margin: 0;
      background: none;
    }

    .plan-track > span:not(.plan-mark) {
      border-left-color: var(--line);
    }

    .plan-mark--narrow {
      display: none;
    }

    /* The milestone is on its own row here, so the bar keeps its grip. */
    .plan-stage--1 .plan-track--head .plan-mark--stage {
      width: calc(
        var(--span) * 100% - var(--bar-from) - var(--grip-size) - var(--space-2)
      );
    }

    .plan-stage--1 .plan-track--head .plan-mark--stage::after {
      display: block;
    }

    /* A stage's grid line starts at its bubble: above it, the later
       columns are open. */
    .plan-stage--1 .plan-track > span:nth-child(n + 2):not(.plan-mark),
    .plan-stage--2 .plan-track > span:nth-child(n + 3):not(.plan-mark) {
      border-left-color: transparent;
    }

    .plan-track--head > span:nth-child(1),
    .plan-stage--2 .plan-track--head > span:nth-child(2),
    .plan-stage--3 .plan-track--head > span:nth-child(3) {
      border-left-color: transparent;
    }

    .plan-stage--1 .plan-track--head > span:nth-child(1),
    .plan-stage--2 .plan-track--head > span:nth-child(2),
    .plan-stage--3 .plan-track--head > span:nth-child(3) {
      background: linear-gradient(var(--line), var(--line)) 0 var(--bubble-y) /
        var(--rule) 100% no-repeat;
    }

    .plan-stage--2 .plan-track--head > span:nth-child(1),
    .plan-stage--3 .plan-track--head > span:nth-child(-n + 2) {
      border-left-color: var(--line);
    }

    /* The bubble sits on its stage's grid line, level with the title, and
       the stage's bar runs from it. */
    .plan-stage__head {
      --bubble-y: calc(var(--head-top) + var(--step-chapter) * 0.55);
    }

    .plan-stage:first-child .plan-stage__head {
      --bubble-y: calc(var(--step-chapter) * 0.55);
    }

    .plan-stage__bubble {
      position: absolute;
      z-index: 1;
      top: calc(var(--bubble-y) - var(--bubble) / 2);
      left: calc(
        var(--chart-x) + (100% - var(--chart-x)) * var(--at) - var(--bubble) / 2
      );
    }

    .plan-track--head .plan-mark {
      top: calc(var(--bubble-y) - var(--rail) / 2);
    }

    /* A service's grip, level with its title. */
    .plan-track--item .plan-mark {
      top: calc(
        var(--row-pad) + var(--step-title) * var(--leading-title) / 2 -
          var(--rail) / 2
      );
    }
  }
</style>
