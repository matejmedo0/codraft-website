---
/**
 * Zone B, "Što radimo", option 2 "Sastavnica" (the client's review,
 * batch 3). Each stage's title and tagline share one line, and its services
 * sit below in a ruled table, like the parts list on a drawing: the cells
 * share their rules, and on wide screens a row holds all of a stage's
 * services (2, 4 and 3), so every row is full and no cell stays empty. The
 * cells are selected with grips, as in CAD.
 *
 * The process line joins the bubbles 01 → 02 → 03 and draws as one stroke
 * when the section reaches its trigger (process-line.ts).
 */
import "./services.css";

import Zone from "../../components/ui/Zone.astro";
import { SERVICES } from "../copy.ts";
import { CHAPTERS } from "./chapters.ts";
import ServiceItem from "./ServiceItem.astro";

interface Props {
  /** The heading's id; the comparison page shows several options. */
  headingId?: string;
  /** The option's name, on the comparison page. */
  label?: string;
}

const { headingId = "usluge", label } = Astro.props;
const labelId = `${headingId}-opcija`;
---

<Zone
  labelledby={label === undefined ? headingId : `${labelId} ${headingId}`}
  class="svc"
>
  {label !== undefined && (
    <p class="svc-label t-label" id={labelId}>
      {label}
    </p>
  )}
  <h2 id={headingId}>{SERVICES.title}</h2>
  <div
    class="svc-line schedule"
    data-draw="late"
    data-draw-wait
    data-process-line
  >
    {CHAPTERS.map((chapter) => (
      <div class="stage">
        <span class="svc-rail stage__rail" data-rail aria-hidden="true" />
        <div class="stage__head">
          <h3 class="svc-title stage__title">
            <span class="svc-bubble stage__bubble">{chapter.number}</span>
            {chapter.title}
          </h3>
          <p class="svc-tagline">{chapter.tagline}</p>
        </div>
        <ul
          class="svc-items stage__cells"
          data-count={String(chapter.items.length)}
        >
          {chapter.items.map((item) => (
            <ServiceItem
              title={item.title}
              body={item.body}
              href={item.href}
              class="stage__cell"
            />
          ))}
        </ul>
      </div>
    ))}
  </div>
  <script>
    import "../../components/ui/draw.ts";
    import "./process-line.ts";
  </script>
</Zone>

<style>
  .stage {
    --stage-top: var(--space-5);

    position: relative;
    padding: var(--stage-top) 0 var(--space-7)
      calc(var(--bubble) + var(--space-4));
  }

  .stage:last-child {
    padding-bottom: 0;
  }

  .stage__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    align-items: baseline;
    margin-bottom: var(--space-5);
  }

  .stage__title {
    padding-top: max(0px, (var(--bubble) - 1lh) / 2);
  }

  .stage__bubble {
    position: absolute;
    z-index: 1;
    top: var(--stage-top);
    left: 0;
  }

  .stage__rail {
    top: 0;
    bottom: 0;
    left: calc((var(--bubble) - var(--rail)) / 2);
  }

  .stage:first-child .stage__rail {
    top: calc(var(--stage-top) + var(--bubble) / 2);
  }

  .stage:last-child .stage__rail {
    bottom: auto;
    height: calc(var(--stage-top) + var(--bubble) / 2);
  }

  /* The ruled table: the cells share their rules. */
  .stage__cells {
    gap: var(--rule);
    border: var(--rule) solid var(--line);
    background: var(--line);
  }

  .stage__cell {
    padding: var(--space-4) var(--space-5) var(--space-5);
    background: var(--surface);
  }

  /* A selected cell's grips and outline lie over its neighbours. */
  .stage__cell:is(:hover, :focus-within) {
    z-index: 1;
  }

  @media (min-width: 40rem) {
    .stage__cells {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stage__cell:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .stage {
      --stage-top: var(--space-6);

      padding-left: calc(var(--bubble) + var(--gap));
    }

    .stage__cells[data-count="3"] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .stage__cells[data-count="4"] {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .stage__cell:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
</style>
