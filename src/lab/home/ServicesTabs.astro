---
/**
 * "Što radimo", option 14 "Kartice" (review #101): one stage at a time. The
 * three stages stand in a row as tabs, always in view, so the order 01 → 02
 * → 03 reads at a glance; under them, the chosen stage's tagline and its
 * services. The section is about half as tall as the others.
 *
 * - Every tab looks like what it is: an unchosen stage's name is underlined
 *   like every link; the chosen one is underlined by the process line,
 *   which draws when it is chosen and ends in a grip at the tab's corner.
 *   A tab shows its grips on hover and keyboard focus, like every control.
 * - From 64rem the panels share one place, so choosing a stage never moves
 *   the page below; the place is as tall as the tallest.
 * - A stage's icons draw when it is first shown: stage 01's when its
 *   services reach 85 % of the screen's height (stage-tabs.ts).
 * - Keyboard: the arrow keys move between the tabs and choose them, Home
 *   and End go to the first and the last (the WAI-ARIA tabs pattern).
 *
 * On phones (below 48rem), and without JavaScript, there are no tabs: the
 * three stages stand one after another, each with its title. With reduced
 * motion the tabs work as always, without the line drawing.
 */
import "./services.css";

import Grips from "../../components/ui/Grips.astro";
import Zone from "../../components/ui/Zone.astro";
import { SERVICES } from "../copy.ts";
import { CHAPTERS } from "./chapters.ts";
import ServiceItem from "./ServiceItem.astro";

interface Props {
  /** The heading's id; the comparison page shows several options. */
  headingId?: string;
  /** The option's name, on the comparison page. */
  label?: string;
}

const { headingId = "usluge", label } = Astro.props;
const labelId = `${headingId}-opcija`;
const stages = CHAPTERS.map((chapter) => ({
  chapter,
  tab: `${headingId}-faza-${chapter.number}`,
  panel: `${headingId}-panel-${chapter.number}`,
}));
---

<Zone
  labelledby={label === undefined ? headingId : `${labelId} ${headingId}`}
  class="svc"
>
  {label !== undefined && (
    <p class="svc-label t-label" id={labelId}>
      {label}
    </p>
  )}
  <h2 id={headingId}>{SERVICES.title}</h2>
  <div class="tabs" data-tabs>
    <div
      class="tabs__list"
      role="tablist"
      aria-labelledby={headingId}
      hidden
      data-tabs-list
    >
      {stages.map(({ chapter, tab, panel }, index) => (
        <button
          class="tabs__tab has-grips"
          type="button"
          role="tab"
          id={tab}
          aria-controls={panel}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          data-tabs-tab
        >
          <span class="svc-bubble tabs__bubble">{chapter.number}</span>
          <span class="tabs__name">{chapter.title}</span>
          <span class="tabs__line" aria-hidden="true" />
          <Grips />
        </button>
      ))}
    </div>
    <div class="tabs__panels">
      {stages.map(({ chapter, panel }, index) => (
        <div
          class:list={["tabs__panel", { "is-active": index === 0 }]}
          id={panel}
          data-tabs-panel
        >
          <h3 class="svc-title tabs__title">
            <span class="svc-bubble">{chapter.number}</span>
            {chapter.title}
          </h3>
          <p class="svc-tagline tabs__tagline">{chapter.tagline}</p>
          <ul
            class:list={[
              "svc-items",
              "tabs__items",
              `tabs__items--${String(chapter.items.length)}`,
            ]}
          >
            {chapter.items.map((item) => (
              <ServiceItem
                title={item.title}
                body={item.body}
                href={item.href}
                icon={item.icon}
                class="tabs-item"
                data-axis-item
              />
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <script>
    import "./stage-tabs.ts";
  </script>
</Zone>

<style>
  .tabs {
    --icon: 2.5rem;
  }

  /* Without the tabs (phones, no JavaScript): the stages one after
     another, as in the other options. */
  .tabs__panel + .tabs__panel {
    margin-top: var(--space-7);
  }

  .tabs__title {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .tabs__tagline {
    max-width: 34ch;
    margin-top: var(--space-2);
    padding-left: calc(var(--bubble) + var(--space-4));
    text-wrap: balance;
  }

  .tabs__items {
    gap: 0 var(--space-6);
    margin-top: var(--space-4);
  }

  /* The service's title lines up with its stage's title. */
  .tabs-item {
    display: grid;
    grid-template-columns: var(--icon) minmax(0, 1fr);
    column-gap: calc(var(--bubble) + var(--space-4) - var(--icon));
    align-content: start;
    align-items: start;
    padding: var(--space-4) 0 var(--space-5);
    border-top: var(--rule) solid var(--line);
  }

  .tabs-item :global(.service__icon) {
    grid-row: 1 / span 2;
  }

  .tabs-item :global(:is(.service__title, .service__body)) {
    grid-column: 2;
  }

  /* The tabs: the three stages on one rule, on the panels' grid. */
  .tabs__list {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-6);
    margin-bottom: var(--space-6);
    border-bottom: var(--rule) solid var(--line);
  }

  .tabs__list[hidden] {
    display: none;
  }

  .tabs__tab {
    position: relative;
    display: flex;
    grid-column: span 4;
    gap: var(--space-4);
    align-items: center;
    justify-self: start;
    padding: var(--space-4) var(--space-3) var(--space-5) 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: var(--step-title);
    font-stretch: var(--width-heading);
    font-weight: var(--weight-chapter);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-title);
    text-align: left;
    cursor: pointer;
  }

  /* An unchosen stage is underlined like every link. */
  .tabs__name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-wrap: balance;
  }

  .tabs__tab[aria-selected="true"] .tabs__name {
    text-decoration: none;
  }

  .tabs__tab:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }

  /* The chosen tab's process line, on the rule, ending in a grip at the
     tab's corner; that grip stands for the corner's own. */
  .tabs__line {
    position: absolute;
    right: 0;
    bottom: calc(var(--rail) / -2 - var(--rule) / 2);
    left: 0;
    height: var(--rail);
    background: var(--accent);
    transform-origin: 0 50%;
    visibility: hidden;
  }

  .tabs__line::after {
    position: absolute;
    top: calc(50% - var(--grip-size) / 2);
    left: calc(100% - var(--grip-size) / 2);
    width: var(--grip-size);
    height: var(--grip-size);
    border: var(--grip-stroke) solid var(--accent);
    background: var(--grip-fill);
    content: "";
  }

  .tabs__tab[aria-selected="true"] .tabs__line {
    visibility: visible;
  }

  .tabs__tab[aria-selected="true"] :global(.grips > span:nth-child(n + 3)) {
    display: none;
  }

  /* With the tabs: only the chosen stage shows, and its title is in its
     tab. */
  .tabs.is-tabbed .tabs__panel {
    margin: 0;
  }

  .tabs.is-tabbed .tabs__panel:not(.is-active) {
    display: none;
  }

  .tabs.is-tabbed .tabs__title {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .tabs.is-tabbed .tabs__tagline {
    padding-left: 0;
  }

  .tabs.is-tabbed .tabs-item {
    column-gap: var(--space-4);
  }

  .tabs__panel:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }

  /* Two services to a row. */
  @media (min-width: 48rem) {
    .tabs__items {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .tabs__items > :global(*) {
      grid-column: span 6;
    }
  }

  @media (min-width: 64rem) {
    .tabs {
      --icon: 3rem;
      --step-title: clamp(1.25rem, 1.1rem + 0.45vw, 1.625rem);
      --step-service: var(--step-lead);
    }

    .tabs__list {
      margin-bottom: var(--space-7);
    }

    .tabs-item :global(.service-icon) {
      width: var(--icon);
      height: var(--icon);
      stroke-width: 1.5;
    }

    /* The panels share one place, as tall as the tallest. */
    .tabs.is-tabbed .tabs__panels {
      display: grid;
    }

    .tabs.is-tabbed .tabs__panel {
      grid-area: 1 / 1;
    }

    .tabs.is-tabbed .tabs__panel:not(.is-active) {
      display: block;
      visibility: hidden;
    }
  }

  /* From 80rem a stage's services share one row (2, 4 or 3), each icon
     above its title. */
  @media (min-width: 80rem) {
    .tabs__tab {
      font-size: var(--step-chapter);
      letter-spacing: -0.018em;
    }

    .tabs-item {
      display: block;
    }

    .tabs-item :global(.service-icon) {
      margin-bottom: var(--space-4);
    }

    .tabs__items--3 > :global(*) {
      grid-column: span 4;
    }

    .tabs__items--4 > :global(*) {
      grid-column: span 3;
    }
  }
</style>
