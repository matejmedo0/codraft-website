---
/**
 * The ground under "Što radimo" as a tree (review #95, #98; lab only): an
 * irregular crown at low opacity, one lobe a stage where it branches, and
 * the stages' heads on the page's own ground between them. Each kind has
 * its own outline, in percentages of the tree (the stages sit at much the
 * same heights at every width). A clip-path takes one polygon, so its lobes
 * are joined down the line by edges of no width, hidden behind it:
 * - "hatch": hatched like a section in a drawing (option 9).
 * - "outline": a CAD outline as it shows when selected, dashed, with a grip
 *   on every corner, over a faint tint.
 * - "grid": a drawing's grid in a stepped outline of level, upright and 45°
 *   edges, its lines set out from the process line.
 * It never moves, and shows from 64rem, where the tree does.
 */
interface Props {
  variant: "hatch" | "outline" | "grid";
}

const { variant } = Astro.props;

/** The selected outline: one lobe a stage, corners in % of the tree. */
const LOBES: [number, number][][] = [
  [
    [28, 13.4],
    [70, 13.6],
    [92, 14.8],
    [96.5, 20.5],
    [84, 23.2],
    [20, 23.3],
    [3, 19.5],
    [6.5, 14.2],
  ],
  [
    [14, 38.8],
    [86, 38.9],
    [99, 44],
    [96.5, 55.8],
    [83, 61.2],
    [15, 61.1],
    [1, 55.2],
    [3.5, 43.5],
  ],
  [
    [17, 74.7],
    [85, 74.6],
    [98, 81],
    [90.5, 90],
    [72, 94.5],
    [62, 99.6],
    [38, 99.4],
    [25, 93.5],
    [5.5, 87.6],
    [2, 78.6],
  ],
];
const polygons = LOBES.map((lobe) =>
  lobe.map(([x, y]) => `${String(x)},${String(y)}`).join(" "),
);
/** A grip is a zero-length stroke with square ends, square at any scale. */
const grips = LOBES.flat()
  .map(([x, y]) => `M${String(x)} ${String(y)}h0`)
  .join("");
---

{variant === "outline" ? (
  <svg
    class="crown crown--outline"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    {polygons.map((points) => (
      <polygon class="crown__area" points={points} />
    ))}
    <path class="crown__grip" d={grips} />
    <path class="crown__grip-fill" d={grips} />
  </svg>
) : (
  <span class:list={["crown", `crown--${variant}`]} aria-hidden="true" />
)}

<style>
  .crown {
    display: none;
  }

  @media (min-width: 64rem) {
    .crown {
      position: absolute;
      z-index: -1;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    /* Hatched like a section, as option 9 (#95). */
    .crown--hatch {
      background:
        repeating-linear-gradient(
          -45deg,
          color-mix(in srgb, var(--accent) 16%, transparent) 0 1px,
          transparent 1px 9px
        ),
        color-mix(in srgb, var(--accent) 3%, transparent);
      clip-path: polygon(
        50% 13%,
        67% 13.2%,
        86% 13%,
        95% 15.5%,
        92% 20%,
        96% 22.6%,
        78% 23.3%,
        60% 23.3%,
        40% 23.2%,
        22% 23.3%,
        6% 22.2%,
        2% 16%,
        14% 13%,
        34% 13.4%,
        50% 13%,
        50% 38.6%,
        74% 38.8%,
        90% 38.6%,
        98% 41%,
        95% 48%,
        99.5% 54.4%,
        96% 59.6%,
        84% 61.4%,
        57% 61.3%,
        43% 61.4%,
        20% 61.3%,
        8% 59.8%,
        0.5% 54.2%,
        3% 46.5%,
        0.5% 40%,
        14% 38.6%,
        40% 38.9%,
        50% 38.6%,
        50% 74.2%,
        72% 74.4%,
        90% 74.2%,
        98% 79%,
        94% 86%,
        82% 89.5%,
        74% 92%,
        68% 99.4%,
        52% 99.8%,
        34% 99.2%,
        28% 93.5%,
        17% 89%,
        4% 86%,
        1.5% 78.6%,
        11% 74.8%,
        29% 74.4%,
        50% 74.2%,
        50% 38.6%,
        50% 13%
      );
    }

    /* Selected in CAD: a dashed outline with its grips. */
    .crown__area {
      fill: color-mix(in srgb, var(--accent) 4%, transparent);
      stroke: color-mix(in srgb, var(--accent) 55%, transparent);
      stroke-dasharray: 6 4;
      stroke-width: var(--rule);
      vector-effect: non-scaling-stroke;
    }

    .crown__grip,
    .crown__grip-fill {
      fill: none;
      stroke-linecap: square;
      vector-effect: non-scaling-stroke;
    }

    .crown__grip {
      stroke: var(--accent);
      stroke-width: var(--grip-size);
    }

    .crown__grip-fill {
      stroke: var(--grip-fill);
      stroke-width: calc(var(--grip-size) - var(--grip-stroke) * 2);
    }

    /* A drawing's grid: a fine line every 16 px, a stronger one every
       80 px, both set out from the process line in the middle. */
    .crown--grid {
      --minor: color-mix(in srgb, var(--accent) 9%, transparent);
      --major: color-mix(in srgb, var(--accent) 16%, transparent);

      background:
        linear-gradient(to right, var(--major) 1px, transparent 1px)
          calc(50% + 40px) 0 / 80px 80px,
        linear-gradient(var(--major) 1px, transparent 1px) 0 0 / 80px 80px,
        linear-gradient(to right, var(--minor) 1px, transparent 1px)
          calc(50% + 8px) 0 / 16px 16px,
        linear-gradient(var(--minor) 1px, transparent 1px) 0 0 / 16px 16px,
        color-mix(in srgb, var(--accent) 2%, transparent);
      clip-path: polygon(
        50% 13%,
        86% 13%,
        93% 19.8%,
        93% 21.4%,
        91% 23.3%,
        6% 23.3%,
        6% 17.4%,
        10.6% 13%,
        50% 13%,
        50% 38.6%,
        84% 38.6%,
        90% 44.6%,
        90% 48%,
        97% 48%,
        97% 55.5%,
        91.5% 61.4%,
        9% 61.4%,
        3% 55.4%,
        3% 50%,
        8% 50%,
        8% 43%,
        12.5% 38.6%,
        50% 38.6%,
        50% 74.2%,
        88% 74.2%,
        96% 82.2%,
        96% 88%,
        89% 88%,
        89% 92.6%,
        82% 99.6%,
        18% 99.6%,
        10% 91.6%,
        10% 86%,
        3% 86%,
        3% 81.2%,
        10% 74.2%,
        50% 74.2%,
        50% 38.6%,
        50% 13%
      );
    }
  }
</style>
