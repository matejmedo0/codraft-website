---
/**
 * Zone D, "Tehničko crtanje", option C "Legenda" (the client's review,
 * batch 6), the client's choice in batch 8, laid out as the client set out
 * in batch 9. The drawing leads: the floor plan starts at the top of the
 * zone, on the left, and draws like a timelapse (PlanDrawing.astro,
 * unchanged in function). On the right, centred on the drawing's frame: the
 * heading, the lead (as in the free audit), and the three services
 * (ADR 0019) as rows like "Kako radimo". The button "Pošaljite skicu" of
 * batch 9 is gone (review #61): requests come through the contact form and
 * email (ADR 0020). The layer list and the replay button have their own row
 * under the drawing. The plan rises into its 3D view (review #58) and gets
 * a roof (option 3 of #63, the client's choice in #64), in palette 1 (#66);
 * the comparison pages pass the other options and palettes (#63, #65).
 *
 * The zone is on the 12-column grid of the hero, the audit and the team
 * (critique 13, review #118): the drawing on columns 1-7 and the text from
 * column 8, where the hero's drawing starts, so 58/42 ("približno 57/43",
 * #22). The plan spans two rows as a subgrid, so its frame takes the first
 * row and its layer list the second. Where the text is taller than the
 * drawing, the frame grows with the row and the plan stays centred in it.
 * Below 900 px (the client's breakpoint): one column, text, drawing, layer
 * list.
 */
import "../services.css";

import Zone from "../../../components/ui/Zone.astro";
import { DRAFTING } from "../../copy.ts";
import PlanDrawing from "../PlanDrawing.astro";
import type { HousePalette, PlanModel } from "../plan-projection.ts";
import ServiceItem from "../ServiceItem.astro";
import { DRAFTING_SERVICES } from "./drafting.ts";

interface Props {
  /** The heading's id; the comparison page shows several options. */
  headingId?: string;
  /** The option's name, on the comparison page. */
  label?: string;
  /** How the plan's 3D view plays (review #63); Home has the roof (#64). */
  model?: PlanModel;
  /** The house's colours: Home has palette 1 (#66), the comparison #65. */
  palette?: HousePalette;
}

const {
  headingId = "cad",
  label,
  model = "roof",
  palette = "navy-roof",
} = Astro.props;
const labelId = `${headingId}-opcija`;
---

<Zone
  labelledby={label === undefined ? headingId : `${labelId} ${headingId}`}
  class="svc"
>
  {label !== undefined && (
    <p class="svc-label t-label" id={labelId}>
      {label}
    </p>
  )}
  <div class="legend">
    <div class="legend__text">
      <h2 id={headingId}>{DRAFTING.title}</h2>
      <p class="legend__lead">{DRAFTING.home.lead}</p>
      <ul class="legend__list">
        {DRAFTING_SERVICES.map((item) => (
          <ServiceItem
            title={item.title}
            body={item.body}
            href={item.href}
            level="h3"
            class="legend__item"
          />
        ))}
      </ul>
    </div>
    <PlanDrawing
      idPrefix={headingId}
      class="legend__plan"
      model={model}
      palette={palette}
    />
  </div>
</Zone>

<style>
  .legend {
    display: grid;
    gap: var(--space-7);
  }

  .legend__text {
    display: flex;
    flex-direction: column;
    container: legend-text / inline-size;
  }

  /* As the free audit's lead (HomeAudit.astro). */
  .legend__lead {
    max-width: var(--measure-lead);
    margin-top: var(--space-4);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  /* The services as the rows of "Kako radimo" (HomePrinciples.astro): the
     same rule, spacing and type. Stacked while the column is narrow. */
  .legend__list {
    display: grid;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .legend__item {
    display: grid;
    gap: var(--space-2);
    padding: 1.25rem 0 var(--space-5);
    border-top: var(--rule) solid var(--line);
  }

  .legend__item :global(.service__body) {
    margin-top: 0;
    color: var(--ink-muted);
    font-size: inherit;
    line-height: inherit;
  }

  /* From a 520 px column: the title on the left, its line on the right. */
  @container legend-text (min-width: 32.5rem) {
    .legend__item {
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr);
      gap: var(--gap);
      padding-block: var(--space-5) 1.75rem;
    }

    .legend__item:first-child {
      padding-top: var(--space-2);
      border-top: 0;
    }
  }

  /* The block ends with the last line, so it centres on the drawing. */
  .legend__item:last-child {
    padding-bottom: 0;
  }

  @media (min-width: 56.25rem) {
    .legend {
      grid-template-rows: auto auto;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0 var(--gap);
    }

    /* Centred on the drawing's frame, not on the layer list's row. */
    .legend__text {
      grid-row: 1;
      grid-column: 8 / -1;
      align-self: center;
    }

    /* The frame takes the first row, the layer list the second. */
    .legend__plan {
      display: grid;
      grid-row: 1 / span 2;
      grid-column: 1 / span 7;
      grid-template-rows: subgrid;
    }

    .legend__plan :global(.plan__sheet) {
      display: grid;
      align-content: center;
    }
  }
</style>
