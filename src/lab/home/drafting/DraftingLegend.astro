---
/**
 * Zone D, "Tehničko crtanje", option C "Legenda" (the client's review,
 * batch 6), the client's choice in batch 8, laid out as the client set out
 * in batch 9. The drawing leads: the floor plan starts at the top of the
 * zone, on the left, and draws like a timelapse (PlanDrawing.astro,
 * unchanged in function). On the right, centred on the drawing's frame: the
 * heading, the lead (as in the free audit), the three services (ADR 0019)
 * as rows like "Kako radimo", and the button right under them. The layer
 * list and the replay button have their own row under the drawing.
 *
 * The grid's areas are "drawing text" / "legend .". The plan spans the
 * drawing and legend rows as a subgrid, so its frame takes the first row and
 * its layer list the second. Where the text is taller than the drawing, the
 * frame grows with the row and the plan stays centred in it. Below 900 px
 * (the client's breakpoint): one column, text, drawing, layer list.
 */
import "../services.css";

import Button from "../../../components/ui/Button.astro";
import Zone from "../../../components/ui/Zone.astro";
import { pathFor } from "../../../features/i18n/urls.ts";
import { DRAFTING } from "../../copy.ts";
import PlanDrawing from "../PlanDrawing.astro";
import ServiceItem from "../ServiceItem.astro";
import { DRAFTING_SERVICES } from "./drafting.ts";

interface Props {
  /** The heading's id; the comparison page shows several options. */
  headingId?: string;
  /** The option's name, on the comparison page. */
  label?: string;
}

const { headingId = "cad", label } = Astro.props;
const labelId = `${headingId}-opcija`;
---

<Zone
  labelledby={label === undefined ? headingId : `${labelId} ${headingId}`}
  class="svc"
>
  {label !== undefined && (
    <p class="svc-label t-label" id={labelId}>
      {label}
    </p>
  )}
  <div class="legend">
    <div class="legend__text">
      <h2 id={headingId}>{DRAFTING.title}</h2>
      <p class="legend__lead">{DRAFTING.home.lead}</p>
      <ul class="legend__list">
        {DRAFTING_SERVICES.map((item) => (
          <ServiceItem
            title={item.title}
            body={item.body}
            href={item.href}
            level="h3"
            class="legend__item"
          />
        ))}
      </ul>
      <Button href={pathFor("drafting", "hr")} class="legend__cta">
        {DRAFTING.home.cta}
      </Button>
    </div>
    <PlanDrawing idPrefix={headingId} class="legend__plan" />
  </div>
</Zone>

<style>
  .legend {
    display: grid;
    gap: var(--space-7);
  }

  .legend__text {
    display: flex;
    flex-direction: column;
    container: legend-text / inline-size;
  }

  /* As the free audit's lead (HomeAudit.astro). */
  .legend__lead {
    max-width: var(--measure-lead);
    margin-top: var(--space-4);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  /* The services as the rows of "Kako radimo" (HomePrinciples.astro): the
     same rule, spacing and type. Stacked while the column is narrow. */
  .legend__list {
    display: grid;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .legend__item {
    display: grid;
    gap: var(--space-2);
    padding: 1.25rem 0 var(--space-5);
    border-top: var(--rule) solid var(--line);
  }

  .legend__item :global(.service__title) {
    font-stretch: var(--width-heading);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
  }

  .legend__item :global(.service__body) {
    margin-top: 0;
    color: var(--ink-muted);
    font-size: inherit;
    line-height: inherit;
  }

  /* From a 520 px column: the title on the left, its line on the right. */
  @container legend-text (min-width: 32.5rem) {
    .legend__item {
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr);
      gap: var(--gap);
      padding-block: var(--space-5) 1.75rem;
    }

    .legend__item:first-child {
      padding-top: var(--space-2);
      border-top: 0;
    }
  }

  /* The button follows the list at the free audit's lead-to-button gap. */
  .legend__item:last-child {
    padding-bottom: 0;
  }

  .legend__cta {
    align-self: flex-start;
    margin-top: var(--space-7);
  }

  @media (min-width: 56.25rem) {
    .legend {
      grid-template-areas:
        "drawing text"
        "legend .";
      grid-template-columns: minmax(0, 57fr) minmax(0, 43fr);
      gap: 0 var(--space-7);
    }

    /* Centred on the drawing's frame, not on the layer list's row. */
    .legend__text {
      grid-area: text;
      align-self: center;
    }

    /* The frame takes the drawing row, the layer list the legend row. */
    .legend__plan {
      display: grid;
      grid-row: drawing-start / legend-end;
      grid-column: drawing;
      grid-template-rows: subgrid;
    }

    .legend__plan :global(.plan__sheet) {
      display: grid;
      align-content: center;
    }
  }

  @media (min-width: 80rem) {
    .legend {
      column-gap: var(--space-9);
    }
  }
</style>
