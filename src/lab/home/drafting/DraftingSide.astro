---
/**
 * Zone D, "Tehničko crtanje", option A "Uz tlocrt" (the client's review,
 * batch 6): the drafting offer, the second audience's own path (ADR 0018),
 * as before but in the type of "Što radimo": the tagline as its muted lead,
 * the three services (ADR 0019) as its items, each with one line. The floor
 * plan sits beside it on graph paper and draws like a timelapse when half
 * of it is in view (PlanDrawing.astro).
 */
import "../services.css";

import Button from "../../../components/ui/Button.astro";
import Zone from "../../../components/ui/Zone.astro";
import { pathFor } from "../../../features/i18n/urls.ts";
import { DRAFTING } from "../../copy.ts";
import PlanDrawing from "../PlanDrawing.astro";
import ServiceItem from "../ServiceItem.astro";
import { DRAFTING_SERVICES } from "./drafting.ts";

interface Props {
  /** The heading's id; the comparison page shows several options. */
  headingId?: string;
  /** The option's name, on the comparison page. */
  label?: string;
}

const { headingId = "cad", label } = Astro.props;
const labelId = `${headingId}-opcija`;
---

<Zone
  labelledby={label === undefined ? headingId : `${labelId} ${headingId}`}
  class="svc"
>
  {label !== undefined && (
    <p class="svc-label t-label" id={labelId}>
      {label}
    </p>
  )}
  <div class="side">
    <div class="side__text">
      <h2 id={headingId}>{DRAFTING.title}</h2>
      <p class="svc-tagline side__tagline">{DRAFTING.tagline}</p>
      <p class="side__audience">{DRAFTING.audience}</p>
      <ul class="svc-items side__items">
        {DRAFTING_SERVICES.map((item) => (
          <ServiceItem
            title={item.title}
            body={item.body}
            href={item.href}
            level="h3"
            class="side__item"
          />
        ))}
      </ul>
      <Button href={pathFor("drafting", "hr")}>{DRAFTING.cta}</Button>
    </div>
    <div class="side__figure">
      <PlanDrawing idPrefix={headingId} />
    </div>
  </div>
</Zone>

<style>
  .side {
    display: grid;
    gap: var(--space-7);
  }

  .side__tagline {
    margin-top: var(--space-3);
  }

  .side__audience {
    max-width: var(--measure-lead);
    margin-top: var(--space-4);
    font-size: var(--step-service);
    line-height: 1.5;
  }

  .side__items {
    margin: var(--space-6) 0;
  }

  .side__item {
    padding: var(--space-4) 0 var(--space-5);
    border-top: var(--rule) solid var(--line);
  }

  @media (min-width: 64rem) {
    .side {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--gap);
      align-items: center;
    }

    .side__text {
      grid-column: 1 / span 5;
    }

    .side__figure {
      grid-column: 6 / -1;
    }
  }
</style>
