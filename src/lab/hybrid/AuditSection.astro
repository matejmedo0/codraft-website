---
/**
 * Zone C: the free audit and its three steps (ADR 0007: form → time slot →
 * confirmation). The steps are grips joined by a drafting line that grows
 * from one to the next, once, when the list scrolls into view
 * (docs/motion.md, "Draw a line"). In E this zone is the navy band. What the
 * audit checks (G4) waits for the client, so a placeholder says so.
 */
import { pathFor } from "../../features/i18n/urls.ts";
import Grips from "../components/Grips.astro";
import { AUDIT } from "../copy.ts";
import ZoneMark from "./ZoneMark.astro";

interface Props {
  letter: string;
  navy?: boolean;
}

const { letter, navy = false } = Astro.props;
const lastStep = AUDIT.steps.length - 1;
---

<section
  class:list={["zone", "audit", { "on-navy": navy }]}
  aria-labelledby="analiza"
>
  <ZoneMark letter={letter} />
  <div class="audit__intro">
    <h2 id="analiza">{AUDIT.title}</h2>
    <p class="audit__lead">{AUDIT.lead}</p>
  </div>
  <ol class="steps" data-draw="late">
    {AUDIT.steps.map((step, index) => (
      <li class="step">
        <span class="step__node" aria-hidden="true" />
        {index < lastStep && <span class="step__link" aria-hidden="true" />}
        <h3 class="step__title">
          <span class="step__number" aria-hidden="true">
            {index + 1}
          </span>
          {step.title}
        </h3>
        <p class="step__body">{step.body}</p>
      </li>
    ))}
  </ol>
  <div class="audit__actions">
    <a class="btn btn--primary has-grips" href={pathFor("audit", "hr")}>
      {AUDIT.cta}
      <Grips />
    </a>
    <p class="audit__note t-label">{AUDIT.placeholderNote}</p>
  </div>
</section>
