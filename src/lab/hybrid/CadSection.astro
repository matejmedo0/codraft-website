---
/**
 * Zone D: the drafting offer, with the drawing on graph paper beside it
 * (the client preferred A's version to B's and C's). The drawing builds
 * itself layer by layer when it scrolls into view (CadDrawing).
 */
import { pathFor } from "../../features/i18n/urls.ts";
import Grips from "../components/Grips.astro";
import { DRAFTING } from "../copy.ts";
import CadDrawing from "./CadDrawing.astro";
import ZoneMark from "./ZoneMark.astro";

interface Props {
  letter: string;
}

const { letter } = Astro.props;
---

<section class="zone drafting" aria-labelledby="cad">
  <ZoneMark letter={letter} />
  <div class="drafting__text">
    <h2 id="cad">{DRAFTING.title}</h2>
    <p class="drafting__tagline">{DRAFTING.tagline}</p>
    <p class="drafting__audience">{DRAFTING.audience}</p>
    <div class="drafting__items">
      {DRAFTING.items.map((item) => (
        <div>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
    <a class="btn btn--primary has-grips" href={pathFor("drafting", "hr")}>
      {DRAFTING.cta}
      <Grips />
    </a>
  </div>
  <div class="drafting__figure">
    <CadDrawing />
  </div>
</section>
