---
/**
 * Zone G: the closing call to action, from the plan stage's own copy
 * (plan.tagline, plan.cta), with a second way in for those who'd rather
 * write. In D it is navy, so navy opens and closes the sheet.
 */
import { pathFor } from "../../features/i18n/urls.ts";
import Grips from "../components/Grips.astro";
import { CLOSING } from "../copy.ts";
import ZoneMark from "./ZoneMark.astro";

interface Props {
  letter: string;
  navy?: boolean;
}

const { letter, navy = false } = Astro.props;
---

<section
  class:list={["zone", "closing", { "on-navy": navy }]}
  aria-labelledby="zavrsni-poziv"
>
  <ZoneMark letter={letter} />
  <h2 class="closing__title" id="zavrsni-poziv">
    {CLOSING.title}
  </h2>
  <div class="closing__actions">
    <a class="btn btn--primary has-grips" href={pathFor("audit", "hr")}>
      {CLOSING.primary}
      <Grips />
    </a>
    <a class="closing__link" href={pathFor("contact", "hr")}>
      {CLOSING.secondary}
    </a>
  </div>
</section>
