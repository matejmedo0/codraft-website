---
/**
 * The header of the hybrids: the static wordmark (ADR 0014: only the hero's
 * mark moves), the main navigation, the audit call to action and the
 * language link. Below 64rem the navigation folds behind "Izbornik"
 * (src/lab/scripts/lab.ts); without JavaScript it stays open.
 */
import { pathFor } from "../../features/i18n/urls.ts";
import Grips from "../components/Grips.astro";
import Wordmark from "../components/Wordmark.astro";
import { HEADER, NAV } from "../copy.ts";

interface Props {
  /** The id of the navigation panel the menu button controls. */
  menuId: string;
  navy?: boolean;
}

const { menuId, navy = false } = Astro.props;
const locale = "hr";
---

<header class:list={["masthead", { "on-navy": navy }]}>
  <a class="masthead__home" href={pathFor("home", locale)}>
    <span class="visually-hidden">{HEADER.home}</span>
    <Wordmark />
  </a>
  <button
    class="masthead__toggle"
    type="button"
    aria-expanded="false"
    aria-controls={menuId}
    data-menu-toggle
  >
    {HEADER.menu}
    <span class="masthead__toggle-icon" aria-hidden="true"></span>
  </button>
  <nav class="masthead__nav" id={menuId} aria-label="Glavna navigacija">
    <ul class="masthead__links">
      {NAV.map(({ page, label }) => (
        <li>
          <a href={pathFor(page, locale)}>{label}</a>
        </li>
      ))}
    </ul>
    <a class="btn btn--primary has-grips" href={pathFor("audit", locale)}>
      {HEADER.cta}
      <Grips />
    </a>
    <a
      class="masthead__lang"
      href={pathFor("home", "en")}
      hreflang="en"
      lang="en"
    >
      {HEADER.otherLanguage}
      <span class="visually-hidden">({HEADER.otherLanguageName})</span>
    </a>
  </nav>
</header>
