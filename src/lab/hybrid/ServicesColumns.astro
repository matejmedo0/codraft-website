---
/**
 * "Što radimo" as three columns (hybrid E). On wide screens one drafting
 * line runs through the three bubbles and ends in a grip, like the line in
 * the wordmark; each column draws its stretch in turn. Stage 01 lists two
 * items from its own text in a panel that fills its column and ends in the
 * call to action, so no column stands half empty (the client's note on B),
 * and the free audit reads as the place to start.
 */
import { pathFor } from "../../features/i18n/urls.ts";
import Grips from "../components/Grips.astro";
import { HERO, PLAN_ITEMS, SERVICES } from "../copy.ts";
import ZoneMark from "./ZoneMark.astro";

interface Props {
  letter: string;
}

const { letter } = Astro.props;
const locale = "hr";
const services = pathFor("services", locale);
const { plan, stages } = SERVICES;
---

<section class="zone services" aria-labelledby="usluge">
  <ZoneMark letter={letter} />
  <h2 id="usluge">{SERVICES.title}</h2>

  <div class="stages">
    <div class="stage" data-draw="late">
      <span class="stage__rail" aria-hidden="true"></span>
      <h3 class="stage__title">
        <span class="bubble stage__bubble">{plan.number}</span>
        {plan.title}
      </h3>
      <p class="stage__tagline">{plan.tagline}</p>
      <div class="stage__start">
        <ul class="items">
          {PLAN_ITEMS.map((item) => (
            <li class="item">
              <h4 class="item__title">{item.title}</h4>
              <p class="item__body">{item.body}</p>
            </li>
          ))}
        </ul>
        <div class="stage__start-action">
          <a class="btn btn--primary has-grips" href={pathFor("audit", locale)}>
            {HERO.primary}
            <Grips />
          </a>
        </div>
      </div>
    </div>

    {stages.map((stage, index) => (
      <div class="stage" data-draw="late">
        <span class="stage__rail" aria-hidden="true">
          {index === stages.length - 1 && <span class="stage__end" />}
        </span>
        <h3 class="stage__title">
          <span class="bubble stage__bubble">{stage.number}</span>
          {stage.title}
        </h3>
        <p class="stage__tagline">{stage.tagline}</p>
        <ul class="items">
          {stage.items.map((item) => (
            <li class="item has-grips">
              <h4 class="item__title">
                <a class="stretched-link" href={`${services}#${item.anchor}`}>
                  {item.title}
                </a>
              </h4>
              <p class="item__body">{item.body}</p>
              <Grips />
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
