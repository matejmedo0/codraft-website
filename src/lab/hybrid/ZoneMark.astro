---
/**
 * A zone's references on the sheet: its letter in the left margin and, from
 * the second zone on, the section transition (docs/phases/2-design-round-2.md).
 * When the zone's top edge scrolls into view, a blue drafting line draws
 * along the zone rule, its grip snaps in at the frame, and the selection
 * releases, leaving the plain rule; the letter snaps in with it. The rule
 * itself is always there. Decorative: hidden from assistive technology.
 *
 * Place it first in the zone, which must be positioned.
 */
interface Props {
  letter: string;
  /** The first zone has no rule above it, so nothing to select. */
  select?: boolean;
}

const { letter, select = true } = Astro.props;
---

{select && (
  <span class="zone-select" data-draw="late" aria-hidden="true">
    <span class="zone-select__grip" />
  </span>
)}
<span class="zone__letter" aria-hidden="true">
  {letter}
</span>
