---
// Design lab, direction A "Nacrt" (noindex; only in `astro dev` and lab
// builds, see astro.config.ts).
import "../styles/lab-base.css";

import BaseLayout from "../../layouts/BaseLayout.astro";
import LabBar from "../components/LabBar.astro";
import { HEADER } from "../copy.ts";
import Specimen, {
  type Swatch,
  type TextPair,
} from "../components/Specimen.astro";
import NacrtPage from "../directions/a/NacrtPage.astro";
import archivo from "../fonts/archivo.woff2?url";

const swatches: Swatch[] = [
  { name: "Papir", hex: "#F6F5F1", use: "Podloga" },
  { name: "Tinta", hex: "#0F1B2D", use: "Tekst, linije, gumbi" },
  {
    name: "Plava",
    hex: "#2F6BFF",
    use: "Samo grafika: crta, gripovi, kote, fokus",
  },
  { name: "Plava za tekst", hex: "#2457D6", use: "Poveznice" },
  { name: "Siva", hex: "#5E6878", use: "Sporedni tekst" },
  {
    name: "Udubljeni papir",
    hex: "#EDEBE5",
    use: "Prijelaz preko sekundarnog gumba",
  },
];

const pairs: TextPair[] = [
  { label: "Tinta na papiru", fg: "#0F1B2D", bg: "#F6F5F1" },
  { label: "Siva na papiru", fg: "#5E6878", bg: "#F6F5F1" },
  { label: "Plava za tekst na papiru", fg: "#2457D6", bg: "#F6F5F1" },
  { label: "Papir na tinti (gumb)", fg: "#F6F5F1", bg: "#0F1B2D" },
  { label: "Papir na tinti, prijelaz", fg: "#F6F5F1", bg: "#27364F" },
  { label: "Tinta na udubljenom papiru", fg: "#0F1B2D", bg: "#EDEBE5" },
  { label: "Brand plava na papiru", fg: "#2F6BFF", bg: "#F6F5F1", large: true },
];
---

<BaseLayout locale="hr" title="Smjer A „Nacrt“ | Laboratorij dizajna">
  <link
    slot="head"
    rel="preload"
    href={archivo}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <a class="skip-link" href="#sadrzaj">
    {HEADER.skipLink}
  </a>
  <LabBar current="a" />
  <NacrtPage />
  <Specimen letter="A" swatches={swatches} pairs={pairs} />
</BaseLayout>

<script>
  import "../scripts/lab.ts";
</script>
