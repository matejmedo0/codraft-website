---
// Design lab, direction C "Studio" (noindex; only in `astro dev` and lab
// builds, see astro.config.ts).
import "../styles/lab-base.css";

import BaseLayout from "../../layouts/BaseLayout.astro";
import LabBar from "../components/LabBar.astro";
import { HEADER } from "../copy.ts";
import Specimen, {
  type Swatch,
  type TextPair,
} from "../components/Specimen.astro";
import StudioPage from "../directions/c/StudioPage.astro";
// The H1 (the LCP element) is set in Literata, so Literata is preloaded.
import literata from "../fonts/literata.woff2?url";

const swatches: Swatch[] = [
  { name: "Papir", hex: "#F6F5F1", use: "Podloga" },
  { name: "Tinta", hex: "#0F1B2D", use: "Tekst, gumbi" },
  {
    name: "Plava",
    hex: "#2F6BFF",
    use: "Samo grafika: crta, gripovi, fokus",
  },
  { name: "Plava za tekst", hex: "#2457D6", use: "Poveznice" },
  { name: "Siva", hex: "#5E6878", use: "Sporedni tekst" },
  { name: "Topli papir", hex: "#ECEAE4", use: "Prijelaz preko stavke" },
  { name: "Okvir fotografije", hex: "#EBE8E1", use: "Mjesto za fotografiju" },
];

const pairs: TextPair[] = [
  { label: "Tinta na papiru", fg: "#0F1B2D", bg: "#F6F5F1" },
  { label: "Siva na papiru", fg: "#5E6878", bg: "#F6F5F1" },
  { label: "Plava za tekst na papiru", fg: "#2457D6", bg: "#F6F5F1" },
  { label: "Papir na tinti (gumb)", fg: "#F6F5F1", bg: "#0F1B2D" },
  { label: "Tinta na toplom papiru", fg: "#0F1B2D", bg: "#ECEAE4" },
  { label: "Siva na toplom papiru", fg: "#5E6878", bg: "#ECEAE4" },
  {
    label: "Brand plava na papiru",
    fg: "#2F6BFF",
    bg: "#F6F5F1",
    large: true,
  },
];
---

<BaseLayout locale="hr" title="Smjer C „Studio“ | Laboratorij dizajna">
  <link
    slot="head"
    rel="preload"
    href={literata}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <a class="skip-link" href="#sadrzaj">
    {HEADER.skipLink}
  </a>
  <LabBar current="c" />
  <StudioPage />
  <Specimen letter="C" swatches={swatches} pairs={pairs} />
</BaseLayout>

<script>
  import "../scripts/lab.ts";
</script>
