---
// "Tehničko crtanje" in three options, for the client to compare (the
// review, batch 6; docs/phases/2-design-review.md). Each option is a zone on
// the sheet, as on Home; the chosen one goes into /lab/pocetna. Noindex;
// only in `astro dev` and lab builds (astro.config.ts).
import Footer from "../../components/site/Footer.astro";
import Header from "../../components/site/Header.astro";
import Sheet from "../../components/ui/Sheet.astro";
import SkipLink from "../../components/ui/SkipLink.astro";
import Zone from "../../components/ui/Zone.astro";
import { t } from "../../features/i18n/ui.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabBar from "../components/LabBar.astro";
import DraftingAxis from "../home/drafting/DraftingAxis.astro";
import DraftingLegend from "../home/drafting/DraftingLegend.astro";
import DraftingSide from "../home/drafting/DraftingSide.astro";

const locale = "hr";
const MAIN_ID = "main";

const OPTIONS = [
  {
    id: "crtanje-a",
    name: "Opcija A: uz tlocrt",
    summary:
      "Raspored kao dosad, tekst lijevo i tlocrt desno, s tipografijom odjeljka „Što radimo“.",
  },
  {
    id: "crtanje-b",
    name: "Opcija B: središnja os",
    summary:
      "Centrirano kao „Što radimo“: tlocrt u sredini lista, a usluge ispod njega oko središnje osi.",
  },
  {
    id: "crtanje-c",
    name: "Opcija C: legenda",
    summary:
      "Tlocrt velik lijevo, a desno, kao legenda nacrta, usluge u ćelijama tablice.",
  },
] as const;

const [first, second, third] = OPTIONS;
---

<BaseLayout
  locale={locale}
  title="Tehničko crtanje: tri opcije | Laboratorij dizajna"
>
  <SkipLink target={MAIN_ID} label={t(locale, "skipLink")} />
  <LabBar current="crtanje" />
  <Sheet>
    <Header locale={locale} />
    <main id={MAIN_ID}>
      <Zone labelledby="opcije" select={false} class="options">
        <h1 id="opcije">Tehničko crtanje: tri opcije</h1>
        <p class="options__lead">
          Tri načina da odjeljak bude u skladu s „Što radimo“: isti naslovi,
          ista veličina teksta i jedan kratki redak po usluzi, sada s 3D
          modelima. Tlocrt se u svakoj opciji iscrtava kao timelapse. Na
          početnoj je zasad opcija A; odabranu stavljam tamo.
        </p>
        <ol class="options__list">
          {OPTIONS.map(({ id, name, summary }) => (
            <li>
              <a href={`#${id}`}>{name}</a>
              <p>{summary}</p>
            </li>
          ))}
        </ol>
      </Zone>
      <DraftingSide headingId={first.id} label={first.name} />
      <DraftingAxis headingId={second.id} label={second.name} />
      <DraftingLegend headingId={third.id} label={third.name} />
    </main>
    <Footer locale={locale} />
  </Sheet>
</BaseLayout>

<style>
  .options {
    display: grid;
    gap: var(--space-5);
  }

  .options__lead {
    max-width: var(--measure);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  .options__list {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    margin: 0;
    padding-left: 1.25rem;
  }

  .options__list a {
    font-weight: var(--weight-strong);
  }

  .options__list p {
    margin-top: var(--space-1);
    color: var(--ink-muted);
  }
</style>
