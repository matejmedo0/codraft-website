---
// Design lab, round 2, hybrid D "Model i list" (noindex; only in `astro dev`
// and lab builds, see astro.config.ts).
import "../styles/lab-base.css";

import BaseLayout from "../../layouts/BaseLayout.astro";
import LabBar from "../components/LabBar.astro";
import Specimen from "../components/Specimen.astro";
import { HEADER } from "../copy.ts";
import ModelIListPage from "../directions/d/ModelIListPage.astro";
import archivo from "../fonts/archivo.woff2?url";
import { HYBRID_PAIRS, HYBRID_SWATCHES } from "../hybrid/specimen.ts";
---

<BaseLayout locale="hr" title="Hibrid D „Model i list“ | Laboratorij dizajna">
  <link
    slot="head"
    rel="preload"
    href={archivo}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <a class="skip-link" href="#sadrzaj">
    {HEADER.skipLink}
  </a>
  <LabBar current="d" />
  <ModelIListPage />
  <Specimen letter="D" swatches={HYBRID_SWATCHES} pairs={HYBRID_PAIRS} />
</BaseLayout>

<script>
  import "../scripts/lab.ts";
</script>
