---
// Design lab, round 2, hybrid E "Nacrt s pojasom" (noindex; only in
// `astro dev` and lab builds, see astro.config.ts).
import "../styles/lab-base.css";

import BaseLayout from "../../layouts/BaseLayout.astro";
import LabBar from "../components/LabBar.astro";
import Specimen from "../components/Specimen.astro";
import { HEADER } from "../copy.ts";
import NacrtSPojasomPage from "../directions/e/NacrtSPojasomPage.astro";
import archivo from "../fonts/archivo.woff2?url";
import { HYBRID_PAIRS, HYBRID_SWATCHES } from "../hybrid/specimen.ts";
---

<BaseLayout
  locale="hr"
  title="Hibrid E „Nacrt s pojasom“ | Laboratorij dizajna"
>
  <link
    slot="head"
    rel="preload"
    href={archivo}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <a class="skip-link" href="#sadrzaj">
    {HEADER.skipLink}
  </a>
  <LabBar current="e" />
  <NacrtSPojasomPage />
  <Specimen letter="E" swatches={HYBRID_SWATCHES} pairs={HYBRID_PAIRS} />
</BaseLayout>

<script>
  import "../scripts/lab.ts";
</script>
