---
// The house with its roof in three palettes, for the client to compare (the
// review, #65; docs/phases/2-design-review.md). Each palette is the
// drafting zone as on Home, with the roof the client chose (#64); only the
// colours of the facade and the roof differ. The client chose palette 1
// (#66), now on /lab/pocetna; this page stays as the record. Noindex; only
// in `astro dev` and lab builds (astro.config.ts).
import Footer from "../../components/site/Footer.astro";
import Header from "../../components/site/Header.astro";
import Sheet from "../../components/ui/Sheet.astro";
import SkipLink from "../../components/ui/SkipLink.astro";
import Zone from "../../components/ui/Zone.astro";
import { t } from "../../features/i18n/ui.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabBar from "../components/LabBar.astro";
import DraftingLegend from "../home/drafting/DraftingLegend.astro";
import type { HousePalette } from "../home/plan-projection.ts";

const locale = "hr";
const MAIN_ID = "main";

const OPTIONS: {
  id: string;
  name: string;
  summary: string;
  palette: HousePalette;
}[] = [
  {
    id: "kuca-boje-1",
    name: "Paleta 1: svijetla fasada, tamnoplavi krov",
    summary:
      "Fasada u papirnatoj boji lista i krov u tamnoplavoj boji znaka, kao škriljevac, sa svjetlijim crtama pokrova. Najmirnija i najbliža znaku. Ovo je vaš izbor, sada na početnoj.",
    palette: "navy-roof",
  },
  {
    id: "kuca-boje-2",
    name: "Paleta 2: tamnoplava fasada, svijetli krov",
    summary:
      "Fasada u tamnoplavoj boji znaka sa svjetlijim spojnicama i svijetli limeni krov s tamnim crtama. Suvremeniji izgled, a stakla su jače plava.",
    palette: "navy-walls",
  },
  {
    id: "kuca-boje-3",
    name: "Paleta 3: plavi tonovi",
    summary:
      "Fasada u blagom tonu brand plave i krov u dubokoj plavoj, s crtama pokrova u brand plavoj. Najviše boje, i dalje iz obitelji znaka.",
    palette: "blue",
  },
];
---

<BaseLayout locale={locale} title="Kuća: tri palete | Laboratorij dizajna">
  <SkipLink target={MAIN_ID} label={t(locale, "skipLink")} />
  <LabBar current="kuca-boje" />
  <Sheet>
    <Header locale={locale} />
    <main id={MAIN_ID}>
      <Zone labelledby="opcije" select={false} class="options">
        <h1 id="opcije">Kuća: tri palete</h1>
        <p class="options__lead">
          Kuća s krovom, kako ste odabrali, u tri palete iz boja znaka:
          tamnoplave, papirnate i plave. Boju dobivaju fasada (vanjske strane
          zidova i zabat) i krov, a krov zadržava crte pokrova kao jednostavnu
          teksturu. Prostorije iznutra ostaju papirnate, pa se raspored vidi dok
          se zidovi dižu. Svaki crtež se pokrene kad do njega skrolate, a
          „Iscrtaj ponovno“ ga ponavlja. Odabrali ste paletu 1 (21. 10. 2026.);
          ona je sada na početnoj, a ova stranica ostaje kao zapis usporedbe.
        </p>
        <ol class="options__list">
          {OPTIONS.map(({ id, name, summary }) => (
            <li>
              <a href={`#${id}`}>{name}</a>
              <p>{summary}</p>
            </li>
          ))}
        </ol>
      </Zone>
      {OPTIONS.map(({ id, name, palette }) => (
        <DraftingLegend headingId={id} label={name} palette={palette} />
      ))}
    </main>
    <Footer locale={locale} />
  </Sheet>
</BaseLayout>

<style>
  .options {
    display: grid;
    gap: var(--space-5);
  }

  .options__lead {
    max-width: var(--measure);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  .options__list {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    margin: 0;
    padding-left: 1.25rem;
  }

  .options__list a {
    font-weight: var(--weight-strong);
  }

  .options__list p {
    margin-top: var(--space-1);
    color: var(--ink-muted);
  }
</style>
