---
// A preview for the client (M21 in docs/phases/3-pages.md): the new Home
// with its header in two rows, the wordmark centred above the links and
// EN. Only to compare; /lab/nova-pocetna keeps one row. Noindex; only in
// `astro dev` and lab builds (astro.config.ts).
import Footer from "../../components/site/Footer.astro";
import SkipLink from "../../components/ui/SkipLink.astro";
import { t } from "../../features/i18n/ui.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewHomeHeader from "../../views/new-home/NewHomeHeader.astro";
import NewHomeSheet from "../../views/new-home/NewHomeSheet.astro";
import NewHomeView from "../../views/new-home/NewHomeView.astro";

const locale = "hr";
const MAIN_ID = "main";
---

<BaseLayout
  locale={locale}
  title="Nova početna, zaglavlje u dva reda | Laboratorij dizajna"
>
  <SkipLink target={MAIN_ID} label={t(locale, "skipLink")} />
  <NewHomeSheet>
    <NewHomeHeader locale={locale} layout="stacked" />
    <main id={MAIN_ID}>
      <NewHomeView />
    </main>
    <Footer locale={locale} />
  </NewHomeSheet>
</BaseLayout>
