---
// The old Home, as the record (M8 in docs/phases/3-pages.md): the real Home
// as it was on 2026-10-23, from its archived copy (src/lab/archive/home-v1/).
// The new Home at `/` starts from it. Noindex; only in `astro dev` and lab
// builds (astro.config.ts).
import Footer from "../../components/site/Footer.astro";
import Header from "../../components/site/Header.astro";
import Sheet from "../../components/ui/Sheet.astro";
import SkipLink from "../../components/ui/SkipLink.astro";
import { t } from "../../features/i18n/ui.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeView from "../archive/home-v1/HomeView.astro";
import LabBar from "../components/LabBar.astro";

const locale = "hr";
const MAIN_ID = "main";
---

<BaseLayout locale={locale} title="Stara početna | Laboratorij dizajna">
  <SkipLink target={MAIN_ID} label={t(locale, "skipLink")} />
  <LabBar />
  <Sheet>
    <Header locale={locale} page="home" />
    <main id={MAIN_ID}>
      <HomeView locale={locale} />
    </main>
    <Footer locale={locale} page="home" />
  </Sheet>
</BaseLayout>
