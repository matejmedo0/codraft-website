---
// Home in the chosen direction (ADR 0015), the prototype the client's review
// refinements are made on (docs/phases/2-design-review.md): D's sections on
// the production components, with the paper header and hero, navy once at
// the end, and the free audit asked for once (ADR 0017). Noindex; only in
// `astro dev` and lab builds (astro.config.ts). Phase 3 builds the real Home
// from it.
import Footer from "../../components/site/Footer.astro";
import Header from "../../components/site/Header.astro";
import Sheet from "../../components/ui/Sheet.astro";
import SkipLink from "../../components/ui/SkipLink.astro";
import { t } from "../../features/i18n/ui.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabBar from "../components/LabBar.astro";
import HomeAudit from "../home/HomeAudit.astro";
import HomeClosing from "../home/HomeClosing.astro";
import HomeHero from "../home/HomeHero.astro";
import HomePrinciples from "../home/HomePrinciples.astro";
import HomeTeam from "../home/HomeTeam.astro";
import ServicesAxis from "../home/ServicesAxis.astro";
import DraftingLegend from "../home/drafting/DraftingLegend.astro";

const locale = "hr";
const MAIN_ID = "main";
---

<BaseLayout
  locale={locale}
  title="Početna, odabrani smjer | Laboratorij dizajna"
>
  <SkipLink target={MAIN_ID} label={t(locale, "skipLink")} />
  <LabBar current="pocetna" />
  <Sheet>
    <Header locale={locale} page="home" />
    <main id={MAIN_ID}>
      <HomeHero />
      <ServicesAxis />
      <HomeAudit />
      <DraftingLegend />
      <HomePrinciples />
      <HomeTeam />
      <HomeClosing />
    </main>
    <Footer locale={locale} page="home" />
  </Sheet>
</BaseLayout>
