---
// "Što radimo" after the layout options, as the record (the critique of
// 2026-10-21, finding 7; review #79–104 in docs/phases/2-design-review.md).
// The client compared fourteen layouts and kept the central axis, with the
// services' type a step larger (#102); it is on /lab/pocetna. The tabs
// (option 14) are kept in the archive (src/lab/archive/, #104), so the
// client can come back to them; the other options are in git history.
// Noindex; only in `astro dev` and lab builds (astro.config.ts).
import Footer from "../../components/site/Footer.astro";
import Header from "../../components/site/Header.astro";
import Sheet from "../../components/ui/Sheet.astro";
import SkipLink from "../../components/ui/SkipLink.astro";
import Zone from "../../components/ui/Zone.astro";
import { t } from "../../features/i18n/ui.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServicesTabs from "../archive/ServicesTabs.astro";
import LabBar from "../components/LabBar.astro";
import ServicesAxis from "../home/ServicesAxis.astro";

const locale = "hr";
const MAIN_ID = "main";

const OPTIONS = [
  {
    id: "raspored-odabrano",
    name: "Odabrano: središnja os, krupnija slova",
    summary:
      "Središnja os kao dosad, a slova usluga od 1024 px naviše korak su krupnija, radi lakšeg čitanja: naslov usluge oko 24 px, njezin redak oko 21 px (na 1440 px). Na mobitelu su veličine iste, zbog uskog retka. Ova je verzija na početnoj.",
  },
  {
    id: "raspored-arhiva-kartice",
    name: "U arhivi: opcija 14, kartice",
    summary:
      "Jedna faza odjednom, kao kartice. Niste je odabrali, ali je čuvamo u arhivi ako joj se poželite vratiti.",
  },
] as const;

const [chosen, archived] = OPTIONS;
---

<BaseLayout
  locale={locale}
  title="Što radimo: odabrano i arhiva | Laboratorij dizajna"
>
  <SkipLink target={MAIN_ID} label={t(locale, "skipLink")} />
  <LabBar current="sto-radimo-2" />
  <Sheet>
    <Header locale={locale} />
    <main id={MAIN_ID}>
      <Zone labelledby="opcije" select={false} class="options">
        <h1 id="opcije">Što radimo: odabrano i arhiva</h1>
        <p class="options__lead">
          Nakon kritike dizajna (21. 10. 2026.) usporedili ste četrnaest
          rasporeda za „Što radimo“ i odabrali središnju os kakva je bila, s
          krupnijim slovima usluga (skupina 30). Opciju 14 „Kartice“ čuvamo u
          arhivi; ostale opcije više nisu u kodu, ali ostaju zapisane u
          povijesti projekta.
        </p>
        <ol class="options__list">
          {OPTIONS.map(({ id, name, summary }) => (
            <li>
              <a href={`#${id}`}>{name}</a>
              <p>{summary}</p>
            </li>
          ))}
        </ol>
      </Zone>
      <ServicesAxis headingId={chosen.id} label={chosen.name} icons="beside" />
      <ServicesTabs headingId={archived.id} label={archived.name} />
    </main>
    <Footer locale={locale} />
  </Sheet>
</BaseLayout>

<style>
  .options {
    display: grid;
    gap: var(--space-5);
  }

  .options__lead {
    max-width: var(--measure);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  .options__list {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    margin: 0;
    padding-left: 1.25rem;
  }

  .options__list a {
    font-weight: var(--weight-strong);
  }

  .options__list p {
    margin-top: var(--space-1);
    color: var(--ink-muted);
  }
</style>
