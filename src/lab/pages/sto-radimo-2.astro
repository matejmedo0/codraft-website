---
// "Što radimo" in new layouts, for the client to compare (the critique of
// 2026-10-21, finding 7; review #79, #90, and #100–101 in
// docs/phases/2-design-review.md: the three options the client kept and
// three new kinds of layout). Each option is the section as on Home,
// with the same copy, icons and motion; the current one comes first for
// comparison, and the chosen one goes into /lab/pocetna. Noindex; only in
// `astro dev` and lab builds (astro.config.ts).
import Footer from "../../components/site/Footer.astro";
import Header from "../../components/site/Header.astro";
import Sheet from "../../components/ui/Sheet.astro";
import SkipLink from "../../components/ui/SkipLink.astro";
import Zone from "../../components/ui/Zone.astro";
import { t } from "../../features/i18n/ui.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabBar from "../components/LabBar.astro";
import ServicesAxis from "../home/ServicesAxis.astro";
import ServicesCycle from "../home/ServicesCycle.astro";
import ServicesPlan from "../home/ServicesPlan.astro";
import ServicesTabs from "../home/ServicesTabs.astro";

const locale = "hr";
const MAIN_ID = "main";

const OPTIONS = [
  {
    id: "raspored-sada",
    layout: "centre",
    name: "Sada: središnja os",
    summary:
      "Kao na početnoj: crta u sredini, faze centrirane iznad usluga, a usluge lijevo i desno od crte. Naslovi usluga sada su u stilu naslova, a oni koji vode dalje podcrtani su.",
  },
  {
    id: "raspored-3",
    layout: "columns",
    name: "Opcija 3: tri stupca",
    summary:
      "Od 1280 px tri faze stoje jedna uz drugu, a crta ide vodoravno kroz njihove kružiće, od 01 do 03, kao proces slijeva nadesno. Kad dođe u ekran, crta se iscrta jednim potezom, a ikone svake faze kad pero stigne do njezina kružića. Najzbijenija opcija; na užim ekranima ista je kao opcija 1.",
  },
  {
    id: "raspored-4",
    layout: "frames",
    name: "Opcija 4: središnja os s okvirima",
    summary:
      "Raspored kao sada, ali svaka usluga stoji u tankom okviru, kao ćelija na nacrtu, i okviri ispunjavaju svoju stranu crte. Slova su krupnija: naslov usluge oko 24 px, opis oko 21 px (na 1440 px). Kad prijeđete mišem preko usluge, gripovi sjednu točno na kutove okvira.",
  },
  {
    id: "raspored-12",
    layout: "plan",
    name: "Opcija 12: terminski plan",
    summary:
      "Faze kao terminski plan (gantogram), kakav se radi za gradilište. Sav tekst je u jednom stupcu lijevo, lako čitljiv, a desno je plan: svaka faza počinje na svojoj osi s kružićem, a osi se stepenasto spuštaju udesno. Svaka usluga ima svoju crtu u stupcu svoje faze, s gripom na kraju, kao u logotipu. Fiksni opseg, rok i cijena nisu crta nego točka (miljokaz) na početku izrade, jer ih znate prije početka rada. Crte faze 03 idu do ruba i završavaju strelicom, jer održavanje ne prestaje. Bez datuma: plan pokazuje redoslijed, ne obećava tjedne.",
  },
  {
    id: "raspored-13",
    layout: "cycle",
    name: "Opcija 13: krug",
    summary:
      "Faze kao krug, jer posao ne završava objavom: što naučimo dok održavamo stranicu, ulazi u sljedeći plan. Krug je nacrtan kao na nacrtu, sa središnjicama, a to je zatvoreni luk slova „c“ iz vašeg logotipa. Kružići faza stoje na krugu, a svaka usluga ima svoj grip između kružića svoje faze i sljedeće. Na širokom ekranu krug stoji uz tekst dok čitate (stranica se skrola normalno), a plavi luk prati čitanje: kad stigne do usluge, skoči njezin grip i iscrta se ikona. Nakon zadnje usluge luk se zatvori strelicom u 01. Na mobitelu je krug iznad faza i iscrta se jednom.",
  },
  {
    id: "raspored-14",
    layout: "tabs",
    name: "Opcija 14: kartice",
    summary:
      "Jedna faza odjednom. Tri faze stoje u redu kao kartice i uvijek se vide, pa se redoslijed 01 → 02 → 03 čita odmah; ispod je odabrana faza, njezin podnaslov i usluge u jednom redu. Odabranu karticu podcrta crta s gripom na kraju, kao u logotipu, i iscrta se kad je odaberete; ikone faze iscrtaju se kad je prvi put otvorite. Odjeljak je oko tri puta niži od ostalih. Radi i tipkovnicom (strelice). Usluge faza 02 i 03 vide se tek kad otvorite njihovu karticu.",
  },
] as const;
---

<BaseLayout
  locale={locale}
  title="Što radimo: nove opcije | Laboratorij dizajna"
>
  <SkipLink target={MAIN_ID} label={t(locale, "skipLink")} />
  <LabBar current="sto-radimo-2" />
  <Sheet>
    <Header locale={locale} />
    <main id={MAIN_ID}>
      <Zone labelledby="opcije" select={false} class="options">
        <h1 id="opcije">Što radimo: nove opcije rasporeda</h1>
        <p class="options__lead">
          Nakon kritike dizajna (21. 10. 2026.) tražili ste nekoliko opcija za
          „Što radimo“. Od dosadašnjih ostaju tri koje ste odabrali: sadašnja
          središnja os s početne, opcija 3 „Tri stupca“ i opcija 4 „Središnja os
          s okvirima“. Sve opcije imaju isti tekst i iste ikone.
        </p>
        <p class="options__lead">
          Opcije 12, 13 i 14 (21. 10. 2026.) su nove i svaka prikazuje tri faze
          na drukčiji način nego dosad: kao terminski plan, kao krug i kao
          kartice. Sve su napravljene od istih dijelova kao ostatak stranice:
          kružići faza, plava crta s gripom kao u logotipu i ikone koje se
          iscrtaju. Razlike se najbolje vide na širokom ekranu, od 1024 px
          naviše; na mobitelu je svaka prilagođena uskom ekranu.
        </p>
        <ol class="options__list">
          {OPTIONS.map(({ id, name, summary }) => (
            <li>
              <a href={`#${id}`}>{name}</a>
              <p>{summary}</p>
            </li>
          ))}
        </ol>
      </Zone>
      {OPTIONS.map(({ id, name, layout }) =>
        layout === "plan" ? (
          <ServicesPlan headingId={id} label={name} />
        ) : layout === "cycle" ? (
          <ServicesCycle headingId={id} label={name} />
        ) : layout === "tabs" ? (
          <ServicesTabs headingId={id} label={name} />
        ) : (
          <ServicesAxis
            headingId={id}
            label={name}
            icons="beside"
            layout={layout}
          />
        ),
      )}
    </main>
    <Footer locale={locale} />
  </Sheet>
</BaseLayout>

<style>
  .options {
    display: grid;
    gap: var(--space-5);
  }

  .options__lead {
    max-width: var(--measure);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  .options__list {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    margin: 0;
    padding-left: 1.25rem;
  }

  .options__list a {
    font-weight: var(--weight-strong);
  }

  .options__list p {
    margin-top: var(--space-1);
    color: var(--ink-muted);
  }
</style>
