---
// "Što radimo" in three options, for the client to compare (the review,
// batch 3; docs/phases/2-design-review.md). Each option is a zone on the
// sheet, as on Home; the chosen one goes into /lab/pocetna. Noindex; only
// in `astro dev` and lab builds (astro.config.ts).
import Footer from "../../components/site/Footer.astro";
import Header from "../../components/site/Header.astro";
import Sheet from "../../components/ui/Sheet.astro";
import SkipLink from "../../components/ui/SkipLink.astro";
import Zone from "../../components/ui/Zone.astro";
import { t } from "../../features/i18n/ui.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabBar from "../components/LabBar.astro";
import ServicesAxis from "../home/ServicesAxis.astro";
import ServicesChapters from "../home/ServicesChapters.astro";
import ServicesSchedule from "../home/ServicesSchedule.astro";

const locale = "hr";
const MAIN_ID = "main";

const OPTIONS = [
  {
    id: "usluge-1",
    name: "Opcija 1: poglavlja",
    summary:
      "Raspored kao dosad, naslov faze lijevo i usluge desno u dva stupca, s manje praznog prostora. Neparna zadnja usluga zauzima cijeli red.",
  },
  {
    id: "usluge-2",
    name: "Opcija 2: sastavnica",
    summary:
      "Naslov faze u jednom redu, a usluge ispod njega u ćelijama tablice, kao sastavnica na nacrtu. Svaki red je pun: 2, 4 i 3 ćelije.",
  },
  {
    id: "usluge-3",
    name: "Opcija 3: središnja os",
    summary:
      "Crta ide sredinom lista, faze su centrirane na njoj, a usluge stoje lijevo i desno od crte. Na mobitelu je crta lijevo, kao u opciji 1.",
  },
] as const;

const [first, second, third] = OPTIONS;
---

<BaseLayout
  locale={locale}
  title="Što radimo: tri opcije | Laboratorij dizajna"
>
  <SkipLink target={MAIN_ID} label={t(locale, "skipLink")} />
  <LabBar current="sto-radimo" />
  <Sheet>
    <Header locale={locale} />
    <main id={MAIN_ID}>
      <Zone labelledby="opcije" select={false} class="options">
        <h1 id="opcije">Što radimo: tri opcije</h1>
        <p class="options__lead">
          Tri načina da odjeljak bude puniji i čitljiviji. U svima su opisi
          usluga veći i tamniji, a plava crta se iscrtava jednim potezom od 01
          do 03 kad odjeljak dođe u vidno polje. Odabrali ste opciju 3 (19. 10.
          2026.); ona je sada na početnoj, s jednim kratkim retkom po usluzi.
          Ova stranica ostaje kao zapis usporedbe.
        </p>
        <ol class="options__list">
          {OPTIONS.map(({ id, name, summary }) => (
            <li>
              <a href={`#${id}`}>{name}</a>
              <p>{summary}</p>
            </li>
          ))}
        </ol>
      </Zone>
      <ServicesChapters headingId={first.id} label={first.name} />
      <ServicesSchedule headingId={second.id} label={second.name} />
      <ServicesAxis headingId={third.id} label={third.name} />
    </main>
    <Footer locale={locale} />
  </Sheet>
</BaseLayout>

<style>
  .options {
    display: grid;
    gap: var(--space-5);
  }

  .options__lead {
    max-width: var(--measure);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  .options__list {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    margin: 0;
    padding-left: 1.25rem;
  }

  .options__list a {
    font-weight: var(--weight-strong);
  }

  .options__list p {
    margin-top: var(--space-1);
    color: var(--ink-muted);
  }
</style>
