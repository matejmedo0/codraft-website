---
// The style page of the chosen direction (ADR 0015): the design tokens and
// the base components, on the sheet, as they go on the site (noindex; only
// in `astro dev` and lab builds, see astro.config.ts). It is composed like
// SiteLayout, with the lab bar above the sheet.
import "../style/style-page.css";

import Footer from "../../components/site/Footer.astro";
import Header from "../../components/site/Header.astro";
import Sheet from "../../components/ui/Sheet.astro";
import SkipLink from "../../components/ui/SkipLink.astro";
import { t } from "../../features/i18n/ui.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabBar from "../components/LabBar.astro";
import StyleClosing from "../style/StyleClosing.astro";
import StyleColours from "../style/StyleColours.astro";
import StyleComponents from "../style/StyleComponents.astro";
import StyleHero from "../style/StyleHero.astro";
import StyleMotion from "../style/StyleMotion.astro";
import StyleSpace from "../style/StyleSpace.astro";
import StyleType from "../style/StyleType.astro";

const locale = "hr";
const MAIN_ID = "main";
---

<BaseLayout locale={locale} title="Sustav dizajna | Laboratorij dizajna">
  <SkipLink target={MAIN_ID} label={t(locale, "skipLink")} />
  <LabBar current="style" />
  <Sheet>
    <Header locale={locale} />
    <main id={MAIN_ID}>
      <StyleHero />
      <StyleColours />
      <StyleType />
      <StyleSpace />
      <StyleMotion />
      <StyleComponents />
      <StyleClosing />
    </main>
    <Footer locale={locale} />
  </Sheet>
</BaseLayout>
