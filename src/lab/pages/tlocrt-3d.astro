---
// The floor plan's 3D view in three options, for the client to compare
// (the review, #63; docs/phases/2-design-review.md). Each option is the
// drafting zone as on Home; only the end of the drawing's animation
// differs. Option 1 is on /lab/pocetna until the client chooses. Noindex;
// only in `astro dev` and lab builds (astro.config.ts).
import Footer from "../../components/site/Footer.astro";
import Header from "../../components/site/Header.astro";
import Sheet from "../../components/ui/Sheet.astro";
import SkipLink from "../../components/ui/SkipLink.astro";
import Zone from "../../components/ui/Zone.astro";
import { t } from "../../features/i18n/ui.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabBar from "../components/LabBar.astro";
import DraftingLegend from "../home/drafting/DraftingLegend.astro";
import type { PlanModel } from "../home/plan-projection.ts";

const locale = "hr";
const MAIN_ID = "main";

const OPTIONS: {
  id: string;
  name: string;
  summary: string;
  model: PlanModel;
}[] = [
  {
    id: "tlocrt-3d-1",
    name: "Opcija 1: ostaje u 3D-u",
    summary:
      "Tlocrt se podigne u 3D model i tako ostane. Ovo je sada na početnoj.",
    model: "stay",
  },
  {
    id: "tlocrt-3d-2",
    name: "Opcija 2: povratak na tlocrt",
    summary:
      "Tlocrt se podigne u 3D model, a nakon dvije i pol sekunde zidovi se spuste, crtež se zakrene natrag u tlocrt, a osi i kote se ponovno uključe.",
    model: "return",
  },
  {
    id: "tlocrt-3d-3",
    name: "Opcija 3: s krovom",
    summary:
      "Kad se zidovi podignu, odozgo se na njih spusti dvostrešni krov (35°), sa zabatima i crtama pokrova. Stan s krovom postaje kuća, pa zaglavlje kaže „Tlocrt kuće“ i „3D model kuće“.",
    model: "roof",
  },
];
---

<BaseLayout
  locale={locale}
  title="3D prikaz tlocrta: tri opcije | Laboratorij dizajna"
>
  <SkipLink target={MAIN_ID} label={t(locale, "skipLink")} />
  <LabBar current="tlocrt-3d" />
  <Sheet>
    <Header locale={locale} />
    <main id={MAIN_ID}>
      <Zone labelledby="opcije" select={false} class="options">
        <h1 id="opcije">3D prikaz tlocrta: tri opcije</h1>
        <p class="options__lead">
          U sve tri opcije tlocrt se iscrta kao timelapse, osi i kote se ugase,
          a crtež se zakrene i nagne u aksonometriju i iz njega se podignu
          zidovi. Razlika je u kraju. Svaki crtež se pokrene kad do njega
          skrolate, a „Iscrtaj ponovno“ ga ponavlja.
        </p>
        <ol class="options__list">
          {OPTIONS.map(({ id, name, summary }) => (
            <li>
              <a href={`#${id}`}>{name}</a>
              <p>{summary}</p>
            </li>
          ))}
        </ol>
      </Zone>
      {OPTIONS.map(({ id, name, model }) => (
        <DraftingLegend headingId={id} label={name} model={model} />
      ))}
    </main>
    <Footer locale={locale} />
  </Sheet>
</BaseLayout>

<style>
  .options {
    display: grid;
    gap: var(--space-5);
  }

  .options__lead {
    max-width: var(--measure);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  .options__list {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    margin: 0;
    padding-left: 1.25rem;
  }

  .options__list a {
    font-weight: var(--weight-strong);
  }

  .options__list p {
    margin-top: var(--space-1);
    color: var(--ink-muted);
  }
</style>
