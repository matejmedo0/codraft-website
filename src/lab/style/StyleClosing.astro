---
/**
 * The navy surface, as the closing call to action uses it: once on a page,
 * at the end (ADR 0015). The same button as on paper, with the surface's own
 * tokens. It invites a conversation and doesn't repeat the audit (ADR 0017).
 * Laid out as on Home (HomeClosing.astro, review batch 11).
 */
import Button from "../../components/ui/Button.astro";
import Zone from "../../components/ui/Zone.astro";
import { pathFor } from "../../features/i18n/urls.ts";
import { CLOSING } from "../copy.ts";
---

<Zone labelledby="zavrsni-poziv" surface="navy" class="closing">
  <div class="closing__text">
    <p class="closing__label t-label">Tamnoplava površina: završni poziv</p>
    <h2 id="zavrsni-poziv">{CLOSING.title}</h2>
    <p class="closing__lead">{CLOSING.lead}</p>
  </div>
  <Button href={pathFor("contact", "hr")} class="closing__cta">
    {CLOSING.secondary}
  </Button>
</Zone>

<style>
  .closing {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
    padding-block: calc(var(--zone-pad) * 2 / 3);
  }

  .closing__text {
    max-width: 40rem;
  }

  .closing__label {
    margin-bottom: var(--space-4);
    color: var(--ink-muted);
  }

  .closing__lead {
    max-width: var(--measure-lead);
    margin-top: var(--space-4);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  @media (min-width: 56.25rem) {
    .closing {
      flex-direction: row;
      gap: var(--gap);
      align-items: center;
      justify-content: space-between;
    }

    .closing__cta {
      flex: none;
    }
  }
</style>
