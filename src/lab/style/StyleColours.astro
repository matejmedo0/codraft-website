---
/**
 * The colour tokens: the palette, the two surfaces and the contrast of
 * every text pair the components use, computed from tokens.css.
 */
import Zone from "../../components/ui/Zone.astro";
import { contrast, formatRatio } from "../../lib/contrast.ts";
import { PALETTE, TEXT_PAIRS, tokenValue } from "./style-data.ts";

const AA_NORMAL = 4.5;
const AA_LARGE = 3;

const swatches = PALETTE.map((entry) => ({
  ...entry,
  hex: tokenValue(`color-${entry.token}`).toUpperCase(),
}));

const pairs = TEXT_PAIRS.map((pair) => {
  const ratio = contrast(
    tokenValue(`color-${pair.fg}`),
    tokenValue(`color-${pair.bg}`),
  );
  const needed = pair.large === true ? AA_LARGE : AA_NORMAL;
  return { ...pair, ratio: formatRatio(ratio), passes: ratio >= needed };
});
---

<Zone labelledby="boje" class="style-zone">
  <div class="style-zone__head">
    <h2 id="boje">Boje</h2>
    <p class="style-zone__intro">
      Tamnoplava je tinta: tekst, crte, okvir lista i gumbi. Plava je samo za
      grafiku, a za tekst postoje njezine dvije nijanse s dovoljnim kontrastom.
    </p>
    <p class="style-zone__intro">
      Komponente koriste uloge (tinta, površina, crta), pa isti gumb radi na
      papiru i na tamnoplavoj.
    </p>
  </div>

  <div class="style-zone__body">
    <section class="style-block" aria-labelledby="paleta">
      <h3 id="paleta">Paleta</h3>
      <ul class="swatches">
        {swatches.map(({ token, name, hex, use }) => (
          <li class="swatch">
            {/* SVG fill, not a style attribute: the CSP blocks those. */}
            <svg
              class="swatch__chip"
              viewBox="0 0 1 1"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <rect width="1" height="1" fill={hex} />
            </svg>
            <span class="swatch__name">{name}</span>
            <span class="swatch__value t-label">{hex}</span>
            <span class="swatch__value t-label">--color-{token}</span>
            <span class="swatch__use">{use}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="style-block" aria-labelledby="povrsine">
      <h3 id="povrsine">Dvije površine</h3>
      <div class="surfaces">
        <div class="surface">
          <p class="surface__title">Papir</p>
          <p>
            Tekst, sporedni tekst i <a href="#povrsine">poveznica</a>.
          </p>
          <p class="surface__muted">Sve stranice, sve zone osim jedne.</p>
        </div>
        <div class="surface surface-navy">
          <p class="surface__title">Tamnoplava</p>
          <p>
            Tekst, sporedni tekst i <a href="#povrsine">poveznica</a>.
          </p>
          <p class="surface__muted">Jednom na stranici: završni poziv.</p>
        </div>
      </div>
    </section>

    <section class="style-block" aria-labelledby="kontrast">
      <h3 id="kontrast">Kontrast teksta (WCAG 2.2 AA)</h3>
      <table class="style-table">
        <thead>
          <tr>
            <th scope="col">Par</th>
            <th scope="col">Omjer</th>
            <th scope="col">AA</th>
          </tr>
        </thead>
        <tbody>
          {pairs.map(({ label, ratio, passes, large }) => (
            <tr>
              <th scope="row">{label}</th>
              <td>{ratio}</td>
              <td>
                {passes ? "Prolazi" : "Ne prolazi"}
                {large === true && " (3:1, grafika)"}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="style-note">
        Bijeli tekst na plavoj ima 4,49:1 i ne prolazi, pa ga nema nigdje.
        Testovi (src/styles/tokens.test.ts) provjeravaju sve parove pri svakoj
        promjeni.
      </p>
    </section>
  </div>
</Zone>

<style>
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: var(--space-5) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .swatch {
    display: grid;
    align-content: start;
    gap: var(--space-1);
  }

  .swatch__chip {
    width: 100%;
    height: 4rem;
    margin-bottom: var(--space-2);
    border: var(--rule) solid var(--line);
    border-radius: var(--radius);
  }

  .swatch__name {
    font-weight: var(--weight-strong);
    line-height: var(--leading-title);
  }

  .swatch__value {
    color: var(--ink-muted);
  }

  .swatch__use {
    color: var(--ink-muted);
    font-size: var(--step-small);
    line-height: 1.4;
  }

  .surfaces {
    display: grid;
    gap: var(--space-4);
  }

  .surface {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: var(--rule) solid var(--frame);
    background: var(--surface);
    color: var(--ink);
  }

  .surface__title {
    font-family: var(--font-heading);
    font-size: var(--step-title);
    font-stretch: var(--width-heading);
    font-weight: var(--weight-heading);
  }

  .surface__muted {
    color: var(--ink-muted);
  }

  @media (min-width: 40rem) {
    .surfaces {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
