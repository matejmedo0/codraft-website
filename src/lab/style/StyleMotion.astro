---
/**
 * Motion: the tokens and the four moments of the direction (ADR 0015). The
 * logo entrance is in zone A; each zone's rule is selected as it arrives;
 * the steps draw their line here and can be replayed. The CAD drawing in
 * layers belongs to the home page and the drafting page (phase 3); the lab
 * shows it in hybrid D.
 */
import Button from "../../components/ui/Button.astro";
import Steps from "../../components/ui/Steps.astro";
import Zone from "../../components/ui/Zone.astro";
import { AUDIT, CAD } from "../copy.ts";
import { MOTION_TOKENS, tokenValue } from "./style-data.ts";

const tokens = MOTION_TOKENS.map((entry) => ({
  ...entry,
  value: tokenValue(entry.token),
}));
---

<Zone labelledby="kretanje" class="style-zone">
  <div class="style-zone__head">
    <h2 id="kretanje">Kretanje</h2>
    <p class="style-zone__intro">
      Svaki pokret je CAD radnja: odabir gripovima, crta koja se iscrtava, kota,
      slojevi. Svaki se igra jednom, u svom odjeljku, i nikad ne preuzima
      pomicanje stranice.
    </p>
    <p class="style-zone__intro">
      Sa smanjenim kretanjem sve je odmah gotovo: znak je cijeli, crte su
      povučene, a gripovi se pojavljuju bez povećanja.
    </p>
    <p class="motion-check">
      Na ovom računalu sustav traži smanjeno kretanje, pa se animacije ne
      igraju. U Windowsu ih uključuje: Postavke → Pristupačnost → Vizualni
      efekti → Animacijski efekti.
    </p>
  </div>

  <div class="style-zone__body">
    <section class="style-block" aria-labelledby="trenuci">
      <h3 id="trenuci">Četiri trenutka</h3>
      <ol class="moments">
        <li>
          <strong>Ulaz znaka.</strong> Samo u heroju početne (zona A ove
          stranice): crta se iscrta, pa grip sjedne na kraj. Osvježite stranicu
          da ga ponovno vidite.
        </li>
        <li>
          <strong>Prijelaz odjeljka.</strong> Kad crta zone dođe u vidno polje,
          plava crta je odabere, grip sjedne na okvir i odabir se otpusti. Slovo
          zone na margini pojavi se s gripom.
        </li>
        <li>
          <strong>Crta kroz korake.</strong> Crta raste od gripa do gripa, kao
          ispod.
        </li>
        <li>
          <strong>CAD crtež u slojevima.</strong>{" "}
          {CAD.layers.map(({ label }) => label).join(" → ")}, za 3,2 s. Pripada
          početnoj i stranici „Tehničko crtanje“ (faza 3); u labu je u{" "}
          <a href="/lab/d#cad">hibridu D</a>.
        </li>
      </ol>
    </section>

    <section class="style-block" aria-labelledby="koraci">
      <h3 id="koraci">Koraci besplatne analize</h3>
      <Steps steps={AUDIT.steps} level={4}>
        <div class="steps-replay">
          <Button variant="secondary" size="compact" data-draw-replay>
            {CAD.replay}
          </Button>
        </div>
      </Steps>
    </section>

    <section class="style-block" aria-labelledby="tokeni-kretanja">
      <h3 id="tokeni-kretanja">Tokeni</h3>
      <table class="style-table">
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Vrijednost</th>
            <th scope="col">Upotreba</th>
          </tr>
        </thead>
        <tbody>
          {tokens.map(({ token, value, use }) => (
            <tr>
              <th scope="row">
                <code>--{token}</code>
              </th>
              <td>
                <code>{value}</code>
              </td>
              <td>{use}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="style-note">
        Opruge iz motion-foundations (--ease-spring, --ease-snap) zapisane su
        kao CSS linear(); iste vrijednosti za React otoke su u
        src/styles/motion.ts.
      </p>
    </section>
  </div>
</Zone>

<style>
  .moments {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    margin: 0;
    padding-left: 1.25rem;
  }

  .steps-replay {
    display: none;
    margin-top: var(--space-6);
  }

  /* Shown only where the system asks for reduced motion. */
  .motion-check {
    display: none;
    max-width: var(--measure);
    margin-top: var(--space-5);
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--surface-sunk);
    font-size: var(--step-small);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .steps-replay {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-check {
      display: block;
    }
  }
</style>
