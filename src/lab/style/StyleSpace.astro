---
/**
 * Space, lines and shape: the spacing scale as bars, the line weights and
 * the 2 px radius of controls against the square drawing vocabulary
 * (ADR 0015).
 */
import Dimension from "../../components/ui/Dimension.astro";
import Zone from "../../components/ui/Zone.astro";
import { SHAPE_TOKENS, SPACE_TOKENS, tokenValue } from "./style-data.ts";

const REM = 16;

const space = SPACE_TOKENS.map(({ step, use }) => {
  const value = tokenValue(`space-${String(step)}`);
  const px = Number.parseFloat(value) * REM;
  return { step, use, value, px };
});

const shape = SHAPE_TOKENS.map((entry) => ({
  ...entry,
  value: tokenValue(entry.token),
}));
---

<Zone labelledby="razmaci" class="style-zone">
  <div class="style-zone__head">
    <h2 id="razmaci">Razmaci, crte i kutovi</h2>
    <p class="style-zone__intro">
      Razmaci rastu u koracima od 4 px. List ima okvir i zone; svaka zona ima
      svoje slovo na margini i crtu iznad sebe.
    </p>
    <p class="style-zone__intro">
      Gumbi, polja i ploče imaju kut od 2 px. Crtački elementi ostaju oštri:
      okvir lista, crte zona, zaglavlje nacrta i gripovi.
    </p>
  </div>

  <div class="style-zone__body">
    <section class="style-block" aria-labelledby="razmaci-skala">
      <h3 id="razmaci-skala">Razmaci</h3>
      <ul class="space">
        {space.map(({ step, use, value, px }) => (
          <li class="space__row">
            <span class="space__name t-label">--space-{step}</span>
            <span class="space__value t-label">
              {value} ({px} px)
            </span>
            <span
              class:list={["space__bar", `space__bar--${String(step)}`]}
              aria-hidden="true"
            />
            <span class="space__use">{use}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="style-block" aria-labelledby="kota">
      <h3 id="kota">Kota</h3>
      <p class="style-note">
        Kota stoji samo uz pravi broj. Ovdje mjeri pet velikih polja
        milimetarskog papira, svako od 40 px; iscrtava se jednom, kad dođe u
        vidno polje.
      </p>
      <div class="measured">
        <Dimension value="200 px" />
        <div class="measured__paper graph-paper"></div>
      </div>
    </section>

    <section class="style-block" aria-labelledby="oblik">
      <h3 id="oblik">Crte i oblik</h3>
      <div class="shapes" aria-hidden="true">
        <span class="shapes__control">Kut 2 px</span>
        <span class="shapes__grip"></span>
        <span class="shapes__rule"></span>
      </div>
      <table class="style-table">
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Vrijednost</th>
            <th scope="col">Upotreba</th>
          </tr>
        </thead>
        <tbody>
          {shape.map(({ token, value, use }) => (
            <tr>
              <th scope="row">
                <code>--{token}</code>
              </th>
              <td>
                <code>{value}</code>
              </td>
              <td>{use}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>
</Zone>

<style>
  .space {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .space__row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-1) var(--space-4);
    align-items: center;
    padding: var(--space-3) 0;
    border-top: var(--rule) solid var(--line);
  }

  .space__value,
  .space__use {
    color: var(--ink-muted);
  }

  .space__bar {
    grid-column: 2;
    height: var(--space-3);
    background: var(--accent);
  }

  .space__use {
    grid-column: 2;
    font-size: var(--step-small);
  }

  .space__bar--1 {
    width: var(--space-1);
  }

  .space__bar--2 {
    width: var(--space-2);
  }

  .space__bar--3 {
    width: var(--space-3);
  }

  .space__bar--4 {
    width: var(--space-4);
  }

  .space__bar--5 {
    width: var(--space-5);
  }

  .space__bar--6 {
    width: var(--space-6);
  }

  .space__bar--7 {
    width: var(--space-7);
  }

  .space__bar--8 {
    width: var(--space-8);
  }

  .space__bar--9 {
    width: var(--space-9);
  }

  .space__bar--10 {
    width: var(--space-10);
  }

  @media (min-width: 48rem) {
    .space__row {
      grid-template-columns: 5.5rem 8rem 5rem minmax(0, 1fr);
    }

    .space__bar,
    .space__use {
      grid-column: auto;
    }
  }

  .measured {
    display: grid;
    gap: var(--space-2);
    width: calc(var(--grid-major-size) * 5);
    margin-top: var(--space-5);
  }

  .measured__paper {
    height: calc(var(--grid-major-size) * 2);
  }

  .shapes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
    margin-bottom: var(--space-5);
  }

  .shapes__control {
    padding: var(--space-3) var(--space-5);
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius);
    font-weight: var(--weight-strong);
  }

  .shapes__grip {
    width: var(--grip-size);
    height: var(--grip-size);
    border: var(--grip-stroke) solid var(--accent);
    scale: 3;
  }

  .shapes__rule {
    flex: 1 1 6rem;
    height: var(--rail);
    background: var(--accent);
  }
</style>
