---
import "../styles/global.css";

import archivoCore from "../assets/fonts/archivo-core.woff2?url";
import { type Locale, OG_LOCALES, SITE_NAME } from "../config/site.ts";
import type { PageId } from "../features/i18n/route-map.ts";
import { alternatesFor, otherLocale, urlFor } from "../features/i18n/urls.ts";

interface Props {
  locale: Locale;
  title: string;
  /** The meta description, also used for Open Graph (G28). */
  description?: string | undefined;
  /**
   * The route-map page, for the canonical and hreflang links. The 404 pages
   * have none and are marked noindex.
   */
  page?: PageId | undefined;
  /**
   * Preload the core Archivo file (src/styles/fonts.css). Off only for lab
   * prototypes that use other fonts.
   */
  preloadFont?: boolean;
}

const { locale, title, description, page, preloadFont = true } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description !== undefined && (
      <meta name="description" content={description} />
    )}
    {preloadFont && (
      <link
        rel="preload"
        href={archivoCore}
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    {/* The brand package's head snippet (Assets/codraft-brand/web/), with
         the web copies in public/ (ADR 0014). */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0F1B2D" />
    {page ? (
      <>
        <link rel="canonical" href={urlFor(page, locale)} />
        {alternatesFor(page).map(({ hreflang, href }) => (
          <link rel="alternate" hreflang={hreflang} href={href} />
        ))}
        {/* Open Graph for link previews; the per-page image is generated
             later in phase 3 (docs/phases/3-pages.md, "OG images"). */}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:title" content={title} />
        {description !== undefined && (
          <meta property="og:description" content={description} />
        )}
        <meta property="og:url" content={urlFor(page, locale)} />
        <meta property="og:locale" content={OG_LOCALES[locale]} />
        <meta
          property="og:locale:alternate"
          content={OG_LOCALES[otherLocale(locale)]}
        />
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    {/* Page-specific head elements, such as font preloads. */}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
