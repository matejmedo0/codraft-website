---
// Every route-map page in both languages: `/`, `/en`, `/usluge`,
// `/en/services`, ... The static routes (404 pages, /api/*) take priority.
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import type { UiKey } from "../features/i18n/ui.ts";
import { t } from "../features/i18n/ui.ts";
import { staticPathsFor } from "../features/i18n/urls.ts";
import SiteLayout from "../layouts/SiteLayout.astro";
import HomeView from "../views/HomeView.astro";
import ServicesView from "../views/ServicesView.astro";

/** A page's view, which gets the locale, and its metadata (G28). */
interface PageEntry {
  view: typeof HomeView | typeof ServicesView;
  title: UiKey;
  description: UiKey;
}

export const getStaticPaths = (() =>
  // The view registry: a page is generated once it has a view. The other
  // pages exist only in the route map until phase 3 builds them.
  staticPathsFor<PageEntry>({
    home: {
      view: HomeView,
      title: "meta.home.title",
      description: "meta.home.description",
    },
    services: {
      view: ServicesView,
      title: "meta.services.title",
      description: "meta.services.description",
    },
  })) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, locale, view: entry } = Astro.props;
const { view: View, title, description } = entry;
---

<SiteLayout
  locale={locale}
  page={page}
  title={t(locale, title)}
  description={t(locale, description)}
>
  <View locale={locale} />
</SiteLayout>
