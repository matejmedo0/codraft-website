---
/**
 * Home (`/`, `/en`): rebuilt from scratch, one instruction at a time
 * (ADR 0035). Until then it holds the hero, "from draft to product"
 * (home/HomeHero.astro). The old Home is in archive/old-home/.
 */
import type { Locale } from "../config/site.ts";
import { t } from "../features/i18n/ui.ts";
import { jsonLdText, organization } from "../features/seo/structured-data.ts";
import HomeHero from "./home/HomeHero.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const structuredData = jsonLdText(
  organization({
    locale,
    description: t(locale, "meta.home.description"),
    country: t(locale, "meta.country"),
  }),
);
---

<HomeHero locale={locale} />
<script type="application/ld+json" is:inline set:html={structuredData} />
