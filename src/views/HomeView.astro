---
/**
 * Home (`/`, `/en`): rebuilt from scratch, one instruction at a time
 * (ADR 0035). Until then it holds a full-screen hero on silk waves, with
 * the headline there for screen readers and search only. The old Home is
 * in archive/old-home/.
 */
import SilkWaves from "../components/ui/SilkWaves.astro";
import type { Locale } from "../config/site.ts";
import { t } from "../features/i18n/ui.ts";
import { jsonLdText, organization } from "../features/seo/structured-data.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const structuredData = jsonLdText(
  organization({
    locale,
    description: t(locale, "meta.home.description"),
    country: t(locale, "meta.country"),
  }),
);
---

<section class="hero">
  <SilkWaves />
  <h1 class="visually-hidden">
    {t(locale, "home.hero.titleLine1")} {t(locale, "home.hero.titleLine2")}
  </h1>
</section>
<script type="application/ld+json" is:inline set:html={structuredData} />
<style>
  /* Empty for now and one screen tall. svh, so it doesn't jump when the
     mobile toolbar hides. */
  .hero {
    position: relative;
    min-height: 100svh;
  }
</style>
