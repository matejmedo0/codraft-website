---
/**
 * The team on Home (M32, M36): "Tim" in display capitals, then a
 * row of rounded cards, as in the client's reference "Torch": the two
 * people, each a tall frame with the name in capitals and the role, and a
 * third card with the note and the link to the full team on About. Until the photos arrive, each photo is a drafting
 * placeholder, a frame with its diagonals and corner grips, and a note
 * says the photos come before launch; no stock or generated people stand
 * in for the team (docs/brand.md, "Imagery"). The frames come in when the
 * zone arrives (reveal.ts).
 */
import type { Locale } from "../../config/site.ts";
import { TEAM } from "../../config/team.ts";
import { t } from "../../features/i18n/ui.ts";
import { pathFor } from "../../features/i18n/urls.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const members = TEAM.map(({ id, name }) => ({
  name,
  role: t(locale, `team.${id}.role`),
}));
---

<section class="team nh-zone" aria-labelledby="tim" data-reveal>
  <h2 class="team__title nk-display nk-title" id="tim">
    {t(locale, "home.team.title")}
  </h2>
  <ul class="team__list">
    {members.map((member) => (
      <li class="member nk-card">
        <span class="member__photo" aria-hidden="true">
          <svg
            viewBox="0 0 80 100"
            preserveAspectRatio="none"
            focusable="false"
          >
            <path d="M0 0L80 100M80 0L0 100" />
          </svg>
        </span>
        <span class="member__name nk-display">{member.name}</span>
        <span class="member__role">{member.role}</span>
      </li>
    ))}
    <li class="team__aside nk-card">
      <p class="team__note">{t(locale, "home.team.pending")}</p>
      <a class="team__more" href={pathFor("about", locale)}>
        {t(locale, "home.team.more")}
      </a>
    </li>
  </ul>
  <script>
    import "./reveal.ts";
  </script>
</section>

<style>
  .team__note {
    color: var(--ink-muted);
  }

  .team__more {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--ink);
    font-weight: var(--weight-medium);
  }

  .team__aside {
    display: grid;
    gap: var(--space-3);
    align-content: end;
    padding: var(--space-6);
  }

  .team__list {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .member {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-5) var(--space-6);
  }

  .member__photo {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    margin-bottom: var(--space-3);
    border: var(--rule) solid var(--line);
    background: var(--surface-sunk);
  }

  /* The frame's corner grips. */
  .member__photo::before,
  .member__photo::after {
    position: absolute;
    width: 0.625rem;
    height: 0.625rem;
    border: var(--grip-stroke) solid var(--accent);
    background: var(--grip-fill);
    content: "";
  }

  .member__photo::before {
    top: -0.3125rem;
    left: -0.3125rem;
  }

  .member__photo::after {
    right: -0.3125rem;
    bottom: -0.3125rem;
  }

  .member__photo svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .member__photo path {
    fill: none;
    stroke: var(--line);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .member__name {
    font-size: var(--nk-row);
    line-height: 1;
  }

  .member__role {
    color: var(--ink-muted);
  }

  @media (min-width: 48rem) {
    .team__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .team__aside {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .team__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }

    .team__aside {
      grid-column: auto;
    }
  }

  .team.is-pending :is(.team__title, .member, .team__aside) {
    opacity: 0;
  }

  .team.is-in .team__title {
    animation: nk-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .team.is-in .member {
    animation: nk-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) 250ms both;
  }

  .team.is-in .team__aside {
    animation: nk-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) 540ms both;
  }

  .team.is-in .member:nth-child(2) {
    animation-delay: 400ms;
  }
</style>
