---
/**
 * The floor plan in Home's drafting zone (the client's review, batch 5;
 * ADR 0018: architecture and construction only). A small house, drawn like
 * a timelapse of drafting: once half of it is in view (draw.ts), its
 * elements appear one by one, each wiped in along its own direction, layer
 * after layer: axes, walls, openings, dimensions, title block. The layer
 * list switches on in step and "Iscrtaj ponovno" replays it.
 * plan-timelapse.ts times the steps.
 *
 * The finished plan then rises into a 3D view (review #58): the axes and
 * dimensions switch off, the plan turns and tilts back into an axonometric
 * view, and the walls rise from it, with the windows, lintels and door
 * leaves (plan-model.ts, in the projection of plan-projection.ts). A pitched
 * roof comes down onto the walls (review #64), in the client's palette 1: a
 * paper facade under a navy roof (review #66). The lab keeps the other
 * endings and palettes as the record (`/lab/tlocrt-3d`, `/lab/kuca-boje`).
 *
 * Without JavaScript, or with reduced motion, the drawing is complete: the
 * 3D view, with a button that switches to the plan (review #117).
 *
 * It is an illustration, not client work, and its title block says so
 * (ADR 0004). Units: 1 = 10 cm; the house is 1000 × 700 cm. Colours come
 * from the surface's drawing tokens; thin lines don't scale.
 *
 * A class passed in gets the parent's scoped styles, so a zone can place
 * the drawing and its layer list in its own grid.
 */
import type { HTMLAttributes } from "astro/types";

import Button from "../../../components/ui/Button.astro";
import { type Locale, SITE_NAME } from "../../../config/site.ts";
import { t } from "../../../features/i18n/ui.ts";
import {
  DOORS,
  modelFaces,
  type Rect,
  roofDrawing,
  WALLS,
  WINDOWS,
} from "./plan-model.ts";
import { ROOF_VIEW, viewTransform } from "./plan-projection.ts";

type Wipe = "x" | "y";

/** A step wipes in along the longer side of its rectangle. */
function wipeOf([, , width, depth]: Rect): Wipe {
  return width >= depth ? "x" : "y";
}

/** A window in the plan: the wall's two faces and the glass between. */
function windowPath([x, y, width, depth]: Rect): string {
  const n = (value: number): string => String(value);
  const [x1, y1] = [x + width, y + depth];
  return width >= depth
    ? `M${n(x)} ${n(y)}H${n(x1)}M${n(x)} ${n(y + depth / 2)}H${n(x1)}M${n(x)} ${n(y1)}H${n(x1)}M${n(x)} ${n(y)}V${n(y1)}M${n(x1)} ${n(y)}V${n(y1)}`
    : `M${n(x)} ${n(y)}V${n(y1)}M${n(x + width / 2)} ${n(y)}V${n(y1)}M${n(x1)} ${n(y)}V${n(y1)}M${n(x)} ${n(y)}H${n(x1)}M${n(x)} ${n(y1)}H${n(x1)}`;
}

/** Grid axes on the walls' centre lines, with their bubbles. */
const COLUMNS = [
  { at: 1.5, label: "1" },
  { at: 60, label: "2" },
  { at: 98.5, label: "3" },
];
const ROWS = [
  { at: 1.5, label: "A" },
  { at: 40, label: "B" },
  { at: 68.5, label: "C" },
];

interface Props extends HTMLAttributes<"div"> {
  locale: Locale;
  /** Prefixes the drawing's ids, so a page can show it more than once. */
  idPrefix?: string;
}

const {
  locale,
  idPrefix = "plan",
  class: className,
  ...attributes
} = Astro.props;
const drawingId = `${idPrefix}-crtez`;
const layersId = `${idPrefix}-slojevi`;

const faces = modelFaces(ROOF_VIEW);
const roof = roofDrawing(ROOF_VIEW);
// In drawing order (docs/motion.md, "Layers"), the roof before the title
// block (review #63).
const layers = [
  { id: "osi", label: t(locale, "drawing.layer.axes") },
  { id: "zidovi", label: t(locale, "drawing.layer.walls") },
  { id: "otvori", label: t(locale, "drawing.layer.openings") },
  { id: "kote", label: t(locale, "drawing.layer.dimensions") },
  { id: "krov", label: t(locale, "drawing.layer.roof") },
  { id: "zaglavlje", label: t(locale, "drawing.layer.titleBlock") },
];
const titleBlock = {
  plan: t(locale, "drawing.titlePlan"),
  model: t(locale, "drawing.titleModel"),
  units: t(locale, "drawing.units"),
  studio: SITE_NAME,
  note: t(locale, "drawing.note"),
};
const showPlan = t(locale, "drawing.showPlan");
const showModel = t(locale, "drawing.showModel");
---

<div
  class:list={[
    "plan",
    "plan--model",
    "plan--ends-3d",
    "plan--roof",
    "plan--palette-navy-roof",
    className,
  ]}
  data-draw="half"
  data-draw-steady
  data-plan
  {...attributes}
>
  <div class="plan__sheet graph-paper">
    <svg
      class="plan__drawing"
      viewBox="-21 -21 125 110"
      role="img"
      aria-labelledby={drawingId}
      focusable="false"
    >
      <title id={drawingId}>{t(locale, "drawing.label")}</title>

      <g
        class="plan__ground"
        data-plan-ground
        transform={viewTransform(ROOF_VIEW, "svg")}
      >
        <rect class="plan-floor" x="0" y="0" width="100" height="70" />

        <g data-layer="osi">
          {COLUMNS.map(({ at, label }) => (
            <g data-wipe="y">
              <path class="plan-axis" d={`M${String(at)} -14V73`} />
              <circle class="plan-bubble" cx={at} cy="-17" r="3" />
              <text class="plan-bubble__label" x={at} y="-17">
                {label}
              </text>
            </g>
          ))}
          {ROWS.map(({ at, label }) => (
            <g data-wipe="x">
              <path class="plan-axis" d={`M-14 ${String(at)}H103`} />
              <circle class="plan-bubble" cx="-17" cy={at} r="3" />
              <text class="plan-bubble__label" x="-17" y={at}>
                {label}
              </text>
            </g>
          ))}
        </g>

        <g data-layer="zidovi">
          {WALLS.map((wall) => {
            const [x, y, width, depth] = wall;
            return (
              <rect
                class="plan-wall"
                x={x}
                y={y}
                width={width}
                height={depth}
                data-wipe={wipeOf(wall)}
              />
            );
          })}
        </g>

        <g data-layer="otvori">
          <g class="plan-windows">
            {WINDOWS.map((opening) => (
              <path
                class="plan-window"
                d={windowPath(opening)}
                data-wipe={wipeOf(opening)}
              />
            ))}
          </g>
          {DOORS.map(({ leaf, swing }) => (
            <g data-wipe="fade">
              <path
                class="plan-door"
                d={`M${leaf.from.join(" ")}L${leaf.to.join(" ")}`}
              />
              <path class="plan-swing" d={swing} />
            </g>
          ))}
        </g>

        <g data-layer="kote">
          <g data-wipe="x">
            <path
              class="plan-dim"
              d="M0 -1V-11M60 -1V-11M100 -1V-11M0 -5H100"
            />
            <path class="plan-dim" d="M-1 -4L1 -6M59 -4L61 -6M99 -4L101 -6" />
            <text class="plan-dim__text" x="30" y="-6">
              600
            </text>
            <text class="plan-dim__text" x="80" y="-6">
              400
            </text>
          </g>
          <g data-wipe="x">
            <path class="plan-dim" d="M0 -10H100M-1 -9L1 -11M99 -9L101 -11" />
            <text class="plan-dim__text" x="50" y="-11">
              1000
            </text>
          </g>
          <g data-wipe="y">
            <path class="plan-dim" d="M-1 0H-11M-1 40H-11M-1 70H-11M-5 0V70" />
            <path class="plan-dim" d="M-6 1L-4 -1M-6 41L-4 39M-6 71L-4 69" />
            <text
              class="plan-dim__text"
              x="-6"
              y="20"
              transform="rotate(-90 -6 20)"
            >
              400
            </text>
            <text
              class="plan-dim__text"
              x="-6"
              y="55"
              transform="rotate(-90 -6 55)"
            >
              300
            </text>
          </g>
          <g data-wipe="y">
            <path class="plan-dim" d="M-10 0V70M-11 1L-9 -1M-11 71L-9 69" />
            <text
              class="plan-dim__text"
              x="-11"
              y="35"
              transform="rotate(-90 -11 35)"
            >
              700
            </text>
          </g>
        </g>
      </g>

      <g class="plan__model">
        {faces.map((face) =>
          face.type === "side" ? (
            <g transform={face.matrix}>
              <rect
                class:list={[
                  "model-side",
                  `model-side--${face.facing}`,
                  `model--${face.kind}`,
                  { "model-side--outer": face.outer },
                ]}
                x="0"
                y={face.z0}
                width="1"
                height={face.z1 - face.z0}
              />
            </g>
          ) : (
            <polygon
              class:list={["model-top", `model--${face.kind}`]}
              points={face.points}
              data-rise={face.rise}
            />
          ),
        )}
      </g>

      <g class="plan__roof">
        {roof.faces.map(({ kind, shade, points }) => (
          <polygon
            class:list={[
              "roof-face",
              `roof-face--${kind}`,
              { "roof-face--shade": shade },
            ]}
            points={points}
          />
        ))}
        <path class="roof-hatch" d={roof.hatch} />
      </g>

      <g data-layer="zaglavlje">
        <g data-wipe="fade">
          <path class="plan-frame" d="M54 75H100V87H54ZM54 81H100M84 75V87" />
          <text
            class="plan-cell plan-cell--strong plan-title"
            x="55.5"
            y="79.2"
          >
            {titleBlock.plan}
          </text>
          <text
            class="plan-cell plan-cell--strong plan-title--model"
            x="55.5"
            y="79.2"
          >
            {titleBlock.model}
          </text>
          <text class="plan-cell" x="85.5" y="79.2">
            {titleBlock.units}
          </text>
          <text class="plan-cell plan-cell--strong" x="55.5" y="85.2">
            {titleBlock.studio}
          </text>
          <text class="plan-cell" x="85.5" y="85.2">
            {titleBlock.note}
          </text>
        </g>
      </g>
    </svg>

    <div class="plan__title-block" data-layer="zaglavlje" aria-hidden="true">
      <div class="plan__title-cells t-label" data-wipe="fade">
        <span class="plan__title-cell plan__title-cell--title">
          <span class="plan-title">{titleBlock.plan}</span>
          <span class="plan-title--model">{titleBlock.model}</span>
        </span>
        <span class="plan__title-cell">{titleBlock.units}</span>
        <span class="plan__title-cell plan__title-cell--strong">
          {titleBlock.studio}
        </span>
        <span class="plan__title-cell">{titleBlock.note}</span>
      </div>
    </div>
  </div>

  <div class="plan__toolbar">
    <p class="plan__layers-label t-label" id={layersId}>
      {t(locale, "drawing.layers")}
    </p>
    <ol class="plan__layers" aria-labelledby={layersId}>
      {layers.map(({ id, label }) => (
        <li class="plan__layer" data-lamp={id}>
          <span class="plan__lamp" aria-hidden="true" />
          {label}
        </li>
      ))}
    </ol>
    <Button
      variant="secondary"
      size="compact"
      class="plan__replay"
      data-draw-replay
    >
      {t(locale, "drawing.replay")}
    </Button>
    <Button
      variant="secondary"
      size="compact"
      class="plan__view"
      data-plan-view
      data-plan-label={showPlan}
      data-model-label={showModel}
    >
      <span data-plan-view-label>{showPlan}</span>
    </Button>
  </div>

  <script>
    import "../../../components/ui/draw.ts";
    import "./plan-timelapse.ts";
  </script>
</div>

<style>
  /* The sheet is a container: the title block follows its width. */
  .plan__sheet {
    padding: var(--space-5) var(--space-4);
    container: plan-sheet / inline-size;
  }

  .plan__drawing {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Line work: thin lines keep their weight at every size. */
  .plan__drawing :is(path, circle) {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .plan__drawing .plan-axis {
    stroke: var(--drawing-muted);
    stroke-width: 1px;
    stroke-dasharray: 6 2 1 2;
  }

  .plan__drawing .plan-bubble {
    fill: var(--drawing-fill);
    stroke: var(--drawing-ink);
    stroke-width: 1px;
  }

  .plan-wall {
    fill: var(--drawing-ink);
  }

  .plan__drawing :is(.plan-window, .plan-frame) {
    stroke: var(--drawing-ink);
    stroke-width: 1px;
  }

  .plan__drawing .plan-door {
    stroke: var(--drawing-ink);
    stroke-width: 1.5px;
  }

  .plan__drawing .plan-swing {
    stroke: var(--drawing-muted);
    stroke-width: 1px;
  }

  /* The 3D view (review #58). The tops of the walls and lintels are where
     the model is cut, so they keep the plan's solid ink; every other face
     is paper, the sides facing along x a shade darker, and the glass a
     tint of the accent. The house's colours are variables, which the
     palette below sets. */
  .plan--model {
    --model-shade: color-mix(
      in srgb,
      var(--drawing-ink) 9%,
      var(--drawing-fill)
    );
    --facade: var(--drawing-fill);
    --facade-shade: var(--model-shade);
    --facade-line: var(--drawing-ink);
    --roof: var(--drawing-fill);
    --roof-shade: var(--model-shade);
    --roof-line: var(--drawing-muted);
    --glass: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .plan__drawing
    :is(
      .plan-floor,
      .plan__model rect,
      .plan__model polygon,
      .plan__roof polygon
    ) {
    fill: var(--drawing-fill);
    stroke: var(--drawing-ink);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  /* Two line weights, as in a drafted axonometric (critique 15): the
     building's mass, its outer walls and its roof, at 1.5 px; the details
     (the rooms, windows, glass and roofing) stay at 1 px. */
  .plan__drawing
    :is(
      .plan__model .model-side--outer:not(.model--glass),
      .plan__roof polygon
    ) {
    stroke-width: 1.5px;
  }

  .plan__drawing .plan__model .model-side--x {
    fill: var(--model-shade);
  }

  .plan__drawing .plan__model .model-side--outer {
    fill: var(--facade);
    stroke: var(--facade-line);
  }

  .plan__drawing .plan__model .model-side--outer.model-side--x,
  .plan__drawing .plan__roof .roof-face--gable {
    fill: var(--facade-shade);
    stroke: var(--facade-line);
  }

  .plan__drawing .plan__roof :is(.roof-face--slope, .roof-face--edge) {
    fill: var(--roof);
  }

  .plan__drawing
    .plan__roof
    .roof-face--shade:is(.roof-face--slope, .roof-face--edge) {
    fill: var(--roof-shade);
  }

  /* The roofing: lines down the slopes, like a hatch. */
  .plan__drawing .roof-hatch {
    stroke: var(--roof-line);
    stroke-width: 1px;
  }

  .plan__drawing .model-top:is(.model--wall, .model--lintel) {
    fill: var(--drawing-ink);
  }

  .plan__drawing .plan__model .model--glass {
    fill: var(--glass);
    stroke: var(--accent);
  }

  .plan__drawing .plan__model .model-top.model--glass {
    fill: var(--accent);
  }

  /* The house's palette, the client's palette 1 (review #66): a paper
     facade under a navy roof, like slate, its lines lighter; mixed from the
     drawing's roles. */
  .plan--palette-navy-roof {
    --roof: color-mix(in srgb, var(--drawing-ink) 86%, var(--drawing-fill));
    --roof-shade: var(--drawing-ink);
    --roof-line: color-mix(
      in srgb,
      var(--drawing-fill) 38%,
      var(--drawing-ink)
    );
  }

  .plan__drawing .plan-dim {
    stroke: var(--accent);
    stroke-width: 1px;
  }

  /* Lettering, in the drawing's units: 1 = 10 cm. */
  .plan__drawing text {
    font-stretch: var(--width-label);
  }

  .plan-bubble__label {
    fill: var(--drawing-ink);
    font-size: 2.6px;
    font-weight: var(--weight-strong);
    text-anchor: middle;
    dominant-baseline: central;
  }

  .plan-dim__text {
    fill: var(--accent-text);
    font-size: 2.4px;
    font-weight: var(--weight-medium);
    text-anchor: middle;
  }

  .plan-cell {
    fill: var(--drawing-ink);
    font-size: 2.3px;
  }

  .plan-cell--strong {
    font-weight: var(--weight-strong);
  }

  /* The drawn title block shrinks with the drawing: about 5 px letters on
     phones (critique 16), about 8 px where the drafting zone is two narrow
     columns (the re-check, #130). Where the drawing is under 37.5rem wide
     (its letters under about 11 px) it is set under the drawing at the
     label size, in the same cells, and the drawn one is off. It is the same layer: the timelapse fades it in with the
     drawn one. */
  .plan__title-block {
    display: none;
  }

  @container plan-sheet (max-width: 37.49rem) {
    .plan__drawing [data-layer="zaglavlje"] {
      display: none;
    }

    .plan__title-block {
      display: block;
      margin-top: var(--space-3);
    }
  }

  .plan__title-cells {
    display: grid;
    grid-template-columns: auto auto;
    width: fit-content;
    margin-left: auto;
    border: 1px solid var(--drawing-ink);
    background: var(--drawing-fill);
    color: var(--drawing-ink);
    line-height: 1.2;
  }

  .plan__title-cell {
    padding: 0.3125rem 0.5rem;
  }

  .plan__title-cell:nth-child(odd) {
    border-right: 1px solid var(--drawing-ink);
  }

  .plan__title-cell:nth-child(-n + 2) {
    border-bottom: 1px solid var(--drawing-ink);
  }

  .plan__title-cell--strong,
  .plan__title-cell--title {
    font-weight: var(--weight-strong);
  }

  /* The plan's title and the model's share their cell, as in the drawing. */
  .plan__title-cell--title {
    display: grid;
  }

  .plan__title-cell--title > * {
    grid-area: 1 / 1;
  }

  /* The layer list, like a CAD layer manager: a lamp per layer. */
  .plan__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) 1.25rem;
    align-items: center;
    margin-top: var(--space-4);
  }

  .plan__layers-label {
    color: var(--ink-muted);
  }

  .plan__layers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem var(--space-4);
    margin: 0;
    padding: 0;
    font-size: var(--step-small);
    list-style: none;
  }

  .plan__layer {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }

  /* Each lamp is a short sample of its layer's own line, as a CAD layer
     manager shows a linetype. A layer that is off keeps a faint sample and
     its name in grey. The list shows the layers' state; it is not a
     control (critique 3). */
  .plan__lamp {
    --lamp: var(--drawing-ink);

    position: relative;
    flex: none;
    width: 1.25rem;
    height: var(--lamp-height, 2px);
  }

  .plan__lamp::before,
  .plan__lamp::after {
    position: absolute;
    inset: 0;
    background: var(--lamp);
    box-shadow: var(--lamp-edge, none);
    content: "";
  }

  .plan__lamp::before {
    opacity: 0.25;
  }

  .plan__lamp::after {
    transform-origin: left center;
  }

  /* The axes: a chain line, as in the drawing (6 2 1 2). */
  [data-lamp="osi"] .plan__lamp {
    --lamp: repeating-linear-gradient(
      90deg,
      var(--drawing-muted) 0 6px,
      transparent 6px 8px,
      var(--drawing-muted) 8px 9px,
      transparent 9px 11px
    );
    --lamp-height: 1px;
  }

  /* The walls: solid ink. */
  [data-lamp="zidovi"] .plan__lamp {
    --lamp-height: 3px;
  }

  /* The openings: a window's two thin lines. */
  [data-lamp="otvori"] .plan__lamp {
    --lamp:
      linear-gradient(var(--drawing-ink) 0 0) top / 100% 1px no-repeat,
      linear-gradient(var(--drawing-ink) 0 0) bottom / 100% 1px no-repeat;
    --lamp-height: 5px;
  }

  /* The dimensions: a dimension line in the accent, with its ticks. */
  [data-lamp="kote"] .plan__lamp {
    --lamp:
      linear-gradient(var(--accent) 0 0) center / 100% 1px no-repeat,
      linear-gradient(var(--accent) 0 0) left / 1px 100% no-repeat,
      linear-gradient(var(--accent) 0 0) right / 1px 100% no-repeat;
    --lamp-height: 7px;
  }

  /* The roof: its colour, edged in ink. */
  [data-lamp="krov"] .plan__lamp {
    --lamp: var(--roof);
    --lamp-edge: inset 0 0 0 1px var(--drawing-ink);
    --lamp-height: 6px;
  }

  /* The title block: a frame with a cell. */
  [data-lamp="zaglavlje"] .plan__lamp {
    --lamp: linear-gradient(var(--drawing-ink) 0 0) 60% 0 / 1px 100% no-repeat;
    --lamp-edge: inset 0 0 0 1px var(--drawing-ink);
    --lamp-height: 8px;
  }

  /* Replaying needs the script and motion. */
  .plan__toolbar .plan__replay {
    display: none;
    margin-left: auto;
  }

  :global(.js) .plan__toolbar .plan__replay {
    display: inline-flex;
  }

  /* The switch between the 3D view and the plan is for reduced motion,
     where the replay is off (critique 12). */
  .plan__toolbar .plan__view {
    display: none;
    margin-left: auto;
  }

  /* The timelapse. Before it starts every step and lamp is off; each step
     wipes in along its own direction, or fades in. A wiping step is also
     hidden until its own start, so the clip's open edge never leaves a
     hairline on the sheet (critique 11). */
  .plan.is-pending [data-wipe="x"] {
    clip-path: inset(-3px 100% -3px -3px);
    opacity: 0;
  }

  .plan.is-pending [data-wipe="y"] {
    clip-path: inset(-3px -3px 100% -3px);
    opacity: 0;
  }

  .plan.is-pending [data-wipe="fade"] {
    opacity: 0;
  }

  .plan.is-pending .plan__lamp::after {
    opacity: 0;
    scale: 0 1;
  }

  .plan.is-pending .plan__layer {
