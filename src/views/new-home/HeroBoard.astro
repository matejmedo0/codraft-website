---
/**
 * The board beside the hero's text (M36, after the client's reference
 * "Torch"; more detail in M40): a rounded panel of four small drawings,
 * one per thing the studio does, in the order of the page, each with a
 * file name in its corner: the site's map as page thumbnails (planning),
 * code with its line numbers and caret (building), visits rising after
 * launch against the line before it, with a grip per update (running), a
 * floor plan with windows, doors and dimensions (drafting). They draw on
 * load, one after the other; with reduced motion they are complete.
 * Decorative, so hidden from assistive technology: the hero's text says it
 * all. The file names are placeholders, the same in both languages.
 */

/** A page thumbnail in the site map: frame, navigation, hero, text. */
const page = (x: number, y: number, w: number, h: number) => ({
  frame: `M${String(x)} ${String(y)}h${String(w)}v${String(h)}h${String(-w)}z`,
  nav: `M${String(x)} ${String(y + 5)}h${String(w)}`,
  block: { x: x + 4, y: y + 8, width: w * 0.42, height: h * 0.3 },
  lines: `M${String(x + 6 + w * 0.42)} ${String(y + 10)}h${String(w * 0.36)}M${String(x + 6 + w * 0.42)} ${String(y + 14)}h${String(w * 0.24)}M${String(x + 4)} ${String(y + h - 5)}h${String(w - 8)}`,
});

const ROOT = page(76, 18, 48, 28);
const PAGES = [20, 80, 140].map((x) => page(x, 68, 40, 26));
const SUBPAGES = [57, 89, 121].map((x) => page(x, 112, 22, 16));

/** The code: per row its indent and its tag, attribute and text widths. */
const CODE = [
  { x: 0, tag: 18 },
  { x: 10, tag: 12, attr: 16, text: 30 },
  { x: 10, tag: 12, text: 54 },
  { x: 0, tag: 20 },
  { x: 0, tag: 24, attr: 18 },
  { x: 10, tag: 10, text: 66 },
  { x: 10, tag: 10, attr: 14, text: 28 },
  { x: 0, tag: 26 },
];

/** Visits after launch, and the line before it, faint. */
const AFTER: [number, number][] = [
  [28, 104],
  [56, 96],
  [84, 100],
  [112, 78],
  [140, 70],
  [168, 40],
];
const BEFORE = "M28 108L56 106L84 109L112 104L140 106L168 102";
const line = `M${AFTER.map((point) => point.join(" ")).join("L")}`;
const area = `${line}V120H28Z`;
---

<div class="board nk-card" aria-hidden="true">
  <svg class="cell nk-panel" viewBox="0 0 200 150" fill="none">
    <text class="cap" x="10" y="13">
      sitemap.xml
    </text>
    <g class="s1">
      <path class="ink" d={ROOT.frame} pathLength="1"></path>
      <path class="faint" d={ROOT.nav} pathLength="1"></path>
      <rect class="fill" {...ROOT.block}></rect>
      <path class="faint" d={ROOT.lines} pathLength="1"></path>
    </g>
    <path
      class="muted s2"
      d="M100 46V58M40 58H160M40 58V68M100 58V68M160 58V68"
      pathLength="1"
    ></path>
    <rect class="grip grip--small s2" x="98" y="56" width="4" height="4"></rect>
    {PAGES.map((thumb) => (
      <g class="s3">
        <path class="ink" d={thumb.frame} pathLength="1" />
        <path class="faint" d={thumb.nav} pathLength="1" />
        <rect class="fill" {...thumb.block} />
        <path class="faint" d={thumb.lines} pathLength="1" />
      </g>
    ))}
    <path
      class="muted s4"
      d="M100 94V104M68 104H132M68 104V112M100 104V112M132 104V112"
      pathLength="1"
    ></path>
    {SUBPAGES.map((thumb) => (
      <g class="s4">
        <path class="muted" d={thumb.frame} pathLength="1" />
        <path class="faint" d={thumb.nav} pathLength="1" />
      </g>
    ))}
  </svg>

  <svg class="cell code nk-panel" viewBox="0 0 200 150" fill="none">
    <text class="cap" x="10" y="13">
      index.html
    </text>
    {CODE.map((row, index) => {
      const y = 28 + index * 14;
      const x = 34 + row.x;
      const attrAt = x + row.tag + 4;
      const textAt = attrAt + (row.attr === undefined ? 0 : row.attr + 4);
      return (
        <g>
          <text class="num" x="20" y={y + 4.5}>
            {index + 1}
          </text>
          <rect class="tag" x={x} y={y} width={row.tag} height="5" rx="2.5" />
          {row.attr !== undefined && (
            <rect
              class="attr"
              x={attrAt}
              y={y}
              width={row.attr}
              height="5"
              rx="2.5"
            />
          )}
          {row.text !== undefined && (
            <rect
              class="txt"
              x={textAt}
              y={y}
              width={row.text}
              height="5"
              rx="2.5"
            />
          )}
        </g>
      );
    })}
    <rect class="caret" x="64" y="125" width="1.5" height="9"></rect>
  </svg>

  <svg class="cell nk-panel" viewBox="0 0 200 150" fill="none">
    <text class="cap" x="10" y="13">
      analytics
    </text>
    <path class="faint s1" d="M20 50H184M20 80H184" pathLength="1"></path>
    <path
      class="muted s1"
      d="M20 24V120H184M16 50h4M16 80h4M16 110h4M56 120v4M84 120v4M112 120v4M140 120v4M168 120v4"
      pathLength="1"
    ></path>
    <path class="muted dashed s2" d={BEFORE}></path>
    <path class="area s3" d={area}></path>
    <path class="accent wide s2" d={line} pathLength="1"></path>
    <rect class="grip s3" x="164" y="36" width="8" height="8"></rect>
    <rect class="grip s2" x="53.5" y="131" width="5" height="5"></rect>
    <rect class="grip s3" x="81.5" y="131" width="5" height="5"></rect>
    <rect class="grip s3" x="109.5" y="131" width="5" height="5"></rect>
    <rect class="grip s4" x="137.5" y="131" width="5" height="5"></rect>
  </svg>

  <svg class="cell nk-panel" viewBox="0 0 200 150" fill="none">
    <text class="cap" x="10" y="13">
      plan.dwg
    </text>
    <path
      class="ink wall s1"
      d="M90 128H30V98M30 70V40H52M80 40H122M150 40H170V128H110"
      pathLength="1"
    ></path>
    <path
      class="ink thin s2"
      d="M52 38.5H80M52 41.5H80M122 38.5H150M122 41.5H150M28.5 70V98M31.5 70V98"
      pathLength="1"
    ></path>
    <path
      class="ink s2"
      d="M110 40V76M110 92V128M110 92H128M144 92H170"
      pathLength="1"
    ></path>
    <path
      class="muted s3"
      d="M90 128V108M90 108A20 20 0 0 1 110 128M128 92V76M128 76A16 16 0 0 1 144 92"
      pathLength="1"
    ></path>
    <path
      class="muted thin s3"
      d="M30 24H170M30 20v14M170 20v14M27 27L33 21M167 27L173 21M184 40V128M178 40H190M178 128H190M181 43L187 37M181 131L187 125"
      pathLength="1"
    ></path>
    <rect class="grip s4" x="166" y="20" width="8" height="8"></rect>
  </svg>
</div>

<style>
  .board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    padding: var(--space-3);
  }

  .cell {
    display: block;
    width: 100%;
    height: auto;
  }

  path {
    stroke-width: 1.5;
    stroke-linecap: square;
  }

  .ink {
    stroke: var(--drawing-ink);
  }

  .muted {
    stroke: var(--drawing-muted);
  }

  .faint {
    stroke: var(--line);
  }

  .thin {
    stroke-width: 1;
  }

  .dashed {
    stroke-dasharray: 3 3;
  }

  .accent {
    stroke: var(--accent);
  }

  .wide {
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  .wall {
    stroke-width: 3.5;
  }

  .area {
    fill: color-mix(in srgb, var(--accent) 14%, transparent);
    stroke: none;
  }

  .fill {
    fill: var(--line);
  }

  .grip {
    fill: var(--grip-fill);
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .grip--small {
    stroke-width: 1;
  }

  .tag {
    fill: var(--accent);
  }

  .attr {
    fill: color-mix(in srgb, var(--accent) 45%, var(--drawing-ink));
  }

  .txt {
    fill: var(--drawing-muted);
  }

  .caret {
    fill: var(--accent);
  }

  text {
    font-family: var(--nk-mono);
  }

  .cap {
    fill: var(--drawing-muted);
    font-size: 7px;
    letter-spacing: 0.04em;
  }

  .num {
    fill: var(--drawing-muted);
    font-size: 6px;
    text-anchor: end;
  }

  @media (min-width: 48rem) {
    .board {
      gap: var(--space-4);
      padding: var(--space-5);
    }
  }

  /* Drawn on load, cell after cell, each in its steps (s1-s4): strokes run
     along their paths, the code's lines type in, fills and grips come in;
     then the caret blinks. */
  @media (prefers-reduced-motion: no-preference) {
    .cell:nth-child(1) {
      --cell: 900ms;
    }

    .cell:nth-child(2) {
      --cell: 1400ms;
    }

    .cell:nth-child(3) {
      --cell: 1900ms;
    }

    .cell:nth-child(4) {
      --cell: 2400ms;
    }

    .s2 {
      --step: 300ms;
    }

    .s3 {
      --step: 600ms;
    }

    .s4 {
      --step: 900ms;
    }

    [pathLength] {
      stroke-dasharray: 1;
      animation: nh-stroke 650ms var(--ease-pen) both;
      animation-delay: calc(var(--cell) + var(--step, 0ms));
    }

    :is(.cap, .fill, .area, .dashed) {
      animation: board-fade 500ms var(--ease-standard) both;
      animation-delay: calc(var(--cell) + var(--step, 0ms) + 200ms);
    }

    .cap {
      animation-delay: var(--cell);
    }

    .grip {
      transform-box: fill-box;
      transform-origin: 50% 50%;
      animation: motion-snap-in var(--motion-snap) var(--ease-snap) both;
      animation-delay: calc(var(--cell) + 300ms + var(--step, 0ms));
    }

    .code g :is(.tag, .attr, .txt) {
      transform-box: fill-box;
      transform-origin: 0 50%;
      animation: board-type 260ms var(--ease-standard) both;
      animation-delay: calc(var(--cell) + var(--row, 0) * 110ms);
    }

    .code .num {
      animation: board-fade 200ms linear both;
      animation-delay: calc(var(--cell) + var(--row, 0) * 110ms);
    }

    .code g:nth-child(3) {
      --row: 1;
    }

    .code g:nth-child(4) {
      --row: 2;
    }

    .code g:nth-child(5) {
      --row: 3;
    }

    .code g:nth-child(6) {
      --row: 4;
    }

    .code g:nth-child(7) {
      --row: 5;
    }

    .code g:nth-child(8) {
      --row: 6;
    }

    .code g:nth-child(9) {
      --row: 7;
    }

    .caret {
      animation: board-blink 1s steps(1, end) calc(var(--cell) + 900ms) infinite;
    }
  }

  @keyframes board-type {
    from {
      scale: 0 1;
    }

    to {
      scale: 1 1;
    }
  }

  @keyframes board-fade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes board-blink {
    50% {
      opacity: 0;
    }
  }
</style>
