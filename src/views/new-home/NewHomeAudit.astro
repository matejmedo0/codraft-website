---
/**
 * The free audit on the new Home, the page's one ivory band (M32), set in
 * the page as a rounded card (M36, after the client's reference): the
 * title in display capitals across the band, the lead and the page's one
 * "Rezervirajte besplatnu analizu" beside the three steps (form → time
 * slot → confirmation). The steps are grips joined by a drafting line,
 * numbered in the monospace; they come in once when the band arrives
 * (reveal.ts), the line drawn from grip to grip. Without JavaScript, or
 * with reduced motion, all of it is there.
 */
import Button from "../../components/ui/Button.astro";
import type { Locale } from "../../config/site.ts";
import { t } from "../../features/i18n/ui.ts";
import { pathFor } from "../../features/i18n/urls.ts";
import TwoTone from "./TwoTone.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const steps = (["form", "slot", "confirmation"] as const).map((step) => ({
  title: t(locale, `audit.step.${step}.title`),
  body: t(locale, `audit.step.${step}.body`),
}));
---

<section class="audit nk-inverse" aria-labelledby="analiza" data-reveal>
  <h2 class="audit__title nk-display nk-title" id="analiza">
    <TwoTone text={t(locale, "home.audit.title")} />
  </h2>
  <div class="audit__body">
    <div class="audit__text">
      <p class="audit__lead">{t(locale, "home.audit.lead")}</p>
      <div class="audit__actions">
        <Button href={pathFor("audit", locale)}>
          {t(locale, "audit.cta")}
        </Button>
      </div>
    </div>
    <ol class="audit__steps">
      {steps.map((step, index) => (
        <li class="astep">
          <span class="astep__number nk-label" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span class="astep__node" aria-hidden="true" />
          <h3 class="astep__title nk-display">{step.title}</h3>
          <p class="astep__body">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
  <script>
    import "./reveal.ts";
  </script>
</section>

<style>
  .audit {
    margin: var(--space-6) var(--pad);
    padding: var(--zone-pad) var(--space-5);
    border-radius: var(--nk-radius);
  }

  @media (min-width: 48rem) {
    .audit {
      padding-inline: var(--space-8);
    }
  }

  .audit__body {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  .audit__lead {
    max-width: 52ch;
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  .audit__actions {
    margin-top: var(--space-6);
  }

  /* The steps: a row of grips joined by a line, each with its number. */
  .audit__steps {
    --node: 1rem;

    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .astep {
    position: relative;
    display: grid;
    align-content: start;
    grid-template-columns: var(--node) minmax(0, 1fr);
    column-gap: var(--space-4);
    row-gap: var(--space-2);
  }

  .astep__number {
    grid-column: 2;
  }

  .astep__node {
    grid-row: 2;
    grid-column: 1;
    align-self: center;
    width: var(--node);
    height: var(--node);
    border: var(--grip-stroke) solid var(--accent);
    background: var(--grip-fill);
  }

  .astep__title {
    grid-row: 2;
    grid-column: 2;
    font-size: var(--nk-row);
    line-height: 1;
  }

  .astep__body {
    grid-column: 2;
    color: var(--ink-muted);
  }

  @media (min-width: 48rem) {
    .audit__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }

    .astep {
      grid-template-columns: minmax(0, 1fr);
    }

    .astep__number,
    .astep__title,
    .astep__body {
      grid-column: 1;
    }

    .astep__node {
      grid-row: auto;
      align-self: start;
      margin-block: var(--space-2) var(--space-3);
    }

    .astep__number {
      grid-row: 1;
    }

    .astep__title {
      grid-row: auto;
    }

    /* The line from one grip to the next. */
    .astep:not(:last-child)::after {
      position: absolute;
      top: calc(0.75rem * 1.5 + var(--space-2) + var(--node) / 2 + 0.5rem);
      right: calc(var(--space-5) * -1);
      left: calc(var(--node) + var(--space-2));
      height: var(--rail);
      background: var(--accent);
      content: "";
      transform-origin: 0 50%;
    }
  }

  @media (min-width: 64rem) {
    .audit__body {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-10);
      align-items: end;
    }
  }

  /* On arrival: the title rises, the steps' grips snap in one after the
     other and the line runs between them. */
  .audit.is-pending :is(.audit__title, .astep) {
    opacity: 0;
  }

  .audit.is-in .audit__title {
    animation: nk-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .audit.is-in .astep {
    animation: nk-rise 700ms cubic-bezier(0.16, 1, 0.3, 1)
      calc(300ms + var(--k, 0) * 180ms) both;
  }

  .audit.is-in .astep::after {
    animation: motion-draw-x 600ms var(--ease-pen)
      calc(700ms + var(--k, 0) * 180ms) both;
  }

  .astep:nth-child(2) {
    --k: 1;
  }

  .astep:nth-child(3) {
    --k: 2;
  }
</style>
