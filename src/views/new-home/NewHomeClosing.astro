---
/**
 * The new Home's closing call to action, on the sunk surface: the client's
 * question, the lead, the note on the reply time and on sketches by email,
 * and one button to Kontakt. The page ends as the wordmark does: a drafting
 * line is drawn across the top of the zone as it arrives, and its grip
 * snaps in at the end (new-home.css's grammar, on the zone's own timeline).
 */
import Button from "../../components/ui/Button.astro";
import type { Locale } from "../../config/site.ts";
import { t } from "../../features/i18n/ui.ts";
import { pathFor } from "../../features/i18n/urls.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="closing" aria-labelledby="zavrsni-poziv">
  <span class="closing__line" aria-hidden="true"></span>
  <span class="closing__grip" aria-hidden="true"></span>
  <div class="closing__text">
    <h2 class="closing__title" id="zavrsni-poziv">
      {t(locale, "home.closing.title")}
    </h2>
    <p class="closing__lead">{t(locale, "home.closing.lead")}</p>
    <p class="closing__note">{t(locale, "home.closing.note")}</p>
  </div>
  <Button href={pathFor("contact", locale)} class="closing__cta">
    {t(locale, "home.closing.cta")}
  </Button>
</section>

<style>
  .closing {
    --grip: 0.875rem;

    position: relative;
    display: grid;
    justify-items: center;
    padding: calc(var(--zone-pad) * 1.25) var(--pad);
    background: var(--surface-sunk);
    text-align: center;
    view-timeline: --closing block;
  }

  .closing__line {
    position: absolute;
    top: calc(var(--rail) / -2);
    right: calc(var(--pad) + var(--grip) / 2);
    left: 0;
    height: var(--rail);
    background: var(--accent);
    transform-origin: 0 50%;
  }

  .closing__grip {
    position: absolute;
    top: calc(var(--grip) / -2);
    right: var(--pad);
    width: var(--grip);
    height: var(--grip);
    border: var(--grip-stroke) solid var(--accent);
    background: var(--grip-fill);
  }

  .closing__text {
    max-width: 100%;
  }

  .closing__title {
    max-width: 16ch;
    font-size: clamp(2.25rem, 1.6rem + 3vw, 4.25rem);
    font-weight: var(--weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .closing__lead,
  .closing__note {
    width: 0;
    min-width: 100%;
    text-wrap: balance;
  }

  .closing__lead {
    margin-top: var(--space-5);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  .closing__note {
    margin-top: var(--space-3);
    color: var(--ink-muted);
  }

  .closing__cta {
    margin-top: var(--space-7);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .closing__line {
        animation: motion-draw-x var(--ease-pen) both;
        animation-timeline: --closing;
        animation-range: entry 0% cover 30%;
      }

      .closing__grip {
        animation: motion-snap-in var(--ease-snap) both;
        animation-timeline: --closing;
        animation-range: cover 29% cover 36%;
      }
    }
  }
</style>
