---
/**
 * "Tehničko crtanje" on the new Home (M28 in docs/phases/3-pages.md): the
 * text on the left and, on the right, a residential building drawn once
 * when it comes into view: its site plan (the building, a courtyard with a
 * pool on one side, parking on the other), turned into a 3D view in which
 * the storeys come down one by one, the penthouse last. Then, under the
 * text, its sections and the schedule of gross floor areas and volumes
 * (building/). Nothing here moves with the scroll; without JavaScript, or
 * with reduced motion, it all shows finished.
 *
 * The three services link to their anchors on the drafting page.
 */
import "./building/scene.css";

import Grips from "../../components/ui/Grips.astro";
import type { Locale } from "../../config/site.ts";
import { SITE_NAME } from "../../config/site.ts";
import { t } from "../../features/i18n/ui.ts";
import { pathFor } from "../../features/i18n/urls.ts";
import { DRAFTING_SERVICES } from "../../features/services/services.ts";
import BuildingAnalysis from "./building/BuildingAnalysis.astro";
import BuildingDrawing from "./building/BuildingDrawing.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const drafting = pathFor("drafting", locale);
---

<section class="cad nh-zone" aria-labelledby="crtanje" data-building-scene>
  <div class="cad__text">
    <h2 class="cad__title nk-display" id="crtanje">
      {t(locale, "drafting.title")}
    </h2>
    <p class="cad__lead">{t(locale, "home.drafting.lead")}</p>
    <ul class="cad__list">
      {DRAFTING_SERVICES.map((service) => (
        <li class="cad-item has-grips">
          <h3 class="cad-item__title nk-display">
            <a
              class="cad-item__link stretched-link"
              href={
                service.anchor === undefined
                  ? drafting
                  : `${drafting}#${service.anchor[locale]}`
              }
            >
              {t(locale, service.title)}
            </a>
          </h3>
          <p class="cad-item__body">{t(locale, service.short)}</p>
          <Grips />
        </li>
      ))}
    </ul>
  </div>

  <figure class="cad__figure" data-building-figure>
    <div class="cad__sheet graph-paper">
      <BuildingDrawing locale={locale} />
    </div>
    <figcaption
      class="cad__title-block t-label"
      data-wipe="fade"
      data-at="5300"
      data-for="400"
    >
      <span class="cad__cell cad__cell--strong">
        {t(locale, "newHome.building.title")}
      </span>
      <span class="cad__cell">{t(locale, "newHome.building.units")}</span>
      <span class="cad__cell cad__cell--strong">{SITE_NAME}</span>
      <span class="cad__cell">{t(locale, "drawing.note")}</span>
    </figcaption>
  </figure>

  <div class="cad__analysis">
    <BuildingAnalysis locale={locale} />
  </div>

  <script>
    import "./building/building-scene.ts";
  </script>
</section>

<style>
  .cad {
    display: grid;
    gap: var(--space-8);
  }

  .cad__lead {
    max-width: var(--measure-lead);
    margin-top: var(--space-5);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  .cad__list {
    display: grid;
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
  }

  .cad-item {
    position: relative;
    padding: var(--space-4) 0 var(--space-5);
    border-top: var(--rule) solid var(--line);
  }

  .cad__title {
    font-size: clamp(3rem, 1.5rem + 4.6vw, 6.5rem);
  }

  .cad-item__title {
    font-size: var(--nk-row);
    line-height: 1;
  }

  .cad-item__link {
    color: var(--ink);
  }

  .cad-item__body {
    max-width: var(--measure);
    margin-top: var(--space-2);
    color: var(--ink-muted);
  }

  .cad-item:has(.cad-item__link:focus-visible) {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }

  .cad-item__link:focus-visible {
    outline: none;
  }

  .cad__figure {
    margin: 0;
  }

  .cad__sheet {
    padding: var(--space-4);
  }

  /* The title block under the drawing, in the drawing's cells. */
  .cad__title-block {
    display: grid;
    grid-template-columns: auto auto;
    width: fit-content;
    margin: var(--space-3) 0 0 auto;
    border: 1px solid var(--drawing-ink);
    color: var(--drawing-ink);
    line-height: 1.2;
  }

  .cad__cell {
    padding: 0.3125rem 0.5rem;
  }

  .cad__cell:nth-child(odd) {
    border-right: 1px solid var(--drawing-ink);
  }

  .cad__cell:nth-child(-n + 2) {
    border-bottom: 1px solid var(--drawing-ink);
  }

  .cad__cell--strong {
    font-weight: var(--weight-strong);
  }

  /* From 64rem: the text and, under it, the sections and schedule on the
     left; the drawing on the right. */
  @media (min-width: 64rem) {
    .cad {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      row-gap: var(--space-9);
      align-items: start;
    }

    .cad__text,
    .cad__analysis {
      grid-column: 1 / span 5;
    }

    .cad__figure {
      grid-row: 1 / span 2;
      grid-column: 6 / -1;
    }

    .cad__sheet {
      padding: var(--space-6);
    }
  }
</style>
