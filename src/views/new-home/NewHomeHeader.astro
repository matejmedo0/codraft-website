---
/**
 * The new Home's header (M16–M19 in docs/phases/3-pages.md, rule 5 in
 * docs/new-home-rules.md), a copy of src/components/site/Header.astro:
 * without the drafting page's link or a rule below; the links and the
 * language in the navigation colour, ivory on hover and for the current
 * page. From 64rem the wordmark, the links and the language sit together
 * in the header's centre, larger, in a taller header. The rest is the site
 * header's:
 *
 * The site header, on paper at the top of the sheet (ADR 0015): the static
 * wordmark (only the home hero's mark moves, ADR 0014), the main navigation
 * and the language switcher. It has no button: the free audit is asked for
 * once on a page, where the page explains it (ADR 0017). The current page is
 * marked with `aria-current`.
 *
 * Below 64rem the navigation folds behind the menu button (menu.ts); without
 * JavaScript it stays open. Its links take the grips on hover and keyboard
 * focus, as nav items do in docs/motion.md ("Select"; critique 18, tried in
 * the client's review).
 */
import type { Locale } from "../../config/site.ts";
import { MAIN_NAV } from "../../features/i18n/navigation.ts";
import type { PageId } from "../../features/i18n/route-map.ts";
import { t } from "../../features/i18n/ui.ts";
import { pathFor } from "../../features/i18n/urls.ts";
import Grips from "../../components/ui/Grips.astro";
import Wordmark from "../../components/ui/Wordmark.astro";
import LanguageSwitcher from "../../components/site/LanguageSwitcher.astro";

interface Props {
  locale: Locale;
  page?: PageId | undefined;
  /** From 64rem: one row, or the wordmark above the links (M21, a preview). */
  layout?: "row" | "stacked";
}

const { locale, page, layout = "row" } = Astro.props;
const MENU_ID = "site-menu";
// The drafting page is left out of the new Home's navigation (M17).
const NAV = MAIN_NAV.filter(({ page: target }) => target !== "drafting");

function current(target: PageId): "page" | undefined {
  return target === page ? "page" : undefined;
}
---

<header
  class:list={["site-header", { "site-header--stacked": layout === "stacked" }]}
>
  <a
    class="site-header__home"
    href={pathFor("home", locale)}
    aria-current={current("home")}
  >
    <span class="visually-hidden">{t(locale, "header.home")}</span>
    <Wordmark />
  </a>
  <button
    class="site-header__toggle"
    type="button"
    aria-expanded="false"
    aria-controls={MENU_ID}
    data-menu-toggle
  >
    {t(locale, "header.menu")}
    <span class="site-header__toggle-icon" aria-hidden="true"></span>
  </button>
  <nav
    class="site-header__nav"
    id={MENU_ID}
    aria-label={t(locale, "header.navLabel")}
  >
    <ul class="site-header__links">
      {NAV.map(({ page: target, label }) => (
        <li>
          <a
            class="has-grips"
            href={pathFor(target, locale)}
            aria-current={current(target)}
          >
            {t(locale, label)}
            <Grips />
          </a>
        </li>
      ))}
    </ul>
    <LanguageSwitcher
      locale={locale}
      page={page}
      display="code"
      class="site-header__language"
      grips
    />
  </nav>
</header>

<script>
  import "../../components/site/menu.ts";
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: center;
    /* No rule below the header: it runs into the hero (M19). */
    padding: var(--space-3) var(--pad);
    background: var(--surface);
    view-transition-name: site-header;
  }

  .site-header__home {
    --wordmark-width: 7.25rem;

    display: block;
    padding: var(--space-2) 0;
    color: var(--ink);
  }

  .site-header__toggle {
    display: none;
    gap: 0.625rem;
    align-items: center;
    min-height: var(--control-height-compact);
    margin-left: auto;
    padding: 0 0.875rem;
    border: var(--rule) solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    font-weight: var(--weight-strong);
    cursor: pointer;
  }

  /* Two drafting lines that cross when the menu is open. */
  .site-header__toggle-icon {
    position: relative;
    width: 1rem;
    height: 0.5rem;
    border-block: 1.5px solid currentColor;
  }

  .site-header__toggle[aria-expanded="true"] .site-header__toggle-icon {
    border: 0;
  }

  .site-header__toggle[aria-expanded="true"] .site-header__toggle-icon::before,
  .site-header__toggle[aria-expanded="true"] .site-header__toggle-icon::after {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    content: "";
    transform: rotate(45deg);
  }

  .site-header__toggle[aria-expanded="true"] .site-header__toggle-icon::after {
    transform: rotate(-45deg);
  }

  .site-header__nav {
    display: flex;
    flex-basis: 100%;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-2);
  }

  .site-header__links {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__links a,
  .site-header__nav :global(.site-header__language) {
    display: block;
    padding: var(--space-3) 0;
    border-bottom: var(--rule) solid var(--line);
    color: var(--nav-ink);
    font-size: var(--step-lead);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .site-header__links a:hover,
  .site-header__nav :global(.site-header__language):hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  /* The current page: a blue drafting line under its link. */
  .site-header__links a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: var(--rail);
  }

  .site-header__nav :global(.site-header__language) {
    align-self: start;
    border: 0;
  }

  @media (max-width: 63.99rem) {
    :global(.js) .site-header__toggle {
      display: inline-flex;
    }

    :global(.js) .site-header__nav:not(.is-open) {
      display: none;
    }

    /* The menu opens with a short fade of its links, and the page moves
       down at once (critique 17). A fade of 200 ms stays with reduced
       motion (motion.md). */
    :global(.js) .site-header__nav.is-open {
      animation: motion-fade-in var(--motion-base) var(--ease-standard);
    }
  }

  /* One row (M19, M20): the links in the header's centre and the wordmark
     just left of them, 48 px away; the links 32 px apart; all spacing
     times --topbar-scale. Three columns, the nav spanning the last two
     through a subgrid, so the links centre on the header whatever the
     wordmark's width. The language floats at the top right (M22). */
  @media (min-width: 64rem) {
    /* M17's sizes (a 77.5 px header, a 28.5 px wordmark, 15 and 13 px
       text), all times --topbar-scale (M18, NewHomeView.astro): at 1.125,
       an 86 px header and a 32 px wordmark. */
    .site-header {
      position: relative;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: calc(var(--space-8) * var(--topbar-scale, 1));
      padding-block: calc(var(--space-4) * var(--topbar-scale, 1));
    }

    .site-header__home {
      --wordmark-width: calc(8.25rem * var(--topbar-scale, 1));

      justify-self: end;
      padding-block: calc(var(--space-2) * var(--topbar-scale, 1));
    }

    .site-header__nav {
      display: grid;
      grid-column: 2 / 4;
      grid-template-columns: subgrid;
      gap: normal;
      align-items: center;
      padding: 0;
    }

    /* Two rows (M21): the wordmark centred above, the links below. */
    .site-header--stacked {
      row-gap: calc(var(--space-2) * var(--topbar-scale, 1));
    }

    .site-header--stacked .site-header__home {
      grid-column: 1 / -1;
      justify-self: center;
    }

    .site-header__links {
      display: flex;
      gap: calc(var(--space-6) * var(--topbar-scale, 1));
    }

    .site-header__links a {
      padding: var(--space-2) 0;
      border: 0;
      font-size: calc(var(--step-small) * var(--topbar-scale, 1));
    }

    /* The language as a floating circle at the top right (M22): midnight
       on ivory (15.4:1), on teal when hovered (8.5:1). It is as tall as
       the wordmark's row (2.78rem times the factor) and starts at the
       header's padding, so it lines up with the wordmark in one row or
       two. */
    .site-header__nav :global(.site-header__language) {
      position: absolute;
      top: calc(var(--space-4) * var(--topbar-scale, 1));
      right: var(--pad);
      display: grid;
      place-items: center;
      width: calc(2.75rem * var(--topbar-scale, 1));
      height: calc(2.75rem * var(--topbar-scale, 1));
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--ink);
      color: var(--surface);
      font-size: calc(var(--step-label) * var(--topbar-scale, 1));
    }

    .site-header__nav :global(.site-header__language):hover {
      background: var(--accent);
      color: var(--surface);
      text-decoration: none;
    }
  }
</style>
