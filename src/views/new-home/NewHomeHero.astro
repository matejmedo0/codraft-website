---
/**
 * The new Home's hero (M29 in docs/phases/3-pages.md): the headline, the
 * lead, the one button to the services and the drafting link, centred,
 * and under them code typed into an editor that builds a web page beside
 * it as it goes (hero/CodeToSite.astro).
 *
 * The text comes in on load: the headline's two lines rise out of their
 * own baseline one after the other, then the lead and the actions fade up;
 * the code starts as they settle. With reduced motion everything is there
 * at once. The hero orients and doesn't sell: its one button leads to the
 * services, and the free audit is asked for once, in its own zone.
 */
import Button from "../../components/ui/Button.astro";
import type { Locale } from "../../config/site.ts";
import { t } from "../../features/i18n/ui.ts";
import { pathFor } from "../../features/i18n/urls.ts";
import CodeToSite from "./hero/CodeToSite.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="hero" aria-labelledby="naslov">
  <div class="hero__text">
    <h1 id="naslov">
      <span class="hero__line">
        <span class="hero__rise">{t(locale, "home.hero.titleLine1")}</span>
      </span>{" "}
      <span class="hero__line">
        <span class="hero__rise">{t(locale, "home.hero.titleLine2")}</span>
      </span>
    </h1>
    <p class="hero__lead">{t(locale, "home.hero.lead")}</p>
    <div class="hero__actions">
      <Button href={pathFor("services", locale)}>
        {t(locale, "home.hero.cta")}
      </Button>
      <a class="hero__drafting" href={pathFor("drafting", locale)}>
        {t(locale, "home.hero.drafting")}
      </a>
    </div>
  </div>
  <div class="hero__stage">
    <CodeToSite />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-9);
    align-content: center;
    justify-items: center;
    /* The header is 4.25rem tall below 64rem and from 64rem 4.78rem times
       --topbar-scale (NewHomeHeader.astro). svh: the screen with a phone's
       browser bars shown. */
    min-height: calc(100svh - var(--sheet-margin) - 4.125rem);
    padding: var(--space-8) var(--pad) var(--zone-pad);
    text-align: center;
  }

  .hero__text {
    display: grid;
    justify-items: center;
    max-width: 100%;
  }

  /* Each line of the headline is its own block, clipped at its baseline,
     so it can rise out of it. */
  .hero__line {
    display: block;
    padding-bottom: 0.08em;
    overflow: clip;
  }

  .hero__rise {
    display: block;
  }

  .hero__lead {
    max-width: 40ch;
    margin-top: var(--space-5);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
    text-wrap: balance;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    justify-content: center;
    align-items: center;
    margin-top: var(--space-6);
  }

  .hero__drafting {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }

  .hero__stage {
    width: min(100%, 72rem);
  }

  @media (min-width: 64rem) {
    .hero {
      gap: var(--space-8);
      padding-top: var(--space-6);
      min-height: calc(
        100svh - var(--sheet-margin) - 4.75rem * var(--topbar-scale, 1)
      );
    }
  }

  /* The entrance on load: the headline's lines rise, the rest fades up. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__rise {
      animation: hero-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) 100ms both;
    }

    .hero__line + .hero__line .hero__rise {
      animation-delay: 220ms;
    }

    .hero__lead {
      animation: hero-up 700ms cubic-bezier(0.16, 1, 0.3, 1) 450ms both;
    }

    .hero__actions {
      animation: hero-up 700ms cubic-bezier(0.16, 1, 0.3, 1) 600ms both;
    }

    .hero__stage {
      animation: hero-up 800ms cubic-bezier(0.16, 1, 0.3, 1) 700ms both;
    }
  }

  @keyframes hero-rise {
    from {
      translate: 0 105%;
    }

    to {
      translate: 0 0;
    }
  }

  @keyframes hero-up {
    from {
      opacity: 0;
      translate: 0 1rem;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
