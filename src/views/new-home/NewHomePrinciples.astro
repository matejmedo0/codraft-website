---
/**
 * "Kako radimo" on the new Home: the client's three commitments as three
 * large statements, one under the other, in the client's order. A quiet
 * zone after the drafting scene: each statement rises in as it arrives,
 * under a rule drawn from the left (new-home.css). "Razgovarate s onima
 * koji rade" gets its proof from the team right below.
 */
import type { Locale } from "../../config/site.ts";
import { t } from "../../features/i18n/ui.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items = (["direct", "honest", "yours"] as const).map((item) => ({
  title: t(locale, `principles.${item}.title`),
  body: t(locale, `principles.${item}.body`),
}));
---

<section class="how nh-zone nh-grid" aria-labelledby="kako-radimo">
  <h2 class="how__title" id="kako-radimo">
    {t(locale, "home.principles.title")}
  </h2>
  <ol class="how__list">
    {items.map((item) => (
      <li class="how-item">
        <span class="nh-rule" aria-hidden="true" />
        <div class="how-item__text nh-rise">
          <h3 class="how-item__title">{item.title}</h3>
          <p class="how-item__body">{item.body}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .how {
    align-items: start;
  }

  .how__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .how-item {
    position: relative;
    padding: var(--space-6) 0 var(--space-7);
  }

  .how-item__text {
    display: grid;
    gap: var(--space-3);
  }

  .how-item__title {
    max-width: 18ch;
    font-size: var(--step-chapter);
    font-weight: var(--weight-chapter);
  }

  .how-item__body {
    max-width: var(--measure);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
    color: var(--ink-muted);
  }

  @media (min-width: 64rem) {
    .how__title {
      position: sticky;
      top: var(--space-8);
      grid-column: 1 / span 4;
    }

    .how__list {
      grid-column: 5 / -1;
    }

    .how-item {
      padding-block: var(--space-7) var(--space-8);
    }

    .how-item:first-child {
      padding-top: var(--space-2);
    }

    .how-item:first-child > :global(.nh-rule) {
      display: none;
    }

    .how-item__text {
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
      gap: var(--gap);
      align-items: start;
    }
  }
</style>
