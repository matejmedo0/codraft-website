---
/**
 * "Kako radimo" on the new Home (M32, M36): the client's three commitments
 * as a grid of rounded cards, as in the client's reference "Torch": the
 * first card tall on the left, the other two stacked beside it. Each card
 * has its number outlined at the top and its statement in display capitals
 * with its sentence at the bottom. They come in one after the other when
 * the zone arrives (reveal.ts). "Razgovarate s onima koji rade" gets its
 * proof from the team right below.
 */
import type { Locale } from "../../config/site.ts";
import { t } from "../../features/i18n/ui.ts";
import TwoTone from "./TwoTone.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items = (["direct", "honest", "yours"] as const).map((item) => ({
  title: t(locale, `principles.${item}.title`),
  body: t(locale, `principles.${item}.body`),
}));
---

<section class="how nh-zone" aria-labelledby="kako-radimo" data-reveal>
  <h2 class="how__title nk-display nk-title" id="kako-radimo">
    <TwoTone text={t(locale, "home.principles.title")} />
  </h2>
  <ol class="how__list">
    {items.map((item, index) => (
      <li class="how-item nk-card">
        <span class="how-item__number nk-display nk-outline" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        <div>
          <h3 class="how-item__title nk-display">{item.title}</h3>
          <p class="how-item__body">{item.body}</p>
        </div>
      </li>
    ))}
  </ol>
  <script>
    import "./reveal.ts";
  </script>
</section>

<style>
  .how__list {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .how-item {
    display: grid;
    gap: var(--space-8);
    align-content: space-between;
    min-height: 16rem;
    padding: var(--space-6);
  }

  .how-item__number {
    font-size: clamp(2.5rem, 2rem + 2vw, 4rem);
    line-height: 0.8;
  }

  .how-item__title {
    font-size: var(--nk-statement);
    line-height: 0.92;
  }

  .how-item__body {
    max-width: 40ch;
    margin-top: var(--space-4);
    color: var(--ink-muted);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  @media (min-width: 64rem) {
    .how__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }

    .how-item {
      padding: var(--space-8);
    }

    .how-item:first-child {
      grid-row: span 2;
    }
  }

  .how.is-pending :is(.how__title, .how-item) {
    opacity: 0;
  }

  .how.is-in .how__title {
    animation: nk-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .how.is-in .how-item {
    animation: nk-rise 800ms cubic-bezier(0.16, 1, 0.3, 1)
      calc(250ms + var(--k, 0) * 160ms) both;
  }

  .how-item:nth-child(2) {
    --k: 1;
  }

  .how-item:nth-child(3) {
    --k: 2;
  }
</style>
