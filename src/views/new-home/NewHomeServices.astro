---
/**
 * "Što radimo" on the new Home: the three stages one under the other, each
 * coming in as two halves from the sides when it reaches the screen (M26 to
 * M28 in docs/phases/3-pages.md). A stage's head (its number large in the
 * accent, title and tagline) slides in from one side and its services, as
 * one group, from the other; the next stage is mirrored, so the zone goes
 * zig-zag down the sheet. Each stage plays once, on arrival, not with the
 * scroll (reveal.ts), and its icons draw stroke by stroke as the group
 * lands. The text is always there: without JavaScript or with reduced
 * motion the halves stand in place.
 *
 * The services of stages 02 and 03 link to their anchors on /usluge; the
 * two items of stage 01 don't, since the free audit asks once, in the zone
 * right after this one.
 */
import Grips from "../../components/ui/Grips.astro";
import type { Locale } from "../../config/site.ts";
import { t } from "../../features/i18n/ui.ts";
import { pathFor } from "../../features/i18n/urls.ts";
import ServiceIcon from "../../features/services/icons/ServiceIcon.astro";
import { STAGES } from "../../features/services/services.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const services = pathFor("services", locale);
---

<section class="svc nh-zone" aria-labelledby="usluge">
  <div class="svc__head nh-grid">
    <h2 class="svc__title nk-display nk-title" id="usluge">
      {t(locale, "services.title")}
    </h2>
    <p class="svc__intro">{t(locale, "services.intro")}</p>
  </div>
  {STAGES.map((stage, index) => (
    <div
      class:list={["stage", { "stage--mirror": index % 2 === 1 }]}
      data-reveal
    >
      <div class="stage__head">
        <p class="stage__number nk-display nk-outline" aria-hidden="true">
          {stage.number}
        </p>
        <div class="stage__text">
          <h3 class="stage__title nk-display">
            <span class="visually-hidden">{stage.number} </span>
            {t(locale, stage.title)}
          </h3>
          <p class="stage__tagline">{t(locale, stage.tagline)}</p>
        </div>
      </div>
      <ul class="stage__items">
        {stage.services.map((service) => {
          const href =
            service.anchor === undefined
              ? undefined
              : `${services}#${service.anchor[locale]}`;
          return (
            <li class:list={["svc-item", { "has-grips": href !== undefined }]}>
              {service.icon !== undefined && (
                <ServiceIcon icon={service.icon} class="svc-item__icon" />
              )}
              <h4 class="svc-item__title nk-display">
                {href === undefined ? (
                  t(locale, service.title)
                ) : (
                  <a class="svc-item__link stretched-link" href={href}>
                    {t(locale, service.title)}
                  </a>
                )}
              </h4>
              <p class="svc-item__body">{t(locale, service.short)}</p>
              {href !== undefined && <Grips />}
            </li>
          );
        })}
      </ul>
    </div>
  ))}
  <script>
    import "./reveal.ts";
  </script>
</section>

<style>
  .svc {
    /* How far a half comes in from: a step on phones, a long slide from
       64rem. The slides are clipped at the zone's edge, so the page never
       scrolls sideways. */
    --svc-slide: 16vw;

    overflow-x: clip;
  }

  .svc__head {
    align-items: end;
    margin-bottom: var(--space-8);
  }

  .svc__intro {
    max-width: var(--measure);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
    color: var(--ink-muted);
  }

  /* A stage: its head and its services. */
  .stage {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
    border-top: var(--rule) solid var(--line);
  }

  .stage__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-5);
    align-items: baseline;
    align-self: start;
  }

  /* The stage's number, large and in the accent: the sequence is the point
     of this zone, as a drawing numbers its sheets. The heading carries it
     for assistive technology. */
  .stage__number {
    font-size: clamp(3rem, 2rem + 3.5vw, 6rem);
    line-height: 0.8;
    font-variant-numeric: tabular-nums;
  }

  .stage__title {
    font-size: clamp(1.625rem, 1.25rem + 1.4vw, 2.625rem);
  }

  .stage__tagline {
    max-width: var(--measure-lead);
    margin-top: var(--space-2);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
    color: var(--ink-muted);
  }

  .stage__items {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .svc-item {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    column-gap: var(--space-5);
    align-items: start;
    padding: var(--space-5) 0;
    border-top: var(--rule) solid var(--line);
  }

  .svc-item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .svc-item .svc-item__icon {
    grid-row: 1 / span 2;
    width: 3.5rem;
    height: 3.5rem;
    color: var(--ink);
  }

  .svc-item__title {
    grid-column: 2;
    font-size: var(--nk-row);
    line-height: 1;
  }

  .svc-item__link {
    color: var(--ink);
  }

  .svc-item__body {
    grid-column: 2;
    max-width: var(--measure);
    margin-top: var(--space-2);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
    color: var(--ink-muted);
  }

  /* The outline goes around the whole row, not just the title. */
  .svc-item:has(.svc-item__link:focus-visible) {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }

  .svc-item__link:focus-visible {
    outline: none;
  }

  /* The entrance: a stage's two halves come in from their sides as it
     reaches the screen, the services a beat after the head; then the
     icons draw. The mirrored stage swaps the sides. */
  @keyframes svc-from-left {
    from {
      opacity: 0;
      translate: calc(var(--svc-slide) * -1) 0;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes svc-from-right {
    from {
      opacity: 0;
      translate: var(--svc-slide) 0;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .stage.is-pending :is(.stage__head, .stage__items) {
    opacity: 0;
  }

  .stage.is-in :is(.stage__head, .stage__items) {
    animation: svc-from-left 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .stage.is-in .stage__items,
  .stage--mirror.is-in .stage__head {
    animation-name: svc-from-right;
  }

  .stage--mirror.is-in .stage__items {
    animation-name: svc-from-left;
  }

  .stage.is-in .stage__items {
    animation-delay: 120ms;
  }

  .stage.is-in :global(:is([data-stroke="ink"], [data-stroke="line"])) {
    stroke-dasharray: 1;
    animation: nh-stroke 650ms var(--ease-pen) 650ms both;
  }

  .stage.is-in :global([data-stroke="line"]) {
    animation-duration: 300ms;
    animation-delay: 1150ms;
  }

  .stage.is-in :global([data-stroke="grip"]) {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: motion-snap-in var(--motion-snap) var(--ease-snap) 1400ms both;
  }

  @media (min-width: 64rem) {
    .svc {
      --svc-slide: 22vw;
    }

    .svc__title {
      grid-column: 1 / span 5;
    }

    .svc__intro {
      grid-column: 7 / -1;
    }

    /* The two halves side by side on the page's grid: the head on the
       left and the services on the right, or mirrored. */
    .stage {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      padding-block: var(--space-9);
    }

    .stage__head {
      grid-row: 1;
      grid-column: 1 / span 5;
    }

    .stage__items {
      grid-row: 1;
      grid-column: 7 / -1;
    }

    .stage--mirror .stage__head {
      grid-column: 8 / -1;
    }

    .stage--mirror .stage__items {
      grid-column: 1 / span 6;
    }

    .svc-item {
      padding-block: var(--space-6);
    }
  }
</style>
