---
/**
 * The hero's drawing on the new Home: a website drafted like a building,
 * as a technical drawing on graph paper. A browser window with a page laid
 * out inside it (header, headline, a hatched image, a button, three cards),
 * the margin guides, the dimensions in pixels in the accent, and a title
 * block, like the house plan's further down the page. The width's
 * dimension line is the brand's drafting line and ends in its grip.
 *
 * It draws itself once on load, in drawing order, after the entrance
 * delay: each group has its start and length (--at, --for, set per group
 * in CSS, never inline, for the CSP). Strokes run along their paths
 * (pathLength="1"), fills and lettering fade in, the grip snaps in last.
 * Reduced motion shows the finished drawing at once. The headline beside
 * it never waits: it is the page's LCP element.
 *
 * An illustration, not client work; its title block says so (ADR 0004).
 */
import { type Locale, SITE_NAME } from "../../config/site.ts";
import { t } from "../../features/i18n/ui.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/* The three cards: x, with a title line and two text lines each. */
const CARDS = [64, 196, 328];
---

<svg
  class="sd sd--entrance"
  viewBox="36 22 496 370"
  role="img"
  aria-label={t(locale, "newHome.drawing.label")}
  focusable="false"
>
  <defs>
    <pattern
      id="sd-hatch"
      width="8"
      height="8"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(45)"
    >
      <line class="sd__hatch-line" x1="0" y1="0" x2="0" y2="8"></line>
    </pattern>
  </defs>

  <g class="sd-g sd-g1">
    <rect
      x="48"
      y="32"
      width="400"
      height="270"
      pathLength="1"
      data-stroke
    ></rect>
  </g>

  <g class="sd-g sd-g2">
    <line x1="48" y1="58" x2="448" y2="58" pathLength="1" data-stroke></line>
    <rect x="58" y="41" width="8" height="8" pathLength="1" data-stroke></rect>
    <rect
      x="80"
      y="41"
      width="160"
      height="8"
      pathLength="1"
      data-stroke
    ></rect>
  </g>

  <g class="sd-g sd-g3">
    <rect
      x="64"
      y="74"
      width="36"
      height="10"
      pathLength="1"
      data-stroke
    ></rect>
    <line x1="330" y1="79" x2="360" y2="79" pathLength="1" data-stroke></line>
    <line x1="372" y1="79" x2="402" y2="79" pathLength="1" data-stroke></line>
    <line x1="414" y1="79" x2="434" y2="79" pathLength="1" data-stroke></line>
  </g>

  <g class="sd-g sd-g4">
    <line
      class="sd__bold"
      x1="64"
      y1="110"
      x2="250"
      y2="110"
      pathLength="1"
      data-stroke
    ></line>
    <line
      class="sd__bold"
      x1="64"
      y1="126"
      x2="214"
      y2="126"
      pathLength="1"
      data-stroke
    ></line>
  </g>

  <g class="sd-g sd-g5">
    <line x1="64" y1="146" x2="240" y2="146" pathLength="1" data-stroke></line>
    <line x1="64" y1="156" x2="226" y2="156" pathLength="1" data-stroke></line>
  </g>

  <g class="sd-g sd-g6">
    <rect
      x="64"
      y="172"
      width="88"
      height="20"
      pathLength="1"
      data-stroke
    ></rect>
    <line x1="80" y1="182" x2="136" y2="182" pathLength="1" data-stroke></line>
  </g>

  <g class="sd-g sd-g7">
    <rect
      x="276"
      y="100"
      width="156"
      height="96"
      pathLength="1"
      data-stroke
    ></rect>
    <path d="M276 100L432 196" pathLength="1" data-stroke></path>
    <path d="M432 100L276 196" pathLength="1" data-stroke></path>
  </g>

  <g class="sd-g sd-g8">
    <rect
      class="sd__hatch"
      x="276"
      y="100"
      width="156"
      height="96"
      data-fade
    ></rect>
  </g>

  {CARDS.map((x, index) => (
    <g class:list={["sd-g", `sd-g${String(9 + index)}`]}>
      <rect x={x} y="218" width="104" height="62" pathLength="1" data-stroke />
      <line
        x1={x + 12}
        y1="232"
        x2={x + 60}
        y2="232"
        pathLength="1"
        data-stroke
      />
      <line
        x1={x + 12}
        y1="248"
        x2={x + 88}
        y2="248"
        pathLength="1"
        data-stroke
      />
      <line
        x1={x + 12}
        y1="258"
        x2={x + 76}
        y2="258"
        pathLength="1"
        data-stroke
      />
    </g>
  ))}

  <g class="sd-g sd-g12">
    <path class="sd__guide" d="M64 58V302M432 58V302" data-fade></path>
  </g>

  <g class="sd-g sd-g13 sd__accent">
    <path d="M48 306V330M448 306V330" pathLength="1" data-stroke></path>
    <path d="M48 324H440" pathLength="1" data-stroke></path>
    <path d="M46 326L50 322" pathLength="1" data-stroke></path>
    <rect
      class="sd__grip"
      x="443"
      y="319"
      width="10"
      height="10"
      data-grip
    ></rect>
  </g>

  <g class="sd-g sd-g14 sd__accent">
    <path d="M452 32H476M452 302H476" pathLength="1" data-stroke></path>
    <path d="M470 32V302" pathLength="1" data-stroke></path>
    <path d="M468 34L472 30M468 304L472 300" pathLength="1" data-stroke></path>
  </g>

  <g class="sd-g sd-g15">
    <text class="sd__dim" x="248" y="319" data-fade>
      1440
    </text>
    <text
      class="sd__dim"
      x="464"
      y="167"
      transform="rotate(-90 464 167)"
      data-fade
    >
      900
    </text>
  </g>

  <g class="sd-g sd-g16 sd__title">
    <path
      d="M344 344H520V384H344ZM344 364H520M448 344V384"
      pathLength="1"
      data-stroke
    ></path>
    <text class="sd__cell sd__cell--strong" x="349" y="358" data-fade>
      {t(locale, "newHome.drawing.title")}
    </text>
    <text class="sd__cell" x="453" y="358" data-fade>
      {t(locale, "newHome.drawing.units")}
    </text>
    <text class="sd__cell sd__cell--strong" x="349" y="378" data-fade>
      {SITE_NAME}
    </text>
    <text class="sd__cell" x="453" y="378" data-fade>
      {t(locale, "drawing.note")}
    </text>
  </g>
</svg>

<style>
  .sd {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Line work in drawing units (about 1 px on screen; no non-scaling-stroke,
     which breaks the dash the strokes are drawn with). The headline's bars
     are the one heavy line. */
  .sd :is(path, line, rect) {
    fill: none;
    stroke: var(--drawing-ink);
    stroke-width: 1.25;
  }

  .sd .sd__bold {
    stroke-width: 5.5;
  }

  .sd .sd__accent :is(path, line) {
    stroke: var(--accent);
  }

  .sd .sd__guide {
    stroke: var(--drawing-muted);
    stroke-dasharray: 6 3;
  }

  .sd .sd__hatch {
    fill: url("#sd-hatch");
    stroke: none;
  }

  .sd .sd__hatch-line {
    stroke: var(--drawing-muted);
  }

  .sd .sd__grip {
    fill: var(--drawing-fill);
    stroke: var(--accent);
    stroke-width: 2.25;
  }

  /* Lettering, in the drawing's units, so it scales with the sheet. */
  .sd text {
    fill: var(--drawing-ink);
    font-size: 11px;
    font-stretch: var(--width-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
  }

  .sd .sd__dim {
    fill: var(--accent-text);
    text-anchor: middle;
  }

  .sd .sd__cell--strong {
    font-weight: var(--weight-strong);
  }

  /* On a sheet under 26rem the title block's lettering would be under
     9 px, so the drawn block goes and the hero sets the same cells under
     the drawing (NewHomeHero.astro), as the house plan does. */
  @container (max-width: 25.99rem) {
    .sd__title {
      display: none;
    }
  }

  /* The drawing order: each group's start and length. The grip snaps in
     at the end of its group. */
  .sd-g1 {
    --at: 0ms;
    --for: 550ms;
  }

  .sd-g2 {
    --at: 400ms;
    --for: 300ms;
  }

  .sd-g3 {
    --at: 600ms;
    --for: 250ms;
  }

  .sd-g4 {
    --at: 750ms;
    --for: 400ms;
  }

  .sd-g5 {
    --at: 1000ms;
    --for: 250ms;
  }

  .sd-g6 {
    --at: 1150ms;
    --for: 300ms;
  }

  .sd-g7 {
    --at: 1300ms;
    --for: 400ms;
  }

  .sd-g8 {
    --at: 1600ms;
    --for: 250ms;
  }

  .sd-g9 {
    --at: 1650ms;
    --for: 350ms;
  }

  .sd-g10 {
    --at: 1780ms;
    --for: 350ms;
  }

  .sd-g11 {
    --at: 1910ms;
    --for: 350ms;
  }

  .sd-g12 {
    --at: 2100ms;
    --for: 350ms;
  }

  .sd-g13 {
    --at: 2250ms;
    --for: 550ms;
  }

  .sd-g14 {
    --at: 2400ms;
    --for: 550ms;
  }

  .sd-g15 {
    --at: 2850ms;
    --for: 200ms;
  }

  .sd-g16 {
    --at: 2900ms;
    --for: 400ms;
  }

  .sd--entrance [data-stroke] {
    stroke-dasharray: 1;
    animation: nh-stroke var(--for) var(--ease-pen)
      calc(var(--motion-entrance-delay) + var(--at)) both;
  }

  .sd--entrance [data-fade] {
    animation: motion-fade-in var(--for) var(--ease-standard)
      calc(var(--motion-entrance-delay) + var(--at)) both;
  }

  .sd--entrance [data-grip] {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: motion-snap-in var(--motion-snap) var(--ease-snap)
      calc(var(--motion-entrance-delay) + var(--at) + var(--for)) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .sd--entrance :is([data-stroke], [data-fade], [data-grip]) {
      animation: none;
    }
  }
</style>
