---
/**
 * The residential building of the new Home's drafting scene (M28): its site
 * plan drawn element by element, then turned and tilted into a 3D view in
 * which the storeys come down one on the other, the penthouse last, and the
 * height is dimensioned. building-scene.ts starts it once, when the drawing
 * comes into view; each element's start and length are its `data-at` and
 * `data-for`, in milliseconds from that start. Without JavaScript, or with
 * reduced motion, the drawing shows its final state, the 3D view.
 *
 * Units: decimetres (building-model.ts). Thin lines keep their weight at
 * every size. An illustration, not client work; its title block says so.
 */
import type { Locale } from "../../../config/site.ts";
import { t } from "../../../features/i18n/ui.ts";
import {
  AXO_VIEW,
  DECK,
  FOOTPRINT,
  heightDimension,
  HEIGHT,
  PARKING,
  POOL,
  SITE,
  STOREY_AT,
  STOREY_STEP,
  storeys,
  TREE_RADIUS,
  TREES,
  U,
  VIEW_BOX,
  viewTransform,
} from "./building-model.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const number = new Intl.NumberFormat(locale === "hr" ? "hr-HR" : "en-GB", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});

const d = (value: number): number => value * U;
const rect = (box: { x0: number; y0: number; x1: number; y1: number }) => ({
  x: d(box.x0),
  y: d(box.y0),
  width: d(box.x1 - box.x0),
  height: d(box.y1 - box.y0),
});

const bays = Array.from(
  { length: PARKING.count + 1 },
  (_, index) => PARKING.y0 + index * PARKING.bay,
);
const parkingEnd = bays.at(-1) ?? PARKING.y0;
const bayLines = bays
  .map(
    (y) =>
      `M${String(d(PARKING.x1 - PARKING.depth))} ${String(d(y))}H${String(d(PARKING.x1))}`,
  )
  .join("");
const aisle = `M${String(d(PARKING.x0))} ${String(d(PARKING.y0))}V${String(d(SITE.depth))}M${String(d(PARKING.x1))} ${String(d(PARKING.y0))}V${String(d(parkingEnd))}`;

const model = storeys();
const height = heightDimension();
---

<svg
  class="bld"
  viewBox={VIEW_BOX}
  role="img"
  aria-label={t(locale, "newHome.building.label")}
  focusable="false"
>
  <g class="bld__ground" data-ground transform={viewTransform(AXO_VIEW, "svg")}>
    <rect
      class="bld-site"
      x="0"
      y="0"
      width={d(SITE.width)}
      height={d(SITE.depth)}
      data-wipe="x"
      data-at="0"
      data-for="500"
    ></rect>
    <g class="bld-parking" data-wipe="y" data-at="300" data-for="700">
      <path d={aisle}></path>
      <path d={bayLines}></path>
    </g>
    <rect
      class="bld-footprint"
      {...rect(FOOTPRINT)}
      data-wipe="x"
      data-at="700"
      data-for="500"
    ></rect>
    <g data-wipe="y" data-at="1000" data-for="600">
      <rect class="bld-deck" {...rect(DECK)}></rect>
      <rect class="bld-pool" {...rect(POOL)}></rect>
    </g>
    <g class="bld-trees" data-wipe="fade" data-at="1400" data-for="400">
      {TREES.map(([x, y]) => (
        <circle cx={d(x)} cy={d(y)} r={d(TREE_RADIUS)} />
      ))}
    </g>
    <g class="bld-labels" data-wipe="fade" data-at="1500" data-for="400">
      <text x={d((DECK.x0 + DECK.x1) / 2)} y={d(DECK.y0 - 0.9)}>
        {t(locale, "newHome.building.courtyard")}
      </text>
      <text
        x={d((POOL.x0 + POOL.x1) / 2)}
        y={d((POOL.y0 + POOL.y1) / 2)}
        transform={`rotate(-90 ${String(d((POOL.x0 + POOL.x1) / 2))} ${String(d((POOL.y0 + POOL.y1) / 2))})`}
      >
        {t(locale, "newHome.building.pool")}
      </text>
      <text
        x={d((PARKING.x0 + PARKING.x1 - PARKING.depth) / 2)}
        y={d(SITE.depth * 0.78)}
        transform={`rotate(-90 ${String(d((PARKING.x0 + PARKING.x1 - PARKING.depth) / 2))} ${String(d(SITE.depth * 0.78))})`}
      >
        {t(locale, "newHome.building.parking")}
      </text>
    </g>
    <g class="bld-plan-dims" data-wipe="fade" data-at="1600" data-for="400">
      <path
        d={`M0 ${String(d(-2.5))}H${String(d(SITE.width))}M0 ${String(d(-1))}V${String(d(-3.5))}M${String(d(SITE.width))} ${String(d(-1))}V${String(d(-3.5))}`}
      ></path>
      <text x={d(SITE.width / 2)} y={d(-3.2)}>
        {number.format(SITE.width)}
      </text>
      <path
        d={`M${String(d(-2.5))} 0V${String(d(SITE.depth))}M${String(d(-1))} 0H${String(d(-3.5))}M${String(d(-1))} ${String(d(SITE.depth))}H${String(d(-3.5))}`}
      ></path>
      <text
        x={d(-3.2)}
        y={d(SITE.depth / 2)}
        transform={`rotate(-90 ${String(d(-3.2))} ${String(d(SITE.depth / 2))})`}
      >
        {number.format(SITE.depth)}
      </text>
    </g>
  </g>

  <g class="bld__model">
    {model.map((storey, index) => (
      <g
        class="bld-storey"
        data-drop
        data-at={STOREY_AT + index * STOREY_STEP}
        data-for={index === model.length - 1 ? 650 : 520}
      >
        {storey.facades.map((facade) => (
          <>
            <polygon
              class:list={["bld-face", `bld-face--${facade.side}`]}
              points={facade.outline}
            />
            {facade.windows.map((pane) => (
              <polygon class="bld-glass" points={pane} />
            ))}
          </>
        ))}
        <polygon class="bld-top" points={storey.top} />
      </g>
    ))}
  </g>

  <g
    class="bld-height"
    data-wipe="fade"
    data-at={STOREY_AT + model.length * STOREY_STEP + 400}
    data-for="400"
  >
    <path d={height.line}></path>
    {height.ticks.map((tick) => (
      <path d={tick} />
    ))}
    <text
      x={d(height.label[0])}
      y={d(height.label[1])}
      transform={`rotate(-90 ${String(d(height.label[0]))} ${String(d(height.label[1]))})`}
    >
      {number.format(HEIGHT)}
    </text>
  </g>
</svg>

<style>
  .bld {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .bld :is(rect, path, circle, polygon) {
    fill: none;
    stroke: var(--drawing-ink);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .bld .bld-site {
    stroke: var(--drawing-muted);
    stroke-dasharray: 10 4 2 4;
  }

  .bld .bld-parking path {
    stroke: var(--drawing-muted);
  }

  .bld .bld-footprint {
    stroke-width: 1.5px;
  }

  .bld .bld-deck {
    fill: color-mix(in srgb, var(--drawing-ink) 7%, var(--drawing-fill));
    stroke: var(--drawing-muted);
  }

  .bld .bld-pool {
    fill: color-mix(in srgb, var(--accent) 30%, var(--drawing-fill));
    stroke: var(--accent);
  }

  .bld .bld-trees circle {
    stroke: var(--drawing-muted);
  }

  /* The storeys: the south facade in the drawing's fill, the west end a
     shade lighter, the tops lighter still, so the mass reads in three
     tones; the glass a tint of the accent. */
  .bld .bld-face--south {
    fill: color-mix(in srgb, var(--drawing-ink) 6%, var(--drawing-fill));
  }

  .bld .bld-face--west {
    fill: color-mix(in srgb, var(--drawing-ink) 15%, var(--drawing-fill));
  }

  .bld .bld-top {
    fill: color-mix(in srgb, var(--drawing-ink) 24%, var(--drawing-fill));
    stroke-width: 1.5px;
  }

  .bld .bld-glass {
    fill: color-mix(in srgb, var(--accent) 26%, var(--drawing-fill));
    stroke: color-mix(in srgb, var(--accent) 70%, var(--drawing-fill));
  }

  .bld .bld-plan-dims path,
  .bld .bld-height path {
    stroke: var(--accent);
  }

  /* Lettering in decimetres: about 1.4 m tall on the site. */
  .bld text {
    fill: var(--drawing-muted);
    font-size: 15px;
    font-stretch: var(--width-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-anchor: middle;
    dominant-baseline: central;
  }

  .bld :is(.bld-plan-dims, .bld-height) text {
    fill: var(--accent-text);
  }

  /* The final state is the 3D view: the plan's dimensions are off. */
  .bld-plan-dims {
    opacity: 0;
  }
</style>
