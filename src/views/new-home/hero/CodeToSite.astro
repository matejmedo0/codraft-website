---
/**
 * The new Home's hero animation (M29 in docs/phases/3-pages.md): code
 * typed into an editor, line by line, and beside it the web page that code
 * makes, built element by element as each line is finished. A drafting
 * line with its grip joins the two, and once the last line is typed the
 * finished page is selected with the brand's four grips.
 *
 * hero-code.ts times it on load: each line types at its own length
 * (`--n` characters from `--at` for `--for`), and each part of the page
 * (`data-after-line`) appears as its line ends. Without JavaScript, or
 * with reduced motion, the code and the page are complete at once.
 *
 * Decorative: the hero's text says what the studio does, so the whole
 * stage is hidden from assistive technology. The page shown is a sample,
 * not client work.
 */
import Wordmark from "../../../components/ui/Wordmark.astro";

interface Token {
  /** tag, attr, value, text or punct: the syntax colours. */
  kind: "tag" | "attr" | "value" | "text" | "punct";
  text: string;
}

type Line = Token[];

const tag = (text: string): Token => ({ kind: "tag", text });
const attr = (text: string): Token => ({ kind: "attr", text });
const value = (text: string): Token => ({ kind: "value", text });
const text = (content: string): Token => ({ kind: "text", text: content });
const punct = (content: string): Token => ({ kind: "punct", text: content });
const open = (name: string): Token[] => [punct("<"), tag(name), punct(">")];
const close = (name: string): Token[] => [punct("</"), tag(name), punct(">")];

/** The code, in typing order. The comments name the page part each builds. */
const LINES: Line[] = [
  [punct("<"), tag("header"), punct(">")],
  [
    text("  "),
    punct("<"),
    tag("a"),
    text(" "),
    attr("class"),
    punct("="),
    value('"logo"'),
    punct(">"),
    text("Vaša tvrtka"),
    ...close("a"),
  ],
  [text("  "), ...open("nav"), text("Usluge  Kontakt"), ...close("nav")],
  close("header"),
  [
    punct("<"),
    tag("main"),
    text(" "),
    attr("class"),
    punct("="),
    value('"hero"'),
    punct(">"),
  ],
  [text("  "), ...open("h1"), text("Nova web stranica"), ...close("h1")],
  [text("  "), ...open("p"), text("Brza na mobitelu."), ...close("p")],
  [
    text("  "),
    punct("<"),
    tag("img"),
    text(" "),
    attr("src"),
    punct("="),
    value('"naslovna.jpg"'),
    punct(">"),
  ],
  [
    text("  "),
    punct("<"),
    tag("a"),
    text(" "),
    attr("class"),
    punct("="),
    value('"button"'),
    punct(">"),
    text("Upit"),
    ...close("a"),
  ],
  close("main"),
  [
    punct("<"),
    tag("section"),
    text(" "),
    attr("class"),
    punct("="),
    value('"cards"'),
    punct(">"),
  ],
  [text("  "), ...open("article"), text("Izrada"), ...close("article")],
  [text("  "), ...open("article"), text("Održavanje"), ...close("article")],
  [text("  "), ...open("article"), text("SEO"), ...close("article")],
  close("section"),
];
---

<div class="cts" aria-hidden="true" data-code-stage>
  <div class="cts__editor">
    <div class="cts__bar">
      <span class="cts__tab">index.html</span>
    </div>
    <ol class="cts__code">
      {LINES.map((line) => (
        <li class="cts__row">
          <span class="cts__line" data-code-line>
            {line.map((token) => (
              <span class={`tk tk--${token.kind}`}>{token.text}</span>
            ))}
          </span>
        </li>
      ))}
    </ol>
  </div>

  <span class="cts__link">
    <span class="cts__link-line"></span>
    <span class="cts__link-grip"></span>
  </span>

  <div class="cts__browser has-grips">
    <div class="cts__bar">
      <span class="cts__address">localhost:4321</span>
    </div>
    <div class="cts__page">
      <div class="site__header" data-after-line="3">
        <span class="site__logo" data-after-line="1">
          Vaša tvrtka
        </span>
        <span class="site__nav" data-after-line="2">
          <span>Usluge</span>
          <span>Kontakt</span>
        </span>
      </div>
      <div class="site__hero" data-after-line="9">
        <div class="site__copy">
          <span class="site__title" data-after-line="5">
            Nova web stranica
          </span>
          <span class="site__lead" data-after-line="6">
            Brza na mobitelu.
          </span>
          <span class="site__button" data-after-line="8">
            Upit
          </span>
        </div>
        <span class="site__image graph-paper" data-after-line="7">
          <Wordmark class="site__logo-mark" />
        </span>
      </div>
      <div class="site__cards" data-after-line="14">
        <span class="site__card" data-after-line="11">
          Izrada
        </span>
        <span class="site__card" data-after-line="12">
          Održavanje
        </span>
        <span class="site__card" data-after-line="13">
          SEO
        </span>
      </div>
    </div>
    <span class="grips cts__grips">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </span>
  </div>
</div>

<script>
  import "./hero-code.ts";
</script>

<style>
  .cts {
    --mono: ui-monospace, "Cascadia Code", "Cascadia Mono", Consolas, monospace;
    --panel: var(--surface-sunk);
    --code-size: 0.6875rem;

    display: grid;
    gap: var(--space-5);
    width: 100%;
    text-align: left;
  }

  .cts__editor,
  .cts__browser {
    position: relative;
    min-width: 0;
    min-height: 0;
    transition: min-height 1100ms cubic-bezier(0.16, 1, 0.3, 1);
    border: var(--rule) solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .cts__bar {
    display: flex;
    align-items: center;
    height: 2rem;
    padding: 0 var(--space-3);
    border-bottom: var(--rule) solid var(--line);
    color: var(--ink-muted);
    font-size: var(--step-label);
    font-stretch: var(--width-label);
    letter-spacing: var(--tracking-label);
  }

  .cts__tab {
    padding-bottom: 0.1rem;
    border-bottom: var(--rail) solid var(--accent);
    color: var(--ink);
  }

  .cts__address {
    width: 100%;
    padding: 0.1rem var(--space-3);
    border-radius: var(--radius);
    background: var(--surface);
    font-variant-numeric: tabular-nums;
  }

  /* The editor: line numbers from the list, the code in the system's
     monospace (it is code), coloured from the palette. */
  .cts__code {
    margin: 0;
    padding: var(--space-3) var(--space-3) var(--space-4) 2.75rem;
    overflow: hidden;
    color: var(--ink);
    font-family: var(--mono);
    font-size: var(--code-size);
    line-height: 1.75;
    counter-reset: line;
    list-style: none;
  }

  .cts__row {
    position: relative;
    white-space: pre;
    counter-increment: line;
  }

  .cts__row::before {
    position: absolute;
    left: -2.25rem;
    width: 1.5rem;
    color: color-mix(in srgb, var(--ink-muted) 55%, transparent);
    content: counter(line);
    text-align: right;
  }

  .cts__line {
    position: relative;
    display: inline-block;
    max-width: 100%;
    vertical-align: top;
  }

  .tk--tag {
    color: var(--accent-text);
  }

  .tk--attr {
    color: var(--ink-muted);
  }

  .tk--value {
    color: color-mix(in srgb, var(--accent) 45%, var(--ink));
  }

  .tk--punct {
    color: color-mix(in srgb, var(--ink-muted) 70%, transparent);
  }

  /* The drafting line from the code to the page, with its grip. */
  .cts__link {
    display: none;
  }

  /* The page the code makes: a small, real layout in the page's palette. */
  .cts__page {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    color: var(--ink);
    font-size: 0.6875rem;
  }

  .site__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-2);
    border-bottom: var(--rule) solid var(--line);
  }

  .site__logo {
    font-family: var(--font-heading);
    font-stretch: var(--width-heading);
    font-weight: var(--weight-strong);
  }

  .site__nav {
    display: flex;
    gap: var(--space-3);
    color: var(--ink-muted);
  }

  .site__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
  }

  .site__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }

  .site__title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-stretch: var(--width-heading);
    font-weight: var(--weight-display);
    line-height: 1.05;
    letter-spacing: var(--tracking-section);
  }

  .site__lead {
    color: var(--ink-muted);
  }

  .site__button {
    margin-top: var(--space-1);
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius);
    background: var(--button-primary-bg);
    color: var(--button-primary-fg);
    font-weight: var(--weight-strong);
  }

  /* The image: the Codraft wordmark on graph paper, drawn in as the
     image's line is typed (see the animation below). */
  .site__image {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 0 14%;
    color: var(--ink);
  }

  .site__image :global(.site__logo-mark) {
    --wordmark-width: 100%;
  }

  .site__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .site__card {
    padding: var(--space-3) var(--space-2);
    border: var(--rule) solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    font-weight: var(--weight-medium);
  }

  @media (prefers-reduced-motion: reduce) {
    .cts__editor,
    .cts__browser {
      transition: none;
    }
  }

  /* The hero taken by the windows (is-big, hero-expand.ts): from 48rem
     they grow with the stage, and from 64rem to the screen's height. */
  @media (min-width: 48rem) {
    .cts__browser {
      display: grid;
      grid-template-rows: auto 1fr;
    }

    :global(.is-big) .cts__page {
      align-content: space-evenly;
      padding: var(--space-6);
      font-size: clamp(0.75rem, 1.2cqi, 1.125rem);
    }

    :global(.is-big) .cts__code {
      --code-size: clamp(0.75rem, 1.15cqi, 1.125rem);

      padding-top: var(--space-5);
      line-height: 1.9;
    }

    :global(.is-big) .site__title {
      font-size: clamp(1.375rem, 2.9cqi, 2.75rem);
    }

    :global(.is-big) .site__hero {
      gap: var(--space-6);
    }
  }

  /* Most of the screen's height (M31: a little short of all of it), only
     where the windows sit side by side on a wide screen; a tall tablet
     would leave them empty. */
  @media (min-width: 64rem) {
    :global(.is-big) .cts__editor,
    :global(.is-big) .cts__browser {
      min-height: 76svh;
    }
  }

  .cts__grips {
    opacity: 1;
  }

  .cts__grips > span {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 48rem) {
    .cts {
      --code-size: clamp(0.75rem, 1.05cqi, 1.0625rem);

      grid-template-columns: minmax(0, 1fr) var(--space-9) minmax(0, 1fr);
      gap: 0;
      align-items: stretch;
    }

    .cts__link {
      position: relative;
      display: block;
      align-self: center;
      height: 0.75rem;
    }

    .cts__link-line {
      position: absolute;
      top: calc(50% - var(--rail) / 2);
      right: 0.75rem;
      left: var(--space-2);
      height: var(--rail);
      background: var(--accent);
      transform-origin: 0 50%;
    }

    .cts__link-grip {
      position: absolute;
      top: 0;
      right: 0;
      width: 0.75rem;
      height: 0.75rem;
      border: var(--grip-stroke) solid var(--accent);
      background: var(--grip-fill);
    }

    .cts__page {
      font-size: clamp(0.75rem, 1.05cqi, 1.0625rem);
    }

    .site__title {
      font-size: clamp(1.375rem, 2cqi, 2.25rem);
    }
  }

  /* The animation, once hero-code.ts has timed it. A line types at one
     character a step, a caret at its end while it types; each part of the
     page comes in as its line ends, flashing the accent outline as if just
     selected; the link draws as the first line starts; the grips select
     the finished page. */
  :global(.is-live) .cts__line {
    /* Backwards only: once typed, the line is its plain, whole self (a
       stepped fill can stop one step short). */
    animation: cts-type var(--for) steps(var(--n), end) var(--at) backwards;
  }

  /* The caret steps along the line with the typing. */

  :global(.is-live) .cts__line::after {
    position: absolute;
    top: 0.2em;
    bottom: 0.2em;
    left: 0;
    width: 1px;
    background: var(--accent);
    content: "";
    opacity: 0;
    animation: cts-caret var(--for) steps(var(--n), end) var(--at);
  }

  :global(.is-live) [data-after-line] {
    animation:
      cts-in 420ms cubic-bezier(0.16, 1, 0.3, 1) var(--at) both,
      cts-flash 900ms var(--ease-standard) var(--at);
  }

  :global(.is-live) .cts__link-line {
    animation: motion-draw-x var(--motion-draw) var(--ease-pen) 600ms both;
  }

  :global(.is-live) .cts__link-grip {
    animation: motion-snap-in var(--motion-snap) var(--ease-snap) 1250ms both;
  }

  :global(.is-live) .cts__grips > span {
    animation: motion-snap-in var(--motion-snap) var(--ease-snap) var(--done)
      both;
  }

  /* A clip from the right, so the line ends exactly where its text does,
     whatever the monospace's real advance. */
  /* The wordmark draws as its image appears: the lettering rises in, the
     arc and the drafting line draw, the grip snaps in. When the windows
     grow into the hero (is-big) it draws once more. */
  .site__image :global(:is(.wordmark__line, .wordmark__grip, .wordmark__arc)) {
    transform-box: fill-box;
  }

  .site__image :global(.wordmark__line) {
    transform-origin: 0 50%;
  }

  .site__image :global(:is(.wordmark__grip, .wordmark__arc)) {
    transform-origin: 50% 50%;
  }

  :global(.is-live) .site__image :global(.wordmark__ink) {
    animation: cts-ink 600ms cubic-bezier(0.16, 1, 0.3, 1)
      calc(var(--at) + 150ms) both;
  }

  :global(.is-live) .site__image :global(.wordmark__arc) {
    animation: motion-snap-in var(--motion-snap) var(--ease-snap)
      calc(var(--at) + 450ms) both;
  }

  :global(.is-live) .site__image :global(.wordmark__line) {
    animation: motion-draw-x var(--motion-draw) var(--ease-pen)
      calc(var(--at) + 600ms) both;
  }

  :global(.is-live) .site__image :global(.wordmark__grip) {
    animation: motion-snap-in var(--motion-snap) var(--ease-snap)
      calc(var(--at) + 1300ms) both;
  }

  :global(.is-big .is-live) .site__image :global(.wordmark__ink) {
    animation-name: cts-ink-again;
    animation-delay: 500ms;
  }

  :global(.is-big .is-live) .site__image :global(.wordmark__arc) {
    animation-name: cts-snap-again;
    animation-delay: 800ms;
  }

  :global(.is-big .is-live) .site__image :global(.wordmark__line) {
    animation-name: cts-draw-again;
    animation-delay: 950ms;
  }

  :global(.is-big .is-live) .site__image :global(.wordmark__grip) {
    animation-name: cts-snap-again;
    animation-delay: 1650ms;
  }

  /* Shrunk back after growing: the wordmark stays drawn, with no replay. */
  :global(.was-big:not(.is-big) .is-live)
    .site__image
    :global(
      :is(.wordmark__ink, .wordmark__arc, .wordmark__line, .wordmark__grip)
    ) {
    animation: none;
  }

  @keyframes cts-ink {
    from {
      opacity: 0;
      translate: 0 12px;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* The same motions under new names, so a replay restarts them. */
  @keyframes cts-ink-again {
    from {
      opacity: 0;
      translate: 0 12px;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes cts-draw-again {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @keyframes cts-snap-again {
    from {
      opacity: 0;
      scale: 0.6;
    }

    to {
      opacity: 1;
      scale: 1;
    }
  }

  @keyframes cts-type {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0);
    }
  }

  @keyframes cts-caret {
    from {
      left: 0;
      opacity: 1;
    }

    to {
      left: 100%;
      opacity: 1;
    }
  }

  @keyframes cts-in {
    from {
      opacity: 0;
      translate: 0 0.375rem;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes cts-flash {
    from {
      outline: 1px solid var(--accent);
      outline-offset: 2px;
    }

    to {
      outline: 1px solid transparent;
      outline-offset: 2px;
    }
  }
</style>
