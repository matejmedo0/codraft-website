---
/**
 * The closing call to action, the page's one navy surface (ADR 0015). It
 * invites a conversation and doesn't repeat the audit, which its own zone
 * asks for once (ADR 0017): a question, a lead, a note, then one button to
 * Kontakt, "Pošaljite upit". Home's is the first (review batches 11-12);
 * each page passes its own text.
 *
 * Centred, one under the other (review batch 12): the heading, a zone h2
 * smaller than the hero's, with room for one line from 900 px; the lead
 * and the note, never wider than the heading; the button.
 */
import Button from "../../components/ui/Button.astro";
import Zone from "../../components/ui/Zone.astro";
import type { Locale } from "../../config/site.ts";
import { t } from "../../features/i18n/ui.ts";
import { pathFor } from "../../features/i18n/urls.ts";

interface Props {
  locale: Locale;
  title: string;
  lead: string;
  note?: string | undefined;
}

const { locale, title, lead, note } = Astro.props;
---

<Zone labelledby="zavrsni-poziv" surface="navy" class="closing">
  <div class="closing__text">
    <h2 class="closing__title" id="zavrsni-poziv">
      {title}
    </h2>
    <p class="closing__lead">{lead}</p>
    {note !== undefined && <p class="closing__note">{note}</p>}
  </div>
  <Button href={pathFor("contact", locale)} class="closing__cta">
    {t(locale, "home.closing.cta")}
  </Button>
</Zone>

<style>
  /* Equal padding above and below, two thirds of a zone's, as the heading
     is two thirds of its old size (48 of 72 px). */
  .closing {
    display: grid;
    justify-items: center;
    padding-block: calc(var(--zone-pad) * 2 / 3);
    text-align: center;
  }

  /* As wide as the heading; the lead takes no width of its own. */
  .closing__text {
    max-width: 100%;
  }

  /* Trimmed to the cap height, so the space above the letters matches the
     space below the button. */
  .closing__title {
    text-box: trim-start cap alphabetic;
  }

  .closing__lead,
  .closing__note {
    width: 0;
    min-width: 100%;
    text-wrap: balance;
  }

  .closing__lead {
    margin-top: var(--space-4);
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
  }

  /* Under the lead, in body text and the surface's muted ink, so it reads
     as the detail it is. */
  .closing__note {
    margin-top: var(--space-3);
    color: var(--ink-muted);
  }

  /* 1.5 times the gap between the heading and the lead. */
  .closing__cta {
    margin-top: var(--space-5);
  }
</style>
