{
  "extends": "astro/tsconfigs/strictest",
  // The preset includes every file; skip build and test output and the
  // non-code folders.
  "exclude": [
    "dist",
    "playwright-report",
    "test-results",
    "Assets",
    "docs",
    "archive"
  ],
  "compilerOptions": {
    // React islands (@astrojs/react).
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // TypeScript 6 no longer loads @types packages by default.
    "types": ["node"]
  }
}
